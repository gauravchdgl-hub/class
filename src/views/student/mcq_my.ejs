<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My MCQ Assignments - AUS Academy</title>
<link rel="stylesheet" href="/assets/tailwind.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  body{font-family:'Inter',sans-serif;background:#f4f6fa;color:#1e293b}
  ::-webkit-scrollbar{width:6px;height:6px}
  ::-webkit-scrollbar-thumb{background:#cbd5e1;border-radius:4px}
</style>
</head>
<body class="bg-[#f4f6fa] text-slate-800 antialiased min-h-screen flex flex-col overflow-x-hidden">
<div id="sidebar-backdrop" onclick="toggleSidebar()" class="fixed inset-0 bg-slate-900/50 z-40 hidden lg:hidden transition-opacity duration-300"></div>
<div class="flex flex-1 min-h-screen relative">

  <aside id="sidebar" class="fixed inset-y-0 left-0 z-50 w-64 bg-[#071330] text-slate-300 flex flex-col justify-between shrink-0 transform -translate-x-full lg:translate-x-0 lg:static lg:z-auto transition-transform duration-300 ease-in-out h-screen overflow-y-auto border-r border-slate-800">
    <div>
      <div class="p-5 border-b border-slate-800 flex items-center justify-between bg-[#040a1d]">
        <div class="flex items-center space-x-3">
          <div class="w-8 h-8 rounded-lg bg-blue-600 flex items-center justify-center text-white font-bold text-lg shadow-md shrink-0"><i class="fa-solid fa-graduation-cap"></i></div>
          <div><h1 class="font-bold text-base leading-tight tracking-wide text-white">AUS Academy</h1><p class="text-[10px] text-slate-400 mt-0.5">Australia Year 11–12 Student Portal</p></div>
        </div>
        <button onclick="toggleSidebar()" class="lg:hidden text-slate-400 hover:text-white"><i class="fa-solid fa-xmark text-xl"></i></button>
      </div>
      <nav class="p-3 space-y-1 text-sm font-medium">
        <a href="/student/dashboard" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition"><i class="fa-solid fa-house w-5 text-center text-slate-400"></i><span>Dashboard</span></a>
        <a href="/student/subjects" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition"><i class="fa-solid fa-book-open w-5 text-center text-slate-400"></i><span>My Subjects</span></a>
        <a href="/student/mcq-plans" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition"><i class="fa-solid fa-id-card w-5 text-center text-slate-400"></i><span>My Plan</span></a>
        <a href="#" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg bg-blue-600 text-white shadow-md font-semibold shadow-blue-600/30"><i class="fa-solid fa-clipboard-list w-5 text-center text-white"></i><span>My Assignments</span></a>
        <a href="/student/mcq/my" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition"><i class="fa-solid fa-circle-question w-5 text-center text-slate-400"></i><span>Practice MCQs</span></a>
        <a href="/student/tutorials" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition"><i class="fa-solid fa-video w-5 text-center text-slate-400"></i><span>Tutorials</span></a>
        <a href="/student/material" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition"><i class="fa-solid fa-book w-5 text-center text-slate-400"></i><span>Study Material</span></a>
        <a href="/student/results" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition"><i class="fa-solid fa-chart-pie w-5 text-center text-slate-400"></i><span>Results</span></a>
        <a href="/student/settings" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition"><i class="fa-solid fa-gear w-5 text-center text-slate-400"></i><span>Profile &amp; Settings</span></a>
        <a href="/logout" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition"><i class="fa-solid fa-right-from-bracket w-5 text-center text-slate-400"></i><span>Logout</span></a>
      </nav>
    </div>
    <div class="p-4 bg-[#040a1d] border-t border-slate-800 space-y-3">
      <div class="flex items-center space-x-3 text-xs text-slate-400 pt-1">
        <div class="w-8 h-8 rounded-lg bg-blue-600/20 text-blue-400 flex items-center justify-center shrink-0"><i class="fa-solid fa-headset text-sm"></i></div>
        <div><h4 class="text-xs font-semibold text-white leading-tight">Need Help?</h4><span class="text-[10px] text-slate-400">Contact Support</span></div>
      </div>
    </div>
  </aside>

  <main class="flex-1 flex flex-col min-w-0 overflow-y-auto bg-slate-50 min-h-screen relative">
    <header class="bg-white border-b border-slate-200 px-4 sm:px-6 py-3 flex items-center justify-between sticky top-0 z-30 shadow-sm">
      <div class="flex items-center space-x-3 w-full max-w-2xl">
        <button onclick="toggleSidebar()" class="lg:hidden p-2 rounded-lg text-slate-600 hover:bg-slate-100 focus:outline-none"><i class="fa-solid fa-bars text-lg"></i></button>
        <div class="flex items-center w-full bg-slate-50 rounded-lg px-3 py-2 border border-slate-200 hidden sm:flex">
          <i class="fa-solid fa-magnifying-glass text-slate-400 mr-2 text-sm"></i>
          <input type="text" id="searchInput" onkeyup="filterCards()" placeholder="Search assignments..." class="bg-transparent border-none text-xs sm:text-sm w-full outline-none text-slate-700 placeholder-slate-400">
        </div>
      </div>
      <div class="flex items-center space-x-3 sm:space-x-4 pl-2 shrink-0">
        <div class="flex items-center space-x-2.5">
          <div class="w-8 h-8 rounded-full bg-blue-600 text-white flex items-center justify-center font-bold text-sm"><%= (currentUser.name||'S').charAt(0).toUpperCase() %></div>
          <div class="hidden sm:block text-left"><h4 class="text-xs font-bold text-slate-800 leading-none mb-0.5"><%= currentUser.name %></h4><span class="text-[11px] text-slate-500 font-medium"><%= currentUser.class_year || 'Student' %></span></div>
        </div>
      </div>
    </header>

    <div class="p-4 sm:p-6 lg:p-8 max-w-[1700px] mx-auto w-full space-y-6">

      <div class="bg-gradient-to-r from-[#0d1b3e] via-[#102552] to-[#162d61] rounded-3xl p-6 sm:p-8 text-white shadow-xl relative overflow-hidden flex flex-col justify-between">
        <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-blue-500/20 rounded-full blur-3xl pointer-events-none"></div>
        <div class="relative z-10 space-y-2">
          <nav class="flex text-xs text-blue-300 space-x-2 font-medium">
            <a href="/student/dashboard" class="hover:text-white transition">Home</a><span>&gt;</span><span class="text-white font-semibold">My MCQ Assignments</span>
          </nav>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">My MCQ Assignments</h2>
          <p class="text-xs sm:text-sm text-slate-300 max-w-xl">All MCQ practice sets assigned by your teachers.</p>
        </div>
      </div>

      <% const total = assignments.length;
         const completed = assignments.filter(a => a.status === 'completed').length;
         const inProgress = assignments.filter(a => a.status === 'in_progress').length;
         const notStarted = assignments.filter(a => a.status === 'assigned').length;
         const subjectNames = [...new Set(assignments.map(a => a.subject_name).filter(Boolean))];
         const topicNames = [...new Set(assignments.map(a => a.topic).filter(Boolean))];
      %>

      <div class="bg-white rounded-2xl border border-slate-200 p-4 shadow-sm flex flex-wrap items-center justify-between gap-4">
        <div class="flex flex-wrap items-center gap-3 w-full lg:w-auto">
          <select id="filterSubject" onchange="filterCards()" class="bg-slate-50 border border-slate-200 text-slate-700 text-xs font-semibold rounded-xl px-3.5 py-2.5 outline-none focus:ring-2 focus:ring-blue-500 cursor-pointer">
            <option value="">All Subjects</option>
            <% subjectNames.forEach(s => { %><option value="<%= s %>"><%= s %></option><% }) %>
          </select>
          <select id="filterTopic" onchange="filterCards()" class="bg-slate-50 border border-slate-200 text-slate-700 text-xs font-semibold rounded-xl px-3.5 py-2.5 outline-none focus:ring-2 focus:ring-blue-500 cursor-pointer">
            <option value="">All Topics</option>
            <% topicNames.forEach(t => { %><option value="<%= t %>"><%= t %></option><% }) %>
          </select>
          <select id="filterStatus" onchange="filterCards()" class="bg-slate-50 border border-slate-200 text-slate-700 text-xs font-semibold rounded-xl px-3.5 py-2.5 outline-none focus:ring-2 focus:ring-blue-500 cursor-pointer">
            <option value="">All Assignments</option>
            <option value="completed">Completed</option>
            <option value="in_progress">In Progress</option>
            <option value="assigned">Not Started</option>
          </select>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm flex items-center justify-between">
          <div><span class="text-xs font-semibold text-slate-400 uppercase tracking-wide block mb-1">Total Assignments</span><h3 class="text-3xl font-extrabold text-slate-900"><%= total %></h3></div>
          <div class="w-12 h-12 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center text-xl shrink-0"><i class="fa-solid fa-file-lines"></i></div>
        </div>
        <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm flex items-center justify-between">
          <div><span class="text-xs font-semibold text-slate-400 uppercase tracking-wide block mb-1">Completed</span><h3 class="text-3xl font-extrabold text-slate-900"><%= completed %></h3></div>
          <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl shrink-0"><i class="fa-solid fa-circle-check"></i></div>
        </div>
        <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm flex items-center justify-between">
          <div><span class="text-xs font-semibold text-slate-400 uppercase tracking-wide block mb-1">In Progress</span><h3 class="text-3xl font-extrabold text-slate-900"><%= inProgress %></h3></div>
          <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-500 flex items-center justify-center text-xl shrink-0"><i class="fa-solid fa-clock-rotate-left"></i></div>
        </div>
        <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm flex items-center justify-between">
          <div><span class="text-xs font-semibold text-slate-400 uppercase tracking-wide block mb-1">Not Started</span><h3 class="text-3xl font-extrabold text-slate-900"><%= notStarted %></h3></div>
          <div class="w-12 h-12 rounded-2xl bg-rose-50 text-rose-500 flex items-center justify-center text-xl shrink-0"><i class="fa-solid fa-calendar-days"></i></div>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="cardsGrid">
        <% assignments.forEach(a => { %>
          <% const statusLabel = a.status === 'completed' ? 'Completed' : (a.status === 'in_progress' ? 'In Progress' : 'Not Started');
             const statusClass = a.status === 'completed' ? 'bg-emerald-50 text-emerald-600' : (a.status === 'in_progress' ? 'bg-amber-50 text-amber-600' : 'bg-slate-100 text-slate-600'); %>
          <div class="assignment-card bg-white rounded-2xl border border-slate-200 p-6 shadow-sm flex flex-col justify-between space-y-4 hover:shadow-md transition"
               data-subject="<%= a.subject_name || '' %>" data-topic="<%= a.topic || '' %>" data-status="<%= a.status %>" data-search="<%= ((a.topic||'') + ' ' + (a.subject_name||'')).toLowerCase() %>">
            <div>
              <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center text-xl shrink-0"><i class="fa-solid fa-circle-question"></i></div>
                <span class="<%= statusClass %> text-xs font-bold px-3 py-1 rounded-full"><%= statusLabel %></span>
              </div>
              <span class="text-xs font-bold text-blue-600 uppercase tracking-wider block mb-1"><%= a.subject_name || 'General' %></span>
              <h3 class="text-lg font-bold text-slate-900 leading-snug"><%= a.topic || 'MCQ Practice Set' %></h3>
              <% if (a.teacher_note) { %><p class="text-xs text-slate-500 mt-1"><%= a.teacher_note %></p><% } %>
            </div>
            <div class="space-y-4 pt-4 border-t border-slate-100">
              <div class="flex items-center justify-between text-[11px] font-medium text-slate-500">
                <span class="flex items-center space-x-1.5"><i class="fa-solid fa-file-lines text-blue-600"></i><span><%= a.total_questions %> Questions</span></span>
                <span class="flex items-center space-x-1.5"><i class="fa-solid fa-list-ol text-blue-600"></i><span><%= a.answered_questions %> Answered</span></span>
                <span class="flex items-center space-x-1.5"><i class="fa-regular fa-calendar text-blue-600"></i><span><%= new Date(a.created_at).toLocaleDateString() %></span></span>
              </div>
              <div class="flex items-center justify-between pt-1">
                <div class="flex items-center space-x-2.5">
                  <div class="w-8 h-8 rounded-full bg-slate-200 text-slate-600 flex items-center justify-center font-bold text-xs"><%= (a.teacher_name||'T').charAt(0).toUpperCase() %></div>
                  <div><h5 class="text-xs font-bold text-slate-900 leading-tight"><%= a.teacher_name || 'Your Teacher' %></h5><span class="text-[10px] text-slate-400"><%= a.subject_name || '' %> Teacher</span></div>
                </div>
                <% if (a.status === 'completed') { %>
                  <a href="/student/mcq/assignment/<%= a.id %>/result" class="bg-blue-50 hover:bg-blue-100 text-blue-600 font-bold text-xs px-3.5 py-2 rounded-xl transition">View Result</a>
                <% } else { %>
                  <a href="/student/mcq/assignment/<%= a.id %>" class="bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs px-3.5 py-2 rounded-xl transition shadow-md shadow-blue-600/30"><%= a.status === 'in_progress' ? 'Resume Test' : 'Start Test' %></a>
                <% } %>
              </div>
            </div>
          </div>
        <% }) %>
        <% if (!assignments.length) { %>
          <div class="col-span-full text-center text-slate-400 py-10">No MCQs assigned yet. Your teacher will assign a batch soon — check back later.</div>
        <% } %>
      </div>

      <footer class="pt-6 pb-4 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 font-medium">
        <p>&copy; 2026 AUS Academy. All rights reserved.</p>
      </footer>
    </div>
  </main>
</div>
<script>
  function toggleSidebar(){ document.getElementById('sidebar').classList.toggle('-translate-x-full'); document.getElementById('sidebar-backdrop').classList.toggle('hidden'); }
  function filterCards() {
    const subject = document.getElementById('filterSubject').value;
    const topic = document.getElementById('filterTopic').value;
    const status = document.getElementById('filterStatus').value;
    const q = (document.getElementById('searchInput') ? document.getElementById('searchInput').value : '').toLowerCase();
    document.querySelectorAll('.assignment-card').forEach(c => {
      const matches = (!subject || c.dataset.subject === subject) &&
        (!topic || c.dataset.topic === topic) &&
        (!status || c.dataset.status === status) &&
        (!q || c.dataset.search.includes(q));
      c.style.display = matches ? '' : 'none';
    });
  }
</script>
</body>
</html>
