<%- include('../partials/header', { title: 'My Results' }) %>
<div class="nav-tabs">
  <a href="/student/dashboard">Dashboard</a>
  <a href="/student/mcq/plans">MCQ Plans</a>
  <a href="/student/mcq/my">My MCQs</a>
  <a class="active" href="/student/results">Results</a>
</div>
<h1>My Results</h1>
<% results.forEach(r => { %>
  <div class="card">
    <h3><%= r.title %> <span class="badge <%= r.status %>"><%= r.status %></span></h3>
    <% if (r.status === 'published') { %>
      <table>
        <tr><th></th><th>Score</th><th>%</th></tr>
        <tr><td>MCQ (<%= r.mcq_total %>)</td><td><%= r.mcq_score %> / <%= r.mcq_total %></td><td><%= r.mcq_total ? Math.round(r.mcq_score/r.mcq_total*100) : 0 %>%</td></tr>
        <tr><td>Written (<%= r.written_total %>)</td><td><%= r.written_score %> / <%= r.written_total %></td><td><%= r.written_total ? Math.round(r.written_score/r.written_total*100) : 0 %>%</td></tr>
        <tr><td>Essay (<%= r.essay_total %>)</td><td><%= r.essay_score %> / <%= r.essay_total %></td><td><%= r.essay_total ? Math.round(r.essay_score/r.essay_total*100) : 0 %>%</td></tr>
        <tr><th>Total</th><th><%= r.total_score %> / <%= r.total_marks %></th><th><%= r.total_marks ? Math.round(r.total_score/r.total_marks*100) : 0 %>%</th></tr>
      </table>
    <% } else { %>
      <p class="muted">Result pending — teacher review in progress.</p>
    <% } %>
  </div>
<% }) %>
<% if (!results.length) { %><p class="muted">No submissions yet.</p><% } %>
<%- include('../partials/footer') %>
