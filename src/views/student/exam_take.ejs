<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= assignment.title %> - AUS Academy</title>
<link rel="stylesheet" href="/assets/tailwind.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  body{font-family:'Inter',sans-serif;background:#f4f6fa;color:#1e293b}
  ::-webkit-scrollbar{width:6px;height:6px}
  ::-webkit-scrollbar-thumb{background:#cbd5e1;border-radius:4px}
  .qbtn{width:34px;height:34px;border-radius:8px;font-weight:800;font-size:12px;display:flex;align-items:center;justify-content:center;cursor:pointer;border:1px solid #e2e8f0;background:#fff;color:#475569}
  .qbtn.current{background:#2563eb;color:#fff;border-color:#2563eb}
  .qbtn.answered:not(.current){background:#ecfdf5;border-color:#a7f3d0;color:#059669}
  .qbtn.marked:not(.current){background:#fffbeb;border-color:#fde68a;color:#d97706}
</style>
</head>
<body class="bg-[#f4f6fa] text-slate-800 antialiased min-h-screen flex flex-col overflow-x-hidden">
<div class="flex flex-1 min-h-screen relative">

  <main class="flex-1 flex flex-col min-w-0 overflow-y-auto bg-slate-50 min-h-screen relative">
    <header class="bg-[#071330] text-white px-4 sm:px-6 py-3 flex items-center justify-between sticky top-0 z-30 shadow-md">
      <div>
        <h1 class="text-sm sm:text-base font-bold leading-tight"><%= assignment.title %></h1>
        <p class="text-[10px] text-slate-400">Use Next / Previous or the question palette to move around. Nothing is scored until you submit.</p>
      </div>
      <div id="timerBox" class="bg-blue-600/20 border border-blue-400/30 text-blue-200 font-extrabold text-lg px-4 py-1.5 rounded-xl" data-expires-at="<%= expiresAt %>">--:--</div>
    </header>

    <form method="post" action="/student/exams/<%= assignment.id %>/submit" id="exam-take-form" class="p-4 sm:p-6 lg:p-8 max-w-[1500px] mx-auto w-full flex-1 grid grid-cols-1 lg:grid-cols-4 gap-6">
      <%
        const allQuestions = [
          ...mcqs.map((q, idx) => ({ ...q, section: 'Section A — MCQs', field: 'mcq_' + q.id })),
          ...written.map((q, idx) => ({ ...q, section: 'Section B — Short Answer', field: 'written_' + q.id })),
          ...essays.map((q, idx) => ({ ...q, section: 'Section C — Long Answer', field: 'essay_' + q.id })),
        ];
        const sections = [...new Set(allQuestions.map(q => q.section))];
      %>

      <div class="lg:col-span-3 space-y-4">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 min-h-[420px]" id="questionPanel">
          <% allQuestions.forEach((q, i) => { %>
            <div class="exam-question" data-index="<%= i %>" style="<%= i===0 ? '' : 'display:none;' %>">
              <div class="flex items-center justify-between mb-3">
                <span class="text-[11px] font-bold text-blue-600 uppercase tracking-wide"><%= q.section %></span>
                <span class="text-[11px] font-bold text-slate-400">Question <%= i+1 %> of <%= allQuestions.length %> &middot; <%= q.marks %> mark(s)</span>
              </div>
              <h3 class="text-sm sm:text-base font-bold text-slate-900 mb-4"><%= q.question %>
                <a href="/student/report-issue?type=exam_paper_question&id=<%= q.id %>" target="_blank" class="ml-2 text-[10px] font-bold text-rose-500 align-middle">&#9873; Report issue</a>
              </h3>

              <% if (q.section === 'Section A — MCQs') { %>
                <div class="space-y-2.5">
                  <% ['A','B','C','D'].forEach(letter => { const text = q['option_'+letter.toLowerCase()]; if (text) { %>
                    <label class="flex items-center space-x-3 border border-slate-200 rounded-xl px-4 py-3 cursor-pointer hover:bg-slate-50 has-[:checked]:bg-blue-50 has-[:checked]:border-blue-400">
                      <input type="radio" name="<%= q.field %>" value="<%= letter %>" onchange="markAnswered(<%= i %>)" class="accent-blue-600">
                      <span class="text-xs font-semibold text-slate-700"><b><%= letter %>.</b> <%= text %></span>
                    </label>
                  <% } }) %>
                </div>
              <% } else { %>
                <textarea name="<%= q.field %>" rows="<%= q.section.includes('Long') ? 10 : 5 %>" class="w-full border border-slate-200 rounded-xl p-4 text-xs font-medium focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Type your answer here..." oninput="markAnswered(<%= i %>)"></textarea>
              <% } %>
            </div>
          <% }) %>

          <div class="flex items-center justify-between mt-6 pt-4 border-t border-slate-100">
            <button type="button" id="prevBtn" onclick="gotoQuestion(currentQ-1)" class="px-5 py-2.5 rounded-xl border border-slate-200 hover:bg-slate-50 text-slate-700 font-bold text-xs">&larr; Previous</button>
            <button type="button" onclick="toggleMark(currentQ)" class="px-5 py-2.5 rounded-xl border border-amber-200 bg-amber-50 hover:bg-amber-100 text-amber-700 font-bold text-xs">Mark for Review</button>
            <button type="button" id="nextBtn" onclick="gotoQuestion(currentQ+1)" class="px-5 py-2.5 rounded-xl border border-slate-200 hover:bg-slate-50 text-slate-700 font-bold text-xs">Next &rarr;</button>
          </div>
        </div>

        <button class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm py-3.5 rounded-xl transition shadow-md shadow-emerald-600/30" type="submit" onclick="return confirm('Submit the exam now? You cannot change answers after this.')">Submit Exam <i class="fa-solid fa-arrow-right ml-1"></i></button>
      </div>

      <div class="space-y-4">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
          <h3 class="font-bold text-xs text-slate-800 mb-3 flex items-center space-x-2"><i class="fa-solid fa-grip text-blue-600"></i><span>Question Palette</span></h3>
          <div class="flex items-center flex-wrap gap-2 mb-3 text-[9px] font-bold">
            <span class="flex items-center space-x-1"><span class="w-2.5 h-2.5 rounded bg-emerald-100 border border-emerald-300 inline-block"></span><span>Answered</span></span>
            <span class="flex items-center space-x-1"><span class="w-2.5 h-2.5 rounded bg-amber-100 border border-amber-300 inline-block"></span><span>Marked</span></span>
            <span class="flex items-center space-x-1"><span class="w-2.5 h-2.5 rounded bg-white border border-slate-300 inline-block"></span><span>Unanswered</span></span>
          </div>
          <div class="grid grid-cols-5 gap-2" id="qnav">
            <% allQuestions.forEach((q, i) => { %>
              <div class="qbtn<%= i===0 ? ' current' : '' %>" data-index="<%= i %>" onclick="gotoQuestion(<%= i %>)"><%= i+1 %></div>
            <% }) %>
          </div>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
          <h3 class="font-bold text-xs text-slate-800 mb-3 flex items-center space-x-2"><i class="fa-solid fa-list text-blue-600"></i><span>Sections</span></h3>
          <div class="space-y-1.5">
            <% sections.forEach(sec => { const firstIdx = allQuestions.findIndex(q => q.section === sec); %>
              <button type="button" onclick="gotoQuestion(<%= firstIdx %>)" class="w-full text-left px-3 py-2 rounded-lg text-[11px] font-bold text-slate-600 hover:bg-slate-50 border border-slate-100"><%= sec %></button>
            <% }) %>
          </div>
        </div>
      </div>
    </form>
  </main>
</div>
<script>
  let currentQ = 0;
  const totalQ = <%= allQuestions.length %>;
  function gotoQuestion(idx) {
    if (idx < 0 || idx >= totalQ) return;
    document.querySelectorAll('.exam-question').forEach(el => el.style.display = 'none');
    document.querySelector('.exam-question[data-index="' + idx + '"]').style.display = 'block';
    document.querySelectorAll('.qbtn').forEach(b => b.classList.remove('current'));
    document.querySelector('.qbtn[data-index="' + idx + '"]').classList.add('current');
    currentQ = idx;
    document.getElementById('prevBtn').disabled = idx === 0;
    document.getElementById('nextBtn').disabled = idx === totalQ - 1;
    document.getElementById('questionPanel').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  function markAnswered(idx) {
    document.querySelector('.qbtn[data-index="' + idx + '"]').classList.add('answered');
  }
  function toggleMark(idx) {
    document.querySelector('.qbtn[data-index="' + idx + '"]').classList.toggle('marked');
  }
  document.getElementById('prevBtn').disabled = true;
  if (totalQ <= 1) document.getElementById('nextBtn').disabled = true;

  // Real countdown from the server-computed expiry (exam_submissions.expires_at) —
  // never a client-invented timer. Auto-submits when time runs out.
  (function () {
    const box = document.getElementById('timerBox');
    const expiresAt = new Date(box.dataset.expiresAt).getTime();
    function tick() {
      const remainingMs = expiresAt - Date.now();
      if (remainingMs <= 0) {
        box.textContent = '00:00';
        document.getElementById('exam-take-form').submit();
        return;
      }
      const mins = Math.floor(remainingMs / 60000);
      const secs = Math.floor((remainingMs % 60000) / 1000);
      box.textContent = String(mins).padStart(2, '0') + ':' + String(secs).padStart(2, '0');
      setTimeout(tick, 1000);
    }
    tick();
  })();
</script>
</body>
</html>
