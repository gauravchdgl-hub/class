<%- include('../partials/header', { title: assignment.title }) %>
<h1><%= assignment.title %></h1>
<form method="post" action="/student/exams/<%= assignment.id %>/submit">

  <div class="section-title">Section A — Multiple Choice Questions (<%= mcqs.length %>)</div>
  <% mcqs.forEach((q, i) => { %>
    <div class="question-block">
      <p><strong>Question <%= i+1 %> of <%= mcqs.length %></strong></p>
      <p><%= q.question %></p>
      <label><input type="radio" name="mcq_<%= q.id %>" value="A" required> A. <%= q.option_a %></label>
      <label><input type="radio" name="mcq_<%= q.id %>" value="B"> B. <%= q.option_b %></label>
      <label><input type="radio" name="mcq_<%= q.id %>" value="C"> C. <%= q.option_c %></label>
      <label><input type="radio" name="mcq_<%= q.id %>" value="D"> D. <%= q.option_d %></label>
    </div>
  <% }) %>

  <div class="section-title">Section B — Written Questions (<%= written.length %>)</div>
  <% written.forEach((q, i) => { %>
    <div class="question-block">
      <p><strong>Question <%= mcqs.length + i + 1 %></strong> (<%= q.marks %> marks)</p>
      <p><%= q.question %></p>
      <textarea name="written_<%= q.id %>" rows="5" placeholder="Type your answer here... (word limit: <%= q.word_limit || 500 %>)"></textarea>
    </div>
  <% }) %>

  <div class="section-title">Section C — Essay Question(s) (<%= essays.length %>)</div>
  <% essays.forEach((q, i) => { %>
    <div class="question-block">
      <p><strong>Question <%= mcqs.length + written.length + i + 1 %></strong> (<%= q.marks %> marks)</p>
      <p><%= q.question %></p>
      <textarea name="essay_<%= q.id %>" rows="8" placeholder="Type your answer here... (word limit: <%= q.word_limit || 1000 %>)"></textarea>
    </div>
  <% }) %>

  <button class="btn red" type="submit">Submit Exam</button>
</form>
<%- include('../partials/footer') %>
