<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= material.title %> - AUS Academy</title>
<link rel="stylesheet" href="/assets/tailwind.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  body{font-family:'Inter',sans-serif;background:#f4f6fa;color:#1e293b}
  ::-webkit-scrollbar{width:6px;height:6px}
  ::-webkit-scrollbar-thumb{background:#cbd5e1;border-radius:4px}
</style>
</head>
<body class="bg-[#f4f6fa] text-slate-800 antialiased min-h-screen flex flex-col overflow-x-hidden">
<div id="sidebar-backdrop" onclick="toggleSidebar()" class="fixed inset-0 bg-slate-900/50 z-40 hidden lg:hidden transition-opacity duration-300"></div>
<div class="flex flex-1 min-h-screen relative">

  <aside id="sidebar" class="fixed inset-y-0 left-0 z-50 w-64 bg-[#071330] text-slate-300 flex flex-col justify-between shrink-0 transform -translate-x-full lg:translate-x-0 lg:static lg:z-auto transition-transform duration-300 ease-in-out h-screen overflow-y-auto border-r border-slate-800">
    <div>
      <div class="p-5 border-b border-slate-800 flex items-center justify-between bg-[#040a1d]">
        <div class="flex items-center space-x-3">
          <div class="w-8 h-8 rounded-lg bg-blue-600 flex items-center justify-center text-white font-bold text-lg shadow-md shrink-0"><i class="fa-solid fa-graduation-cap"></i></div>
          <div><h1 class="font-bold text-base leading-tight tracking-wide text-white">AUS Academy</h1><p class="text-[10px] text-slate-400 mt-0.5">Australia Year 11–12 Student Portal</p></div>
        </div>
        <button onclick="toggleSidebar()" class="lg:hidden text-slate-400 hover:text-white"><i class="fa-solid fa-xmark text-xl"></i></button>
      </div>
      <nav class="p-3 space-y-1 text-sm font-medium">
        <a href="/student/dashboard" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition"><i class="fa-solid fa-house w-5 text-center text-slate-400"></i><span>Dashboard</span></a>
        <a href="/student/subjects" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition"><i class="fa-solid fa-book-open w-5 text-center text-slate-400"></i><span>My Subjects</span></a>
        <a href="/student/mcq-plans" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition"><i class="fa-solid fa-id-card w-5 text-center text-slate-400"></i><span>My Plan</span></a>
        <a href="/student/mcq/my" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition"><i class="fa-solid fa-circle-question w-5 text-center text-slate-400"></i><span>Practice MCQs</span></a>
        <a href="/student/tutorials" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition"><i class="fa-solid fa-video w-5 text-center text-slate-400"></i><span>Tutorials</span></a>
        <a href="/student/material" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg bg-blue-600 text-white shadow-md font-semibold shadow-blue-600/30"><i class="fa-solid fa-book w-5 text-center text-white"></i><span>Study Material</span></a>
        <a href="/student/results" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition"><i class="fa-solid fa-chart-pie w-5 text-center text-slate-400"></i><span>Results</span></a>
        <a href="/student/profile" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition"><i class="fa-solid fa-gear w-5 text-center text-slate-400"></i><span>Profile &amp; Settings</span></a>
      </nav>
    </div>
  </aside>

  <main class="flex-1 flex flex-col min-w-0 overflow-y-auto bg-slate-50 min-h-screen relative">
    <header class="bg-white border-b border-slate-200 px-4 sm:px-6 py-3 flex items-center justify-between sticky top-0 z-30 shadow-sm">
      <div class="flex items-center space-x-3 w-full max-w-2xl">
        <button onclick="toggleSidebar()" class="lg:hidden p-2 rounded-lg text-slate-600 hover:bg-slate-100"><i class="fa-solid fa-bars text-lg"></i></button>
      </div>
      <div class="flex items-center space-x-3 sm:space-x-4 pl-2 shrink-0">
        <div class="w-8 h-8 rounded-full bg-blue-100 text-blue-700 font-bold flex items-center justify-center text-xs"><%= currentUser.name.charAt(0) %></div>
        <div class="hidden sm:block text-left"><h4 class="text-xs font-bold text-slate-800 leading-none mb-0.5"><%= currentUser.name %></h4></div>
      </div>
    </header>

    <div class="p-4 sm:p-6 lg:p-8 max-w-[1700px] mx-auto w-full space-y-6">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <nav class="flex text-[13px] text-slate-500 space-x-2 font-medium">
          <a href="/student/material" class="hover:text-blue-600 transition">Study Material</a><span class="text-slate-400">&gt;</span>
          <span class="text-[#091e42] font-semibold"><%= material.title %></span>
        </nav>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        <div class="lg:col-span-8 space-y-6">

          <% if (material.content_type === 'video') { %>
          <div class="bg-slate-900 rounded-2xl overflow-hidden shadow-2xl relative">
            <div class="aspect-video">
              <video controls class="w-full h-full"><source src="/student/material/<%= material.id %>/file" type="video/mp4"></video>
            </div>
          </div>
          <% } %>

          <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm space-y-6">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 pb-4">
              <h3 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight"><%= material.title %></h3>
              <% if (material.content_type === 'link' && material.file_url) { %>
                <a href="<%= material.file_url %>" target="_blank" rel="noopener" class="inline-flex items-center space-x-1.5 bg-purple-50 text-purple-700 border border-purple-200 hover:bg-purple-100 px-3 py-1.5 rounded-full font-bold text-xs shrink-0 transition"><i class="fa-solid fa-arrow-up-right-from-square"></i><span>Open Link</span></a>
              <% } else if (material.content_type !== 'video') { %>
                <a href="/student/material/<%= material.id %>/file<%= material.allow_download ? '?dl=1' : '' %>" class="bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs px-4 py-2.5 rounded-xl transition shadow-md shadow-blue-600/30 flex items-center space-x-1.5"><i class="fa-solid fa-download"></i><span><%= material.allow_download ? 'Download' : 'View' %> <%= material.content_type.toUpperCase() %></span></a>
              <% } %>
            </div>

            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div class="flex flex-wrap items-center gap-2">
                <span class="bg-blue-50 text-blue-700 font-bold text-xs px-3 py-1 rounded-lg"><%= material.subject_name || 'General' %></span>
                <span class="bg-slate-100 text-slate-700 font-semibold text-xs px-3 py-1 rounded-lg"><%= material.year || 'Any Year' %></span>
                <span class="bg-slate-100 text-slate-700 font-semibold text-xs px-3 py-1 rounded-lg flex items-center space-x-1"><i class="fa-regular fa-file"></i><span><%= material.fileMeta.sizeLabel %></span></span>
                <span class="bg-slate-100 text-slate-700 font-semibold text-xs px-3 py-1 rounded-lg flex items-center space-x-1"><i class="fa-regular fa-eye"></i><span><%= material.views %> views</span></span>
              </div>
              <% if (assignedBy) { %>
              <div class="text-xs"><span class="text-slate-400 block leading-none">Assigned by</span><span class="font-bold text-slate-900"><%= assignedBy.name %></span></div>
              <% } %>
            </div>

            <% if (assignment && (assignment.due_date || assignment.instructions)) { %>
            <div class="text-[11px] text-slate-500 bg-slate-50 p-3 rounded-xl border border-slate-100 flex items-center justify-between flex-wrap gap-2">
              <% if (assignment.due_date) { %><span>Due <%= new Date(assignment.due_date).toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'}) %></span><% } %>
              <% if (assignment.instructions) { %><span class="font-medium text-slate-700"><%= assignment.instructions %></span><% } %>
            </div>
            <% } %>

            <div class="space-y-4 text-xs leading-relaxed text-slate-700">
              <div><h4 class="font-bold text-slate-900 text-sm mb-1">Description</h4><p><%= material.notes || 'No description provided yet.' %></p></div>
              <% if (material.tags) { %>
              <div class="flex flex-wrap gap-2">
                <% material.tags.split(',').map(t=>t.trim()).filter(Boolean).forEach(tag => { %><span class="bg-slate-100 text-slate-600 px-2.5 py-1 rounded-md text-[11px] font-semibold">#<%= tag %></span><% }) %>
              </div>
              <% } %>
            </div>
          </div>
        </div>

        <div class="lg:col-span-4 space-y-6">

          <% if (otherMaterials.length) { %>
          <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm space-y-4">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3"><h3 class="font-bold text-base text-[#091e42]">More in <%= material.subject_name %></h3></div>
            <div class="space-y-2.5">
              <% otherMaterials.forEach(o => { %>
                <a href="/student/material/<%= o.id %>" class="flex items-center space-x-3 p-2.5 rounded-xl hover:bg-slate-50 border border-transparent hover:border-slate-200 cursor-pointer transition">
                  <div class="w-10 h-10 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center shrink-0"><i class="fa-solid fa-file-lines"></i></div>
                  <div class="flex-1 min-w-0"><h4 class="font-bold text-xs text-slate-800 truncate"><%= o.title %></h4></div>
                </a>
              <% }) %>
            </div>
          </div>
          <% } %>

          <% if (material.allow_comments) { %>
          <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm space-y-4">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3"><h3 class="font-bold text-base text-[#091e42]">Comments &amp; Questions</h3></div>

            <form method="post" action="/student/material/<%= material.id %>/comment" class="relative">
              <textarea name="body" rows="2" required placeholder="Ask a question or add a comment..." class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-xs text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
              <button type="submit" class="absolute right-2.5 bottom-3 w-8 h-8 rounded-lg bg-blue-600 text-white flex items-center justify-center text-xs shadow-md hover:bg-blue-700 transition"><i class="fa-solid fa-paper-plane"></i></button>
            </form>

            <div class="space-y-4 pt-2 text-xs">
              <% const roots = comments.filter(c => !c.parent_id); %>
              <% roots.forEach(c => { %>
                <div class="space-y-2">
                  <div class="flex items-start space-x-3">
                    <div class="w-8 h-8 rounded-full bg-slate-200 flex items-center justify-center text-[11px] font-bold text-slate-600 shrink-0"><%= c.user_name.charAt(0) %></div>
                    <div class="flex-1 bg-slate-50 p-3.5 rounded-xl border border-slate-100 space-y-1">
                      <div class="flex items-center justify-between"><h4 class="font-bold text-slate-900"><%= c.user_name %></h4><span class="text-[10px] text-slate-400"><%= new Date(c.created_at).toLocaleDateString('en-GB',{day:'numeric',month:'short'}) %></span></div>
                      <p class="text-slate-700 leading-relaxed"><%= c.body %></p>
                    </div>
                  </div>
                  <% comments.filter(r => r.parent_id === c.id).forEach(r => { %>
                    <div class="flex items-start space-x-3 pl-8">
                      <div class="w-8 h-8 rounded-full bg-blue-200 flex items-center justify-center text-[11px] font-bold text-blue-700 shrink-0"><%= r.user_name.charAt(0) %></div>
                      <div class="flex-1 bg-blue-50/60 p-3.5 rounded-xl border border-blue-100 space-y-1">
                        <div class="flex items-center justify-between">
                          <div class="flex items-center space-x-2"><h4 class="font-bold text-slate-900"><%= r.user_name %></h4><% if (r.user_role !== 'student') { %><span class="bg-blue-600 text-white font-bold text-[9px] px-2 py-0.5 rounded-full">Teacher</span><% } %></div>
                          <span class="text-[10px] text-slate-400"><%= new Date(r.created_at).toLocaleDateString('en-GB',{day:'numeric',month:'short'}) %></span>
                        </div>
                        <p class="text-slate-700 leading-relaxed"><%= r.body %></p>
                      </div>
                    </div>
                  <% }) %>
                </div>
              <% }) %>
              <% if (!roots.length) { %><p class="text-slate-400 text-center py-4">No comments yet — ask the first question!</p><% } %>
            </div>
          </div>
          <% } %>
        </div>
      </div>

      <footer class="pt-6 pb-4 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 font-medium">
        <p>&copy; 2026 AUS Academy. All rights reserved.</p>
      </footer>
    </div>
  </main>
</div>
<script>
  function toggleSidebar() {
    document.getElementById('sidebar').classList.toggle('-translate-x-full');
    document.getElementById('sidebar-backdrop').classList.toggle('hidden');
  }
</script>
</body>
</html>
