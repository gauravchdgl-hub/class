<%- include('../partials/header', { title: 'Practice MCQs' }) %>
<%- include('../partials/content_protection') %>
<div class="card protected-content">
  <p class="muted">Question <%= totalAttempted + 1 %> of <%= totalAllowed %></p>
  <h2><%= mcq.question %></h2>
  <form method="post" action="/student/mcq/practice/<%= plan.id %>/answer">
    <input type="hidden" name="mcq_id" value="<%= mcq.id %>">
    <label><input type="radio" name="selected_option" value="A" required> A. <%= mcq.option_a %></label>
    <label><input type="radio" name="selected_option" value="B"> B. <%= mcq.option_b %></label>
    <label><input type="radio" name="selected_option" value="C"> C. <%= mcq.option_c %></label>
    <label><input type="radio" name="selected_option" value="D"> D. <%= mcq.option_d %></label>
    <button class="btn" type="submit">Next</button>
  </form>
</div>
<%- include('../partials/footer') %>
