<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= assignment.topic || 'MCQ Practice' %> - AUS Academy</title>
<link rel="stylesheet" href="/assets/tailwind.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  body{font-family:'Inter',sans-serif;background:#f4f6fa;color:#1e293b}
  ::-webkit-scrollbar{width:6px;height:6px}
  ::-webkit-scrollbar-thumb{background:#cbd5e1;border-radius:4px}
</style>
</head>
<body class="bg-[#f4f6fa] text-slate-800 antialiased min-h-screen flex flex-col overflow-x-hidden">
<div id="sidebar-backdrop" onclick="toggleSidebar()" class="fixed inset-0 bg-slate-900/50 z-40 hidden lg:hidden transition-opacity duration-300"></div>
<div class="flex flex-1 min-h-screen relative">

  <aside id="sidebar" class="fixed inset-y-0 left-0 z-50 w-64 bg-[#071330] text-slate-300 flex flex-col justify-between shrink-0 transform -translate-x-full lg:translate-x-0 lg:static lg:z-auto transition-transform duration-300 ease-in-out h-screen overflow-y-auto border-r border-slate-800">
    <div>
      <div class="p-5 border-b border-slate-800 flex items-center justify-between bg-[#040a1d]">
        <div class="flex items-center space-x-3">
          <div class="w-8 h-8 rounded-lg bg-blue-600 flex items-center justify-center text-white font-bold text-lg shadow-md shrink-0"><i class="fa-solid fa-graduation-cap"></i></div>
          <div><h1 class="font-bold text-base leading-tight tracking-wide text-white">AUS Academy</h1><p class="text-[10px] text-slate-400 mt-0.5">Australia Year 11–12 Student Portal</p></div>
        </div>
        <button onclick="toggleSidebar()" class="lg:hidden text-slate-400 hover:text-white"><i class="fa-solid fa-xmark text-xl"></i></button>
      </div>
      <nav class="p-3 space-y-1 text-sm font-medium">
        <a href="/student/dashboard" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition"><i class="fa-solid fa-house w-5 text-center text-slate-400"></i><span>Dashboard</span></a>
        <a href="/student/mcq/my" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition"><i class="fa-solid fa-clipboard-list w-5 text-center text-slate-400"></i><span>My Assignments</span></a>
        <a href="#" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg bg-blue-600 text-white shadow-md font-semibold shadow-blue-600/30"><i class="fa-solid fa-circle-question w-5 text-center text-white"></i><span>Practice MCQs</span></a>
        <a href="/student/tutorials" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition"><i class="fa-solid fa-video w-5 text-center text-slate-400"></i><span>Tutorials</span></a>
        <a href="/student/material" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition"><i class="fa-solid fa-book w-5 text-center text-slate-400"></i><span>Study Material</span></a>
        <a href="/student/results" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition"><i class="fa-solid fa-chart-pie w-5 text-center text-slate-400"></i><span>Results</span></a>
      </nav>
    </div>
  </aside>

  <main class="flex-1 flex flex-col min-w-0 overflow-y-auto bg-slate-50 min-h-screen relative">
    <header class="bg-white border-b border-slate-200 px-4 sm:px-6 py-3 flex items-center justify-between sticky top-0 z-30 shadow-sm">
      <div class="flex items-center space-x-3">
        <button onclick="toggleSidebar()" class="lg:hidden p-2 rounded-lg text-slate-600 hover:bg-slate-100 focus:outline-none"><i class="fa-solid fa-bars text-lg"></i></button>
        <span class="font-bold text-sm text-slate-800">MCQ Practice</span>
      </div>
    </header>

    <div class="p-4 sm:p-6 lg:p-8 max-w-[1700px] mx-auto w-full space-y-6">

      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="flex items-start space-x-4">
          <div class="w-10 h-10 rounded-xl bg-blue-600 text-white flex items-center justify-center shrink-0 mt-0.5 shadow-md shadow-blue-600/30"><i class="fa-solid fa-circle-question text-lg"></i></div>
          <div>
            <h2 class="text-2xl sm:text-[28px] font-bold text-[#091e42] tracking-tight"><%= assignment.subject_name || 'General' %> MCQ Practice</h2>
            <p class="text-[13px] text-slate-500 mt-0.5"><%= assignment.topic || 'Practice Set' %></p>
          </div>
        </div>
        <a href="/student/mcq/my" class="bg-white hover:bg-red-50 text-red-600 border border-red-200 font-bold px-4 py-2.5 rounded-xl text-xs transition shadow-sm flex items-center space-x-2">
          <i class="fa-solid fa-right-from-bracket"></i><span>Exit Test</span>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white rounded-2xl border border-slate-200 p-4 shadow-sm flex items-center justify-between">
          <div><span class="text-xs font-semibold text-slate-500 block mb-1">Total Questions</span><h3 class="text-2xl font-bold text-[#091e42]"><%= total %></h3></div>
          <div class="w-12 h-12 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center text-xl shrink-0"><i class="fa-solid fa-file-lines"></i></div>
        </div>
        <div class="bg-white rounded-2xl border border-slate-200 p-4 shadow-sm flex items-center justify-between">
          <div><span class="text-xs font-semibold text-slate-500 block mb-1">Answered</span><h3 class="text-2xl font-bold text-[#091e42]"><%= answered %></h3></div>
          <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-500 flex items-center justify-center text-xl shrink-0"><i class="fa-regular fa-clock"></i></div>
        </div>
        <div class="bg-white rounded-2xl border border-slate-200 p-4 shadow-sm flex items-center justify-between">
          <div><span class="text-xs font-semibold text-slate-500 block mb-1">Question Type</span><h3 class="text-xl font-bold text-[#091e42]">Multiple Choice</h3></div>
          <div class="w-12 h-12 rounded-2xl bg-purple-50 text-purple-600 flex items-center justify-center text-xl shrink-0"><i class="fa-solid fa-list-check"></i></div>
        </div>
        <div class="bg-white rounded-2xl border border-slate-200 p-4 shadow-sm flex items-center justify-between">
          <div><span class="text-xs font-semibold text-slate-500 block mb-1">Due Date</span><h3 class="text-xl font-bold text-[#091e42]"><%= assignment.due_date ? new Date(assignment.due_date).toLocaleDateString() : 'No due date' %></h3></div>
          <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl shrink-0"><i class="fa-solid fa-star"></i></div>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        <div class="lg:col-span-8 space-y-6">

          <% if (!mcq) { %>
            <div class="bg-white rounded-2xl border border-slate-200 p-8 shadow-sm text-center">
              <p class="text-slate-500">No more questions — redirecting to your result...</p>
            </div>
          <% } else { %>
          <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-sm space-y-6">
            <div class="space-y-2">
              <div class="flex items-center justify-between text-xs font-bold">
                <span class="text-slate-900">Question <%= answered + 1 %> of <%= total %></span>
                <span class="text-slate-500 font-medium"><%= total ? Math.round(((answered + 1) / total) * 100) : 0 %>% Complete</span>
              </div>
              <div class="w-full h-2 bg-slate-100 rounded-full overflow-hidden">
                <div class="h-full bg-blue-600 rounded-full transition-all duration-300" style="width: <%= total ? Math.round(((answered + 1) / total) * 100) : 0 %>%"></div>
              </div>
            </div>

            <div class="flex items-start justify-between gap-4 pt-2">
              <h3 class="text-base sm:text-lg font-bold text-slate-900 leading-snug"><%= mcq.question %></h3>
              <a href="/student/report-issue?type=mcq&id=<%= mcq.id %>" target="_blank" class="text-[11px] font-bold text-rose-600 shrink-0">⚑ Report issue</a>
            </div>

            <form method="post" action="/student/mcq/assignment/<%= assignment.id %>/answer">
              <input type="hidden" name="aq_id" value="<%= mcq.aq_id %>">
              <div class="space-y-3 pt-2">
                <% ['A','B','C','D'].forEach(letter => { %>
                  <% const text = mcq['option_' + letter.toLowerCase()]; %>
                  <% if (text) { %>
                    <label class="flex items-center justify-between p-4 rounded-xl border cursor-pointer transition bg-slate-50 hover:bg-slate-100 border-slate-200">
                      <div class="flex items-center space-x-3">
                        <div class="w-7 h-7 rounded-lg bg-white text-slate-700 border border-slate-200 flex items-center justify-center text-xs shadow-sm font-bold"><%= letter %></div>
                        <span class="font-semibold text-sm text-slate-800"><%= text %></span>
                      </div>
                      <input type="radio" name="selected_option" value="<%= letter %>" required class="w-4 h-4 text-emerald-600 focus:ring-emerald-500">
                    </label>
                  <% } %>
                <% }) %>
              </div>
              <button type="submit" class="mt-6 bg-blue-600 hover:bg-blue-700 text-white font-bold px-6 py-3 rounded-xl text-xs transition shadow-lg shadow-blue-600/30 flex items-center space-x-2">
                <span>Submit &amp; Next</span><i class="fa-solid fa-arrow-right"></i>
              </button>
            </form>
          </div>

          <% if (mcq.explanation) { %>
          <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-sm space-y-4">
            <div class="flex items-center space-x-2 text-[#091e42] border-b border-slate-100 pb-3"><i class="fa-solid fa-book-open text-blue-600 text-sm"></i><h3 class="font-bold text-sm">Question Explanation</h3></div>
            <p class="text-xs leading-relaxed text-slate-700"><%= mcq.explanation %></p>
          </div>
          <% } %>
          <% } %>
        </div>

        <div class="lg:col-span-4 space-y-6">
          <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm space-y-4">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
              <h3 class="font-bold text-base text-[#091e42]">Question Palette</h3>
              <span class="text-xs font-semibold text-slate-500"><%= answered %> Answered</span>
            </div>
            <div class="grid grid-cols-2 gap-2 text-[11px] font-medium text-slate-600 pb-2">
              <div class="flex items-center space-x-2"><span class="w-3 h-3 rounded-full bg-emerald-500 inline-block"></span><span>Answered</span></div>
              <div class="flex items-center space-x-2"><span class="w-3 h-3 rounded-full bg-blue-600 inline-block"></span><span>Current</span></div>
              <div class="flex items-center space-x-2"><span class="w-3 h-3 rounded-full bg-slate-200 inline-block"></span><span>Not Answered</span></div>
            </div>
            <div class="grid grid-cols-5 gap-2 pt-2">
              <% for (let i = 0; i < total; i++) { %>
                <% const isAnswered = i < answered; const isCurrent = i === answered; %>
                <div class="h-10 rounded-xl border text-xs font-bold transition flex items-center justify-center
                  <%= isAnswered ? 'bg-emerald-500 text-white border-emerald-600 shadow-sm' : 'bg-slate-100 text-slate-700 border-slate-200' %>
                  <%= isCurrent ? ' ring-2 ring-blue-600 ring-offset-2' : '' %>"><%= i + 1 %></div>
              <% } %>
            </div>
          </div>
        </div>
      </div>

    </div>
  </main>
</div>
<script>
  function toggleSidebar(){ document.getElementById('sidebar').classList.toggle('-translate-x-full'); document.getElementById('sidebar-backdrop').classList.toggle('hidden'); }
</script>
</body>
</html>
