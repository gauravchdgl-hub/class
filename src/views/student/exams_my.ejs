<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My Exam Papers - AUS Academy</title>
<link rel="stylesheet" href="/assets/tailwind.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  body{font-family:'Inter',sans-serif;background:#f4f6fa;color:#1e293b}
  ::-webkit-scrollbar{width:6px;height:6px}
  ::-webkit-scrollbar-thumb{background:#cbd5e1;border-radius:4px}
  .custom-select{background-image:url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%236b7280' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3e%3c/svg%3e");background-position:right .6rem center;background-repeat:no-repeat;background-size:1em 1em;padding-right:2rem;-webkit-appearance:none;appearance:none}
</style>
</head>
<body class="bg-[#f4f6fa] text-slate-800 antialiased min-h-screen flex flex-col overflow-x-hidden">
<div id="sidebar-backdrop" onclick="toggleSidebar()" class="fixed inset-0 bg-slate-900/50 z-40 hidden lg:hidden transition-opacity duration-300"></div>
<div class="flex flex-1 min-h-screen relative">

  <aside id="sidebar" class="fixed inset-y-0 left-0 z-50 w-64 bg-[#071330] text-slate-300 flex flex-col justify-between shrink-0 transform -translate-x-full lg:translate-x-0 lg:static lg:z-auto transition-transform duration-300 ease-in-out h-screen overflow-y-auto border-r border-slate-800">
    <div>
      <div class="p-5 border-b border-slate-800 flex items-center justify-between bg-[#040a1d]">
        <div class="flex items-center space-x-3">
          <div class="w-8 h-8 rounded-lg bg-blue-600 flex items-center justify-center text-white font-bold text-lg shadow-md shrink-0"><i class="fa-solid fa-graduation-cap"></i></div>
          <div><h1 class="font-bold text-base leading-tight tracking-wide text-white">AUS Academy</h1><p class="text-[10px] text-slate-400 mt-0.5">Australia Year 11–12 Student Portal</p></div>
        </div>
        <button onclick="toggleSidebar()" class="lg:hidden text-slate-400 hover:text-white"><i class="fa-solid fa-xmark text-xl"></i></button>
      </div>
      <nav class="p-3 space-y-1 text-sm font-medium">
        <a href="/student/dashboard" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition"><i class="fa-solid fa-house w-5 text-center text-slate-400"></i><span>Dashboard</span></a>
        <a href="/student/subjects" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition"><i class="fa-solid fa-book-open w-5 text-center text-slate-400"></i><span>My Subjects</span></a>
        <a href="#" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg bg-blue-600 text-white shadow-md font-semibold shadow-blue-600/30"><i class="fa-solid fa-file-signature w-5 text-center text-white"></i><span>My Exam Papers</span></a>
        <a href="/student/mcq/my" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition"><i class="fa-solid fa-circle-question w-5 text-center text-slate-400"></i><span>Practice MCQs</span></a>
        <a href="/student/tutorials" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition"><i class="fa-solid fa-video w-5 text-center text-slate-400"></i><span>Tutorials</span></a>
        <a href="/student/material" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition"><i class="fa-solid fa-book w-5 text-center text-slate-400"></i><span>Study Material</span></a>
        <a href="/student/results" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition"><i class="fa-solid fa-chart-pie w-5 text-center text-slate-400"></i><span>Results</span></a>
        <a href="/student/settings" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition"><i class="fa-solid fa-gear w-5 text-center text-slate-400"></i><span>Profile &amp; Settings</span></a>
        <a href="/logout" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition"><i class="fa-solid fa-right-from-bracket w-5 text-center text-slate-400"></i><span>Logout</span></a>
      </nav>
    </div>
    <div class="p-4 bg-[#040a1d] border-t border-slate-800 space-y-3">
      <div class="flex items-center space-x-3 text-xs text-slate-400 pt-1">
        <div class="w-8 h-8 rounded-lg bg-blue-600/20 text-blue-400 flex items-center justify-center shrink-0"><i class="fa-solid fa-headset text-sm"></i></div>
        <div><h4 class="text-xs font-semibold text-white leading-tight">Need Help?</h4><span class="text-[10px] text-slate-400">Contact Support</span></div>
      </div>
    </div>
  </aside>

  <main class="flex-1 flex flex-col min-w-0 overflow-y-auto bg-slate-50 min-h-screen relative">
    <header class="bg-white border-b border-slate-200 px-4 sm:px-6 py-3 flex items-center justify-between sticky top-0 z-30 shadow-sm">
      <div class="flex items-center space-x-3 w-full max-w-2xl">
        <button onclick="toggleSidebar()" class="lg:hidden p-2 rounded-lg text-slate-600 hover:bg-slate-100 focus:outline-none"><i class="fa-solid fa-bars text-lg"></i></button>
      </div>
      <div class="flex items-center space-x-3 sm:space-x-4 pl-2 shrink-0">
        <div class="flex items-center space-x-2.5">
          <div class="w-8 h-8 rounded-full bg-blue-600 text-white flex items-center justify-center font-bold text-sm"><%= (currentUser.name||'S').charAt(0).toUpperCase() %></div>
          <div class="hidden sm:block text-left"><h4 class="text-xs font-bold text-slate-800 leading-none mb-0.5"><%= currentUser.name %></h4><span class="text-[11px] text-slate-500 font-medium"><%= currentUser.class_year || 'Student' %></span></div>
        </div>
      </div>
    </header>

    <div class="p-4 sm:p-6 lg:p-8 max-w-[1700px] mx-auto w-full space-y-6">

      <div class="bg-gradient-to-r from-[#0d1b3e] via-[#102552] to-[#162d61] rounded-3xl p-6 sm:p-8 text-white shadow-xl relative overflow-hidden flex flex-col justify-between">
        <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-blue-500/20 rounded-full blur-3xl pointer-events-none"></div>
        <div class="relative z-10 space-y-2">
          <nav class="flex text-xs text-blue-300 space-x-2 font-medium">
            <a href="/student/dashboard" class="hover:text-white transition">Home</a><span>&gt;</span><span class="text-white font-semibold">My Exam Papers</span>
          </nav>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">My Exam Papers</h2>
          <p class="text-xs sm:text-sm text-slate-300 max-w-xl">All full exam papers assigned to you by your teachers.</p>
        </div>
      </div>

      <form method="get" class="bg-white rounded-2xl border border-slate-200 p-4 shadow-sm flex flex-wrap items-center gap-3">
        <select name="subject_id" onchange="this.form.submit()" class="custom-select bg-slate-50 border border-slate-200 text-slate-700 text-xs font-semibold rounded-xl px-3.5 py-2.5 outline-none focus:ring-2 focus:ring-blue-500">
          <option value="">All Subjects</option>
          <% subjects.forEach(s => { %><option value="<%= s.id %>" <%= String(filters.subject_id)===String(s.id)?'selected':'' %>><%= s.name %></option><% }) %>
        </select>
        <select name="year" onchange="this.form.submit()" class="custom-select bg-slate-50 border border-slate-200 text-slate-700 text-xs font-semibold rounded-xl px-3.5 py-2.5 outline-none focus:ring-2 focus:ring-blue-500">
          <option value="">All Years</option>
          <option value="Year 11" <%= filters.year==='Year 11'?'selected':'' %>>Year 11</option>
          <option value="Year 12" <%= filters.year==='Year 12'?'selected':'' %>>Year 12</option>
        </select>
        <select name="status" onchange="this.form.submit()" class="custom-select bg-slate-50 border border-slate-200 text-slate-700 text-xs font-semibold rounded-xl px-3.5 py-2.5 outline-none focus:ring-2 focus:ring-blue-500">
          <option value="">All Status</option>
          <option value="Assigned" <%= filters.status==='Assigned'?'selected':'' %>>Assigned</option>
          <option value="In Progress" <%= filters.status==='In Progress'?'selected':'' %>>In Progress</option>
          <option value="Submitted" <%= filters.status==='Submitted'?'selected':'' %>>Submitted</option>
          <option value="Completed" <%= filters.status==='Completed'?'selected':'' %>>Completed</option>
        </select>
      </form>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm flex items-center justify-between">
          <div><span class="text-xs font-semibold text-slate-400 uppercase tracking-wide block mb-1">Total Papers</span><h3 class="text-3xl font-extrabold text-slate-900"><%= metrics.total %></h3></div>
          <div class="w-12 h-12 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center text-xl shrink-0"><i class="fa-solid fa-file-signature"></i></div>
        </div>
        <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm flex items-center justify-between">
          <div><span class="text-xs font-semibold text-slate-400 uppercase tracking-wide block mb-1">Year 11</span><h3 class="text-3xl font-extrabold text-slate-900"><%= metrics.year11 %></h3></div>
          <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-500 flex items-center justify-center text-xl shrink-0"><i class="fa-solid fa-layer-group"></i></div>
        </div>
        <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm flex items-center justify-between">
          <div><span class="text-xs font-semibold text-slate-400 uppercase tracking-wide block mb-1">Year 12</span><h3 class="text-3xl font-extrabold text-slate-900"><%= metrics.year12 %></h3></div>
          <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl shrink-0"><i class="fa-solid fa-layer-group"></i></div>
        </div>
        <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm flex items-center justify-between">
          <div><span class="text-xs font-semibold text-slate-400 uppercase tracking-wide block mb-1">Assigned by Teachers</span><h3 class="text-3xl font-extrabold text-slate-900"><%= metrics.assignedCount %></h3></div>
          <div class="w-12 h-12 rounded-2xl bg-rose-50 text-rose-500 flex items-center justify-center text-xl shrink-0"><i class="fa-solid fa-chalkboard-user"></i></div>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <% papers.forEach(p => { %>
          <% const statusClass = p.display_status === 'Completed' ? 'bg-emerald-50 text-emerald-600' : (p.display_status === 'In Progress' ? 'bg-amber-50 text-amber-600' : (p.display_status === 'Submitted' ? 'bg-blue-50 text-blue-600' : 'bg-slate-100 text-slate-600')); %>
          <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden flex flex-col hover:shadow-md transition">
            <div class="h-24 bg-gradient-to-br from-blue-600 to-indigo-700 flex items-center justify-center relative">
              <i class="fa-solid fa-file-signature text-white/40 text-4xl"></i>
              <span class="absolute top-2 right-2 <%= statusClass %> text-[10px] font-bold px-2.5 py-1 rounded-full"><%= p.display_status %></span>
            </div>
            <div class="p-4 flex-1 flex flex-col space-y-2">
              <span class="text-[10px] font-bold text-blue-600 uppercase tracking-wider"><%= p.subject_name %></span>
              <h3 class="text-sm font-bold text-slate-900 leading-snug"><%= p.title %></h3>
              <% if (p.description) { %><p class="text-[11px] text-slate-500 line-clamp-2"><%= p.description %></p><% } %>
              <div class="flex items-center flex-wrap gap-x-3 gap-y-1 text-[10px] font-medium text-slate-500 pt-1">
                <span><i class="fa-regular fa-calendar text-blue-500 mr-1"></i><%= p.year || '—' %></span>
                <span><i class="fa-regular fa-clock text-blue-500 mr-1"></i><%= p.duration_minutes %> min</span>
                <span><i class="fa-solid fa-list-ol text-blue-500 mr-1"></i><%= p.question_count %> Qs</span>
              </div>
              <div class="flex items-center justify-between pt-2 mt-auto border-t border-slate-100">
                <span class="text-[10px] text-slate-400">Assigned <%= new Date(p.assigned_at).toLocaleDateString() %></span>
                <a href="/student/exams/<%= p.assignment_id %>" class="bg-blue-600 hover:bg-blue-700 text-white font-bold text-[11px] px-3.5 py-2 rounded-xl transition shadow-md shadow-blue-600/30"><%= p.display_status === 'Completed' ? 'View Result' : (p.display_status === 'In Progress' ? 'Continue' : 'View') %></a>
              </div>
            </div>
          </div>
        <% }) %>
        <% if (!papers.length) { %>
          <div class="col-span-full text-center text-slate-400 py-10">No exam papers assigned yet. Your teacher will assign one soon — check back later.</div>
        <% } %>
      </div>

      <footer class="pt-6 pb-4 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 font-medium">
        <p>&copy; 2026 AUS Academy. All rights reserved.</p>
      </footer>
    </div>
  </main>
</div>
<script>
  function toggleSidebar(){ document.getElementById('sidebar').classList.toggle('-translate-x-full'); document.getElementById('sidebar-backdrop').classList.toggle('hidden'); }
</script>
</body>
</html>
