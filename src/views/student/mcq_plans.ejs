<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Browse MCQ Plans - AUS Academy</title>
<link rel="stylesheet" href="/assets/tailwind.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  body{font-family:'Inter',sans-serif;background:#f4f6fa;color:#1e293b}
  ::-webkit-scrollbar{width:6px;height:6px}
  ::-webkit-scrollbar-thumb{background:#cbd5e1;border-radius:4px}
  .plan-card-shadow{box-shadow:0 10px 30px rgba(27,97,249,.06)}
  .card-shadow{box-shadow:0 4px 20px rgba(0,0,0,.03)}
  .custom-select{background-image:url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%236b7280' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3e%3c/svg%3e");background-position:right .75rem center;background-repeat:no-repeat;background-size:1.2em 1.2em;padding-right:2.2rem;-webkit-appearance:none;appearance:none}
</style>
</head>
<body class="bg-[#f4f6fa] text-slate-800 antialiased min-h-screen flex flex-col overflow-x-hidden">
<div id="sidebar-backdrop" onclick="toggleSidebar()" class="fixed inset-0 bg-slate-900/50 z-40 hidden lg:hidden transition-opacity duration-300"></div>
<div class="flex flex-1 min-h-screen relative">

  <aside id="sidebar" class="fixed inset-y-0 left-0 z-50 w-64 bg-[#071330] text-slate-300 flex flex-col justify-between shrink-0 transform -translate-x-full lg:translate-x-0 lg:static lg:z-auto transition-transform duration-300 ease-in-out h-screen overflow-y-auto border-r border-slate-800">
    <div>
      <div class="p-5 border-b border-slate-800 flex items-center justify-between bg-[#040a1d]">
        <div class="flex items-center space-x-3">
          <div class="w-8 h-8 rounded-lg bg-blue-600 flex items-center justify-center text-white font-bold text-lg shadow-md shrink-0"><i class="fa-solid fa-graduation-cap"></i></div>
          <div><h1 class="font-bold text-base leading-tight tracking-wide text-white">AUS Academy</h1><p class="text-[10px] text-slate-400 mt-0.5">Australia Year 11–12 Student Portal</p></div>
        </div>
        <button onclick="toggleSidebar()" class="lg:hidden text-slate-400 hover:text-white"><i class="fa-solid fa-xmark text-xl"></i></button>
      </div>
      <nav class="p-3 space-y-1 text-sm font-medium">
        <a href="/student/dashboard" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition"><i class="fa-solid fa-house w-5 text-center text-slate-400"></i><span>Dashboard</span></a>
        <a href="/student/subjects" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition"><i class="fa-solid fa-book-open w-5 text-center text-slate-400"></i><span>My Subjects</span></a>
        <a href="#" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg bg-blue-600 text-white shadow-md font-semibold shadow-blue-600/30"><i class="fa-solid fa-layer-group w-5 text-center text-white"></i><span>MCQ Plans</span></a>
        <a href="/student/mcq/my" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition"><i class="fa-solid fa-circle-question w-5 text-center text-slate-400"></i><span>Practice MCQs</span></a>
        <a href="/student/tutorials" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition"><i class="fa-solid fa-video w-5 text-center text-slate-400"></i><span>Tutorials</span></a>
        <a href="/student/material" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition"><i class="fa-solid fa-book w-5 text-center text-slate-400"></i><span>Study Material</span></a>
        <a href="/student/results" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition"><i class="fa-solid fa-chart-pie w-5 text-center text-slate-400"></i><span>Results</span></a>
        <a href="/student/settings" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition"><i class="fa-solid fa-gear w-5 text-center text-slate-400"></i><span>Profile &amp; Settings</span></a>
        <a href="/logout" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition"><i class="fa-solid fa-right-from-bracket w-5 text-center text-slate-400"></i><span>Logout</span></a>
      </nav>
    </div>
    <div class="p-4 bg-[#040a1d] border-t border-slate-800 space-y-3">
      <div class="flex items-center space-x-3 text-xs text-slate-400 pt-1">
        <div class="w-8 h-8 rounded-lg bg-blue-600/20 text-blue-400 flex items-center justify-center shrink-0"><i class="fa-solid fa-headset text-sm"></i></div>
        <div><h4 class="text-xs font-semibold text-white leading-tight">Need Help?</h4><span class="text-[10px] text-slate-400">Contact Support</span></div>
      </div>
    </div>
  </aside>

  <main class="flex-1 flex flex-col min-w-0 overflow-y-auto bg-slate-50 min-h-screen relative">
    <header class="bg-white border-b border-slate-200 px-4 sm:px-6 py-3 flex items-center justify-between sticky top-0 z-30 shadow-sm">
      <div class="flex items-center space-x-3 w-full max-w-2xl">
        <button onclick="toggleSidebar()" class="lg:hidden p-2 rounded-lg text-slate-600 hover:bg-slate-100 focus:outline-none"><i class="fa-solid fa-bars text-lg"></i></button>
        <div class="flex items-center w-full bg-slate-50 rounded-lg px-3 py-2 border border-slate-200 hidden sm:flex">
          <i class="fa-solid fa-magnifying-glass text-slate-400 mr-2 text-sm"></i>
          <input type="text" placeholder="Search subjects, classes, or MCQ plans..." class="bg-transparent border-none text-xs sm:text-sm w-full outline-none text-slate-700 placeholder-slate-400">
        </div>
      </div>
      <div class="flex items-center space-x-3 sm:space-x-4 pl-2 shrink-0">
        <div class="flex items-center space-x-2.5">
          <div class="w-8 h-8 rounded-full bg-blue-600 text-white flex items-center justify-center font-bold text-sm"><%= (currentUser.name||'S').charAt(0).toUpperCase() %></div>
          <div class="hidden sm:block text-left"><h4 class="text-xs font-bold text-slate-800 leading-none mb-0.5"><%= currentUser.name %></h4><span class="text-[11px] text-slate-500 font-medium"><%= currentUser.class_year || 'Student' %></span></div>
        </div>
      </div>
    </header>

    <div class="p-4 sm:p-6 lg:p-8 max-w-[1450px] mx-auto w-full flex-1 flex flex-col space-y-6">

      <div>
        <h1 class="text-2xl sm:text-[28px] font-extrabold text-[#091e42] tracking-tight">Browse MCQ Plans</h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">Choose a plan and start practicing MCQs for your subjects. Improve your preparation with topic-wise practice questions.</p>
      </div>

      <!-- FILTER STRIP -->
      <form method="get" class="bg-white rounded-2xl border border-slate-200 card-shadow p-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        <div class="space-y-1">
          <label class="text-[10px] font-bold text-slate-500 uppercase block">Subject</label>
          <div class="relative">
            <div class="absolute left-3 top-2.5 text-blue-600 text-xs"><i class="fa-solid fa-book-open"></i></div>
            <select name="subject_id" onchange="this.form.submit()" class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-8 pr-4 py-2 text-xs font-bold text-slate-800 custom-select">
              <option value="">All Subjects</option>
              <% subjects.forEach(s => { %><option value="<%= s.id %>" <%= String(filters.subject_id)===String(s.id)?'selected':'' %>><%= s.name %></option><% }) %>
            </select>
          </div>
        </div>
        <div class="space-y-1 sm:col-span-1 lg:col-span-2">
          <label class="text-[10px] font-bold text-slate-500 uppercase block">&nbsp;</label>
          <div class="relative">
            <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-2.5 text-slate-400 text-xs"></i>
            <input type="text" placeholder="Search plans by name or subject..." class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-9 pr-3 py-2 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500" disabled>
          </div>
        </div>
      </form>

      <!-- PLAN CARDS GRID -->
      <% if (plans.length) { %>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <% plans.forEach((plan, i) => { %>
          <% const isPopular = popularPlanId != null && plan.id === popularPlanId; %>
          <% const accent = isPopular ? 'emerald' : (i % 3 === 2 ? 'purple' : 'blue'); %>
          <div class="bg-white rounded-3xl <%= isPopular ? 'border-2 border-emerald-500/80' : 'border border-slate-200' %> plan-card-shadow p-6 flex flex-col justify-between relative hover:border-<%= accent %>-300 transition">
            <% if (isPopular) { %>
              <div class="absolute -top-3.5 right-6 bg-emerald-500 text-white text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-wider shadow-sm">Popular</div>
            <% } %>
            <div>
              <div class="flex items-start justify-between border-b border-slate-100 pb-4 mb-5">
                <div class="flex items-center space-x-3">
                  <div class="w-12 h-12 rounded-2xl bg-<%= accent %>-100 text-<%= accent %>-600 flex items-center justify-center text-xl shrink-0 shadow-inner"><i class="fa-solid fa-book-bookmark"></i></div>
                  <div>
                    <h3 class="font-extrabold text-slate-900 text-lg leading-tight"><%= plan.name %></h3>
                    <span class="text-xs font-bold text-<%= accent %>-600 block"><%= plan.mcq_count %> MCQs</span>
                    <p class="text-[11px] text-slate-400 font-medium"><%= plan.subject_name || 'All subjects' %></p>
                  </div>
                </div>
                <div class="text-right shrink-0">
                  <% if (plan.discount_price != null && plan.discount_price < plan.price) { %>
                    <span class="text-[11px] text-slate-400 line-through block">A$<%= Number(plan.price).toFixed(2) %></span>
                    <span class="text-2xl font-extrabold text-<%= accent %>-600 block">A$<%= Number(plan.discount_price).toFixed(2) %></span>
                  <% } else { %>
                    <span class="text-2xl font-extrabold text-<%= accent %>-600 block">A$<%= Number(plan.price).toFixed(2) %></span>
                  <% } %>
                </div>
              </div>
              <ul class="space-y-3 text-xs text-slate-700 font-medium mb-6">
                <li class="flex items-center space-x-3"><i class="fa-solid fa-circle-check text-blue-600 text-sm"></i><span><%= plan.mcq_count %> Topic-wise MCQs</span></li>
                <li class="flex items-center space-x-3"><i class="fa-solid fa-circle-check text-blue-600 text-sm"></i><span>Multiple choice questions</span></li>
                <li class="flex items-center space-x-3"><i class="fa-solid fa-circle-check text-blue-600 text-sm"></i><span>Valid for <%= Math.round(plan.validity_days/30) %> month<%= Math.round(plan.validity_days/30)===1?'':'s' %></span></li>
                <li class="flex items-center space-x-3"><i class="fa-solid fa-circle-check text-blue-600 text-sm"></i><span>Instant access after purchase</span></li>
              </ul>
            </div>
            <form method="post" action="/student/mcq/plans/<%= plan.id %>/buy">
              <input type="hidden" name="subject_id" value="<%= plan.subject_id || '' %>">
              <button type="submit" class="w-full py-3 bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs rounded-2xl shadow-md shadow-blue-500/20 transition flex items-center justify-center space-x-2">
                <span>Enroll Now</span><i class="fa-solid fa-arrow-right text-xs"></i>
              </button>
            </form>
          </div>
        <% }) %>
      </div>
      <% } else { %>
      <div class="bg-white rounded-2xl border border-slate-200 card-shadow p-10 text-center text-slate-400 text-sm">No MCQ plans are available right now. Check back soon.</div>
      <% } %>

      <!-- SECTION: What's Included -->
      <div class="space-y-3">
        <div class="flex items-center space-x-2">
          <div class="w-7 h-7 rounded-lg bg-blue-600 text-white flex items-center justify-center text-xs shadow-sm"><i class="fa-solid fa-layer-group"></i></div>
          <h2 class="text-lg font-extrabold text-slate-900">What's Included in MCQ Plans?</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="bg-white rounded-2xl border border-slate-200 card-shadow p-4 flex items-start space-x-3">
            <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-lg shrink-0"><i class="fa-regular fa-file-lines"></i></div>
            <div><h4 class="font-bold text-slate-900 text-xs">Topic-wise Questions</h4><p class="text-[11px] text-slate-500 mt-0.5">Practice MCQs chapter and topic wise</p></div>
          </div>
          <div class="bg-white rounded-2xl border border-slate-200 card-shadow p-4 flex items-start space-x-3">
            <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-lg shrink-0"><i class="fa-regular fa-circle-check"></i></div>
            <div><h4 class="font-bold text-slate-900 text-xs">Detailed Explanations</h4><p class="text-[11px] text-slate-500 mt-0.5">Step-by-step solutions for better understanding</p></div>
          </div>
          <div class="bg-white rounded-2xl border border-slate-200 card-shadow p-4 flex items-start space-x-3">
            <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-lg shrink-0"><i class="fa-regular fa-clock"></i></div>
            <div><h4 class="font-bold text-slate-900 text-xs">Instant Access</h4><p class="text-[11px] text-slate-500 mt-0.5">Start practicing immediately after purchase</p></div>
          </div>
          <div class="bg-white rounded-2xl border border-slate-200 card-shadow p-4 flex items-start space-x-3">
            <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-lg shrink-0"><i class="fa-regular fa-calendar-check"></i></div>
            <div><h4 class="font-bold text-slate-900 text-xs">Flexible Validity</h4><p class="text-[11px] text-slate-500 mt-0.5">Choose from 1, 3, 6 or 12 month plans</p></div>
          </div>
        </div>
      </div>

      <!-- SECTION: Popular Subjects (real, derived from actual plans) -->
      <% const subjectCounts = {}; %>
      <% plans.forEach(p => { if (p.subject_name) subjectCounts[p.subject_name] = (subjectCounts[p.subject_name]||0)+1; }) %>
      <% const popularSubjects = Object.entries(subjectCounts); %>
      <% if (popularSubjects.length) { %>
      <div class="space-y-3 pt-2">
        <div class="flex items-center space-x-2">
          <i class="fa-solid fa-chart-column text-blue-600 text-sm"></i>
          <h2 class="text-lg font-extrabold text-slate-900">Popular Subjects</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <% popularSubjects.forEach(([name, count]) => { %>
            <div class="bg-white border border-slate-200 rounded-2xl p-4 flex items-center justify-between card-shadow">
              <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-lg shrink-0"><i class="fa-solid fa-book"></i></div>
                <div><h4 class="font-bold text-slate-900 text-xs"><%= name %></h4><p class="text-[11px] text-slate-500 font-medium"><%= count %> Plan<%= count===1?'':'s' %> Available</p></div>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
      <% } %>

    </div>
  </main>
</div>
<script>
function toggleSidebar(){
  document.getElementById('sidebar').classList.toggle('-translate-x-full');
  document.getElementById('sidebar-backdrop').classList.toggle('hidden');
}
</script>
</body>
</html>
