<%
// Shared Tailwind topbar for all "new design" admin pages. Pass `searchPlaceholder`
// to customize the search hint text; defaults to the common one.
const placeholder = typeof searchPlaceholder !== 'undefined' ? searchPlaceholder : 'Search students, subjects, exams, tutorials...';
%>
<header class="bg-white border-b border-slate-200 px-4 sm:px-6 py-3 flex items-center justify-between sticky top-0 z-30 shadow-sm">
  <div class="flex items-center space-x-3 flex-1 max-w-md">
    <button onclick="toggleSidebar()" class="lg:hidden p-2 text-slate-600 hover:bg-slate-100 rounded-lg focus:outline-none"><i class="fa-solid fa-bars text-lg"></i></button>
    <div class="flex items-center w-full bg-slate-100 rounded-xl px-3 py-2 border border-slate-200 focus-within:ring-2 focus-within:ring-blue-500 focus-within:bg-white transition">
      <i class="fa-solid fa-magnifying-glass text-slate-400 mr-2 text-xs"></i>
      <input type="text" placeholder="<%= placeholder %>" class="bg-transparent border-none text-xs sm:text-sm w-full outline-none text-slate-700 placeholder-slate-400">
    </div>
  </div>
  <div class="flex items-center space-x-2 sm:space-x-4">
    <details class="relative">
      <summary class="list-none relative p-2 text-slate-600 hover:bg-slate-100 rounded-full transition cursor-pointer" title="Notifications">
        <i class="fa-regular fa-bell text-base sm:text-lg"></i>
        <% if (typeof unreadNotifications !== 'undefined' && unreadNotifications > 0) { %>
        <span class="absolute top-1 right-1 bg-rose-500 text-white text-[9px] w-4 h-4 rounded-full flex items-center justify-center font-bold"><%= unreadNotifications %></span>
        <% } %>
      </summary>
      <div class="absolute right-0 mt-2 w-72 bg-white rounded-xl border border-slate-200 shadow-lg z-40 overflow-hidden">
        <div class="px-4 py-2.5 border-b border-slate-100 text-xs font-bold text-slate-700">Notifications</div>
        <% if (typeof recentNotifications !== 'undefined' && recentNotifications.length) { %>
          <% recentNotifications.forEach(n => { %>
          <a href="<%= n.link || '/notifications' %>" class="block px-4 py-2.5 border-b border-slate-50 hover:bg-slate-50 transition">
            <p class="text-xs font-semibold text-slate-800"><%= n.title %></p>
            <p class="text-[10px] text-slate-400 mt-0.5"><%= new Date(n.created_at).toLocaleString() %></p>
          </a>
          <% }) %>
        <% } else { %>
          <div class="px-4 py-4 text-xs text-slate-400 text-center">No notifications yet.</div>
        <% } %>
        <a href="/notifications" class="block px-4 py-2 text-center text-xs font-bold text-blue-600 hover:bg-slate-50 transition">View all &rarr;</a>
      </div>
    </details>
    <a href="/admin/email-logs" class="p-2 text-slate-600 hover:bg-slate-100 rounded-full transition hidden sm:block" title="Messages / Email Logs"><i class="fa-regular fa-comment-dots text-base sm:text-lg"></i></a>
    <div class="h-6 w-px bg-slate-200 hidden sm:block"></div>
    <details class="relative">
      <summary class="list-none flex items-center space-x-2.5 cursor-pointer pl-1">
        <% if (currentUser.profile_image) { %>
        <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-cover bg-center border-2 border-blue-500" style="background-image:url('<%= currentUser.profile_image %>')"></div>
        <% } else { %>
        <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-blue-600 text-white flex items-center justify-center font-bold text-sm border-2 border-blue-500"><%= (currentUser.name||'A').charAt(0).toUpperCase() %></div>
        <% } %>
        <div class="hidden md:block text-left">
          <h4 class="text-xs font-bold text-slate-800 leading-none"><%= currentUser.name %></h4>
          <span class="text-[10px] text-slate-500"><%= currentUser.role === 'admin' ? 'Admin' : 'Teacher' %></span>
        </div>
        <i class="fa-solid fa-chevron-down text-[10px] text-slate-400 hidden md:block"></i>
      </summary>
      <div class="absolute right-0 mt-2 w-44 bg-white rounded-xl border border-slate-200 shadow-lg z-40 overflow-hidden text-xs font-semibold">
        <a href="/admin/settings" class="block px-4 py-2.5 text-slate-700 hover:bg-slate-50 transition">👤 My Profile</a>
        <a href="/admin/settings" class="block px-4 py-2.5 text-slate-700 hover:bg-slate-50 transition">⚙ Settings</a>
        <a href="/logout" class="block px-4 py-2.5 text-rose-600 hover:bg-slate-50 transition">⇥ Logout</a>
      </div>
    </details>
  </div>
</header>
