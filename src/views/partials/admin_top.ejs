<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= title %> — AUS Academy</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900\&family=Poppins:wght@400;500;600;700;800;900\&family=Roboto:wght@400;500;600;700;800;900\&family=Nunito:wght@400;500;600;700;800;900\&family=Work+Sans:wght@400;500;600;700;800;900\&family=Manrope:wght@400;500;600;700;800;900\&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/admin-teacher-v10.css">
<style>
  :root { --primary: <%= themeColor %>; --primary-dark: <%= themeColor2 %>; }
  body { font-family: '<%= themeFont %>', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif !important; }
</style>
</head>
<body>
<div class="app-shell">
<aside class="sidebar" id="sidebar">
  <div class="brand">
    <% if (siteLogo) { %><img src="<%= siteLogo %>" alt="Logo" style="width:42px;height:42px;border-radius:12px;object-fit:cover;">
    <% } else { %><div class="brand-mark">AA</div><% } %>
    <div><div class="brand-name">AUS Academy</div><div class="brand-sub">Australia Year 11–12</div></div>
  </div>
  <div class="portal-tag">ADMIN / TEACHER PORTAL</div>
  <nav class="nav-scroll">
    <div class="nav-section">Overview</div>
    <a class="nav-link <%= active==='dashboard'?'active':'' %>" href="/admin/dashboard"><svg class="ico" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg><span>Dashboard</span></a>

    <div class="nav-section">Learning &amp; Content</div>
    <a class="nav-link <%= active==='students'?'active':'' %>" href="/admin/students"><svg class="ico" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg><span>Students</span></a>
    <a class="nav-link <%= active==='assign'?'active':'' %>" href="/admin/assign"><svg class="ico" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg><span>Assign Paper</span></a>
    <a class="nav-link <%= active==='subjects'?'active':'' %>" href="/admin/subjects"><svg class="ico" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/></svg><span>Subjects</span></a>
    <a class="nav-link <%= active==='tutorials'?'active':'' %>" href="/admin/tutorials"><svg class="ico" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="m10 8 6 4-6 4Z"/></svg><span>Tutorials</span></a>
    <a class="nav-link <%= active==='material'?'active':'' %>" href="/admin/material"><svg class="ico" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/><path d="M8 13h8M8 17h6"/></svg><span>Study Material</span></a>

    <div class="nav-section">Assessment</div>
    <a class="nav-link <%= active==='mcq-bank'?'active':'' %>" href="/admin/mcqs"><svg class="ico" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h11"/></svg><span>MCQ Question Bank</span></a>
    <a class="nav-link <%= active==='mcq-plans'?'active':'' %>" href="/admin/mcq-plans"><svg class="ico" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41 11 22l-9-9V2h11l8.59 8.59a2 2 0 0 1 0 2.82Z"/><circle cx="7" cy="7" r="1.5"/></svg><span>MCQ Plans</span></a>
    <a class="nav-link <%= active==='papers'?'active':'' %>" href="/admin/papers"><svg class="ico" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2h9l5 5v15H6z"/><path d="M15 2v6h5M9 13h6M9 17h6"/></svg><span>Full Exam Papers</span></a>
    <a class="nav-link <%= active==='submissions'?'active':'' %>" href="/admin/submissions"><svg class="ico" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v13H4z"/><path d="M4 13h4l2 3h4l2-3h4"/></svg><span>Submissions</span></a>
    <a class="nav-link <%= active==='question-issues'?'active':'' %>" href="/admin/question-issues"><svg class="ico" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><path d="M4 22V15"/></svg><span>Question Issues</span></a>
    <a class="nav-link <%= active==='results'?'active':'' %>" href="/admin/results"><svg class="ico" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19V5M10 19V9M16 19V3M22 19V7"/></svg><span>Results</span></a>

    <div class="nav-section">Sales &amp; Reporting</div>
    <a class="nav-link <%= active==='orders'?'active':'' %>" href="/admin/orders"><svg class="ico" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg><span>Orders &amp; Payments</span></a>
    <a class="nav-link <%= active==='reports'?'active':'' %>" href="/admin/reports"><svg class="ico" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m7 15 4-4 3 2 5-6"/></svg><span>Reports &amp; Analytics</span></a>
    <a class="nav-link <%= active==='audit'?'active':'' %>" href="/admin/audit-logs"><svg class="ico" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><span>Audit Log</span></a>
    <a class="nav-link <%= active==='webhooks'?'active':'' %>" href="/admin/webhook-logs"><svg class="ico" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2M12 12V3m0 0 4 4m-4-4-4 4"/></svg><span>Webhook Logs</span></a>
    <a class="nav-link <%= active==='email-logs'?'active':'' %>" href="/admin/email-logs"><svg class="ico" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v16H4z"/><path d="m4 6 8 7 8-7"/></svg><span>Email Logs</span></a>

    <div class="nav-section">Management</div>
    <% if (currentUser.role === 'admin') { %>
    <a class="nav-link <%= active==='teachers'?'active':'' %>" href="/admin/teachers"><svg class="ico" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7 12 3l9 4-9 4-9-4Z"/><path d="M6 10v5c3 2 9 2 12 0v-5"/><path d="M21 8v6"/></svg><span>Teachers</span></a>
    <% } %>
    <a class="nav-link <%= active==='settings'?'active':'' %>" href="/admin/settings"><svg class="ico" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.8 1.8 0 0 0 .36 2l.05.05-1.8 1.8-.05-.05a1.8 1.8 0 0 0-2-.36 1.8 1.8 0 0 0-1.1 1.66V20h-2.55v-.1A1.8 1.8 0 0 0 11.2 18a1.8 1.8 0 0 0-2 .36l-.05.05-1.8-1.8.05-.05a1.8 1.8 0 0 0 .36-2 1.8 1.8 0 0 0-1.66-1.1H6V10.9h.1a1.8 1.8 0 0 0 1.6-1.1 1.8 1.8 0 0 0-.36-2l-.05-.05 1.8-1.8.05.05a1.8 1.8 0 0 0 2 .36A1.8 1.8 0 0 0 12.2 4.7V4h2.55v.1a1.8 1.8 0 0 0 1.1 1.66 1.8 1.8 0 0 0 2-.36l.05-.05 1.8 1.8-.05.05a1.8 1.8 0 0 0-.36 2 1.8 1.8 0 0 0 1.66 1.1H21v2.55h-.1A1.8 1.8 0 0 0 19.4 15Z"/></svg><span>Settings</span></a>
    <a class="nav-link" href="/admin/help"><svg class="ico" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg><span>Help & Documentation</span></a>
    <a class="nav-link" href="/logout"><svg class="ico" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5"/><path d="M21 12H9"/></svg><span>Logout</span></a>
  </nav>
  <div class="sidebar-bottom"></div>
</aside>
<div class="sidebar-backdrop" id="backdrop"></div>

<div class="main-shell">
  <header class="topbar">
    <div class="top-left">
      <button class="menu-btn" id="menuBtn" aria-label="Open menu">☰</button>
      <div class="global-search"><span>⌕</span><input aria-label="Search" placeholder="Search students, subjects, papers, tutorials..."></div>
    </div>
    <div class="top-actions">
      <details class="topbar-dd">
        <summary class="icon-btn notify" aria-label="Notifications" style="list-style:none;cursor:pointer;display:grid;place-items:center;">
          <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
          <% if (unreadNotifications > 0) { %><i><%= unreadNotifications %></i><% } %>
        </summary>
        <div class="dd-panel">
          <div class="dd-head">Notifications</div>
          <% recentNotifications.forEach(n => { %>
            <a class="dd-item" href="<%= n.link || '/notifications' %>"><b><%= n.title %></b><small><%= new Date(n.created_at).toLocaleString() %></small></a>
          <% }) %>
          <% if (!recentNotifications.length) { %><div class="dd-item muted">No notifications yet.</div><% } %>
          <a class="dd-foot" href="/notifications">View all →</a>
        </div>
      </details>
      <details class="topbar-dd">
        <summary class="top-user" style="list-style:none;cursor:pointer;">
          <% if (currentUser.profile_image) { %><div class="avatar" style="background-image:url('<%= currentUser.profile_image %>');background-size:cover;"></div>
          <% } else { %><div class="avatar"><%= currentUser.name.split(' ').map(w=>w[0]).slice(0,2).join('').toUpperCase() %></div><% } %>
          <div><b><%= currentUser.name %></b><small><%= currentUser.role === 'admin' ? 'Admin' : 'Teacher' %></small></div>
          <span class="chev">⌄</span>
        </summary>
        <div class="dd-panel" style="right:0;left:auto;">
          <a class="dd-item" href="/admin/settings">👤 My Profile</a>
          <a class="dd-item" href="/admin/settings">⚙ Settings</a>
          <a class="dd-item" href="/logout" style="color:#c23838;">⇥ Logout</a>
        </div>
      </details>
    </div>
  </header>
  <div class="page-wrap">
    <% if (success && success.length) { %><div class="notice good" style="margin-bottom:14px;">✔ <%= success[0] %></div><% } %>
    <% if (error && error.length) { %><div class="notice warn" style="margin-bottom:14px;">⚠ <%= error[0] %></div><% } %>
