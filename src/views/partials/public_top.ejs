<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %> | AUS Academy</title>
<link rel="stylesheet" href="/assets/styles.css">
<link rel="stylesheet" href="/assets/components.css">
</head>
<body>
<header class="public-header">
  <div class="inner">
    <a class="public-brand" href="/">
      <% if (typeof siteLogo !== 'undefined' && siteLogo) { %>
        <img src="<%= siteLogo %>" alt="Logo" style="width:38px;height:38px;border-radius:10px;object-fit:cover;">
      <% } else { %><span class="brand-mark">A</span><% } %>
      <div>AUS Academy<span>Australia Year 11–12</span></div>
    </a>
    <nav class="home-nav">
      <a href="/papers">Practice Papers</a>
    </nav>
    <div class="actions">
      <% if (currentUser) { %>
        <a class="btn btn-outline" href="/student/dashboard">Student Portal</a>
        <a class="btn btn-primary" href="/logout">Logout</a>
      <% } else { %>
        <a class="btn btn-outline" href="/login">Login</a>
        <a class="btn btn-primary" href="/register">Student Signup</a>
      <% } %>
    </div>
  </div>
</header>
<% if (success && success.length) { %><div class="public-section" style="padding-bottom:0;"><div class="alert" style="background:#e9fbf4;color:#08784f;">✔ <%= success[0] %></div></div><% } %>
<% if (error && error.length) { %><div class="public-section" style="padding-bottom:0;"><div class="alert">⚠ <%= error[0] %></div></div><% } %>
