                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-bold px-4 py-2.5 rounded-xl transition shadow-md">Save Changes</button>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div><label class="block font-semibold text-slate-700 mb-1">Brand Name</label><input type="text" name="brand_name" value="<%= loginTextForm.brand_name %>" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5 font-medium"></div>
                <div><label class="block font-semibold text-slate-700 mb-1">Brand Tagline</label><input type="text" name="brand_tagline" value="<%= loginTextForm.brand_tagline %>" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5 font-medium"></div>
                <div><label class="block font-semibold text-slate-700 mb-1">Student Hero Title</label><input type="text" name="login_student_hero_title" value="<%= loginTextForm.login_student_hero_title %>" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5 font-medium"></div>
                <div><label class="block font-semibold text-slate-700 mb-1">Staff Hero Title</label><input type="text" name="login_staff_hero_title" value="<%= loginTextForm.login_staff_hero_title %>" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5 font-medium"></div>
              </div>
              <p class="text-slate-400 text-[11px]">More login copy fields (bullets, subtitles) can be edited directly in Help &amp; Documentation's reference, or ask for the full list to be added here.</p>
            </form>
          </div>

          <!-- ROLES: Overview -->
          <div class="settings-panel" data-cat="roles" data-sub="roles_mgmt">
            <div class="space-y-6">
              <div class="border-b border-slate-100 pb-4"><h3 class="font-bold text-base text-[#091e42]">Roles Overview</h3><p class="text-slate-500 mt-0.5">AUS Academy uses two portal roles — Admin/Teacher (staff) and Student. There is no multi-tier role system to configure; this table just shows current headcounts.</p></div>
              <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                  <thead><tr class="bg-slate-50 border-b border-slate-200 text-slate-600 font-bold uppercase text-[11px]"><th class="p-3">Role</th><th class="p-3">Description</th><th class="p-3">Users</th><th class="p-3">Status</th></tr></thead>
                  <tbody class="divide-y divide-slate-100 font-medium text-slate-700">
                    <tr><td class="p-3 font-bold">Admin</td><td class="p-3 text-slate-500">Full portal access, manages teachers</td><td class="p-3"><%= adminCount %></td><td class="p-3"><span class="bg-emerald-50 text-emerald-700 px-2 py-0.5 rounded-full font-bold text-[10px]">Active</span></td></tr>
                    <tr><td class="p-3 font-bold">Teacher</td><td class="p-3 text-slate-500">Manages content, assignments &amp; grading</td><td class="p-3"><%= teacherCount %></td><td class="p-3"><span class="bg-emerald-50 text-emerald-700 px-2 py-0.5 rounded-full font-bold text-[10px]">Active</span></td></tr>
                    <tr><td class="p-3 font-bold">Student</td><td class="p-3 text-slate-500">Purchases plans, takes exams</td><td class="p-3"><%= studentCount %></td><td class="p-3"><span class="bg-emerald-50 text-emerald-700 px-2 py-0.5 rounded-full font-bold text-[10px]">Active</span></td></tr>
                  </tbody>
                </table>
              </div>
              <% if (currentUser.role === 'admin') { %><a href="/admin/teachers" class="inline-block bg-blue-600 text-white font-bold px-4 py-2.5 rounded-xl">Manage Teacher Accounts &rarr;</a><% } %>
            </div>
          </div>

          <!-- SECURITY: Password & Login policy -->
          <div class="settings-panel" data-cat="security" data-sub="password_login">
            <form method="post" action="/admin/settings/kv" class="space-y-6">
              <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                <div><h3 class="font-bold text-base text-[#091e42]">Password &amp; Login Policy</h3><p class="text-slate-500 mt-0.5">Guidance shown to users when they set a password.</p></div>
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-bold px-4 py-2.5 rounded-xl transition shadow-md">Save Changes</button>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block font-semibold text-slate-700 mb-1">Minimum Password Length</label>
                  <select name="password_min_length" class="custom-select w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5 font-medium">
                    <% [6,8,10,12].forEach(function(n){ %><option value="<%= n %>" <%= extra.password_min_length==String(n)?'selected':'' %>><%= n %> characters</option><% }); %>
                  </select>
                </div>
                <div><label class="block font-semibold text-slate-700 mb-1">Password Expiry (Days, 0 = never)</label><input type="number" name="password_expiry_days" value="<%= extra.password_expiry_days %>" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5 font-medium"></div>
              </div>
              <div class="flex items-center justify-between bg-slate-50 p-4 rounded-xl border border-slate-100">
                <div><h4 class="font-bold text-slate-900">Require Special Characters</h4><p class="text-slate-500 text-[11px]">Symbols like !@#$%^&amp;*</p></div>
                <input type="hidden" name="require_special_chars" value="0"><input type="checkbox" name="require_special_chars" value="1" <%= extra.require_special_chars==='1'?'checked':'' %> class="w-5 h-5 rounded text-blue-600">
              </div>
            </form>
          </div>

          <!-- SECURITY: Two-Factor (real — reuses existing OTP settings) -->
          <div class="settings-panel" data-cat="security" data-sub="two_factor">
            <%
              const provLabels = { twilio: 'Twilio (SMS)', twilio_whatsapp: 'Twilio (WhatsApp)', msg91: 'MSG91 (SMS)', whatsapp_business: 'WhatsApp Business API (Meta)' };
              const fieldLabels = {
                twilio_account_sid: 'Account SID', twilio_auth_token: 'Auth Token', twilio_from_number: 'From Number (e.g. +1xxxxxxxxxx)',
                twilio_whatsapp_from: 'WhatsApp From (e.g. whatsapp:+14155238886)',
                msg91_auth_key: 'Auth Key', msg91_sender_id: 'Sender ID',
                meta_whatsapp_token: 'Access Token', meta_whatsapp_phone_id: 'Phone Number ID', meta_whatsapp_template_name: 'Template Name (default: otp_code)',
              };
            %>
            <form method="post" action="/admin/settings/otp" class="space-y-6">
              <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                <div><h3 class="font-bold text-base text-[#091e42]">Two-Factor Authentication (Email + SMS OTP)</h3><p class="text-slate-500 mt-0.5">Email OTP is always required at login. SMS/WhatsApp OTP is optional.</p></div>
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-bold px-4 py-2.5 rounded-xl transition shadow-md">Save Changes</button>
              </div>
              <div class="flex items-center justify-between bg-slate-50 p-4 rounded-xl border border-slate-100">
                <div><h4 class="font-bold text-slate-900">Enable SMS/WhatsApp OTP</h4><p class="text-slate-500 text-[11px]">In addition to the always-on email OTP</p></div>
                <input type="checkbox" name="sms_otp_enabled" <%= otpStatus.smsEnabled ? 'checked' : '' %> class="w-5 h-5 rounded text-blue-600">
              </div>
              <div>
                <label class="block font-semibold text-slate-700 mb-1">Preferred SMS/WhatsApp Provider</label>
                <select name="sms_provider_choice" id="smsProviderSelect" onchange="showSmsProviderFields(this.value)" class="custom-select w-full sm:w-1/2 bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5 font-medium">
                  <option value="not_decided" <%= otpStatus.providerChoice==='not_decided'?'selected':'' %>>Not decided yet</option>
                  <% Object.keys(provLabels).forEach(p => { %>
                  <option value="<%= p %>" <%= otpStatus.providerChoice===p?'selected':'' %>><%= provLabels[p] %></option>
                  <% }) %>
                </select>
              </div>

              <!-- Credentials: enter directly here — saved to the database, no server/.env access needed.
                   Only the fields for the currently-selected provider above are shown. -->
              <% Object.keys(otpStatus.fields).forEach(provider => { %>
              <div id="smsFields_<%= provider %>" class="sms-provider-fields space-y-3 bg-slate-50 border border-slate-200 rounded-xl p-4 <%= otpStatus.providerChoice === provider ? '' : 'hidden' %>">
                <h4 class="font-bold text-xs text-slate-700 uppercase tracking-wide"><%= provLabels[provider] %> Credentials</h4>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  <% otpStatus.fields[provider].forEach(key => { const fs = otpStatus.fieldStatus[provider][key]; %>
                  <div>
                    <label class="block font-semibold text-slate-700 mb-1 text-xs"><%= fieldLabels[key] %><% if (fs.secret && fs.set) { %> <span class="text-emerald-600 font-normal">(ending •••<%= fs.last4 %>)</span><% } %></label>
                    <% if (fs.secret) { %>
                    <input type="password" name="<%= key %>" placeholder="<%= fs.set ? 'Leave blank to keep current' : 'Not set' %>" class="form-input text-xs" autocomplete="off">
                    <% } else { %>
                    <input type="text" name="<%= key %>" value="<%= fs.value %>" placeholder="<%= fieldLabels[key] %>" class="form-input text-xs">
                    <% } %>
                  </div>
                  <% }) %>
                </div>
              </div>
              <% }) %>

              <div class="flex items-center gap-2 text-[11px] font-semibold">
                <span class="px-2 py-1 rounded-full <%= otpStatus.providerConfigured ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700' %>">
                  <%= otpStatus.providerConfigured ? ('Connected — credentials from ' + (otpStatus.source === 'settings' ? 'Settings' : '.env')) : 'Demo mode — codes appear in SMS Logs only' %>
                </span>
              </div>
              <p class="text-slate-400 text-[11px]">You can also set these via .env on the server instead (SMS_PROVIDER + matching keys) — Settings here takes priority if both are filled in. See Help &amp; Documentation for details on each provider.</p>
            </form>

            <% if (otpStatus.providerChoice !== 'not_decided') { %>
            <form method="post" action="/admin/settings/sms-test" class="mt-4 pt-4 border-t border-slate-100 flex flex-wrap items-end gap-3">
              <div class="flex-1 min-w-[200px]">
                <label class="block font-semibold text-slate-700 mb-1 text-xs">Send a Test Message</label>
                <input type="tel" name="test_phone" placeholder="+91XXXXXXXXXX" required class="form-input text-xs">
              </div>
              <button type="submit" class="bg-white hover:bg-slate-50 text-slate-700 border border-slate-300 font-bold px-4 py-2.5 rounded-xl transition shadow-xs text-xs flex items-center space-x-1.5" <%= !otpStatus.providerConfigured ? 'disabled title="Fill in and save credentials first"' : '' %>>
                <i class="fa-solid fa-paper-plane text-xs"></i><span>Send Test</span>
              </button>
            </form>
            <% } %>
          </div>

          <!-- SECURITY: Session Management -->
          <div class="settings-panel" data-cat="security" data-sub="session_mgmt">
            <form method="post" action="/admin/settings/kv" class="space-y-6">
              <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                <div><h3 class="font-bold text-base text-[#091e42]">Session Management</h3><p class="text-slate-500 mt-0.5">Auto-logout after inactivity.</p></div>
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-bold px-4 py-2.5 rounded-xl transition shadow-md">Save Changes</button>
              </div>
              <div>
                <label class="block font-semibold text-slate-700 mb-1">Auto logout after inactivity (minutes)</label>
                <select name="session_timeout_minutes" class="custom-select w-full sm:w-1/2 bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5 font-medium">
                  <% [30,60,120,240].forEach(function(m){ %><option value="<%= m %>" <%= extra.session_timeout_minutes==String(m)?'selected':'' %>><%= m>=60 ? (m/60)+' hour'+(m>60?'s':'') : m+' minutes' %></option><% }); %>
                </select>
              </div>
            </form>
          </div>

          <!-- SECURITY: My Password -->
          <div class="settings-panel" data-cat="security" data-sub="my_password">
            <form method="post" action="/admin/settings/password" class="space-y-6">
              <div class="border-b border-slate-100 pb-4"><h3 class="font-bold text-base text-[#091e42]">Change My Password</h3><p class="text-slate-500 mt-0.5">Update the password you use to log in.</p></div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div><label class="block font-semibold text-slate-700 mb-1">Current Password</label><input type="password" name="current_password" required class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5 font-medium"></div>
                <div><label class="block font-semibold text-slate-700 mb-1">New Password</label><input type="password" name="new_password" required minlength="6" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5 font-medium"></div>
              </div>
              <button type="submit" class="bg-slate-800 hover:bg-slate-900 text-white font-bold px-6 py-2.5 rounded-xl transition">Change Password</button>
            </form>
          </div>

        </div>
      </div>

      <footer class="pt-6 pb-4 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 font-medium">
        <p>&copy; <%= new Date().getFullYear() %> AUS Academy. All rights reserved.</p>
      </footer>
    </div>
  </main>
</div>
<%- include('../partials/tw_scripts') %>
<script>
const firstSub = { general:'profile', email:'email_settings', payments:'gateways', appearance:'branding', roles:'roles_mgmt', security:'password_login' };
function showSmsProviderFields(provider) {
  document.querySelectorAll('.sms-provider-fields').forEach((el) => {
    el.classList.toggle('hidden', el.id !== 'smsFields_' + provider);
  });
}
function switchCategory(cat){
  ['general','email','payments','appearance','roles','security'].forEach(function(c){
    document.getElementById('pill-'+c).classList.toggle('active', c===cat);
    var menu = document.querySelector('.cat-menu[data-cat="'+c+'"]');
    if (menu) menu.classList.toggle('hidden', c!==cat);
  });
  switchSub(cat, firstSub[cat]);
}
function switchSub(cat, sub){
  document.querySelectorAll('.cat-menu[data-cat="'+cat+'"] .submenu-link').forEach(function(a, i){
    a.classList.toggle('active', a.getAttribute('onclick').indexOf("'"+sub+"'")>-1);
  });
  document.querySelectorAll('.settings-panel').forEach(function(p){
    p.classList.toggle('active', p.dataset.cat===cat && p.dataset.sub===sub);
  });
}
</script>
</body>
</html>
