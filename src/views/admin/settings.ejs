              </div>
              <div class="space-y-3">
                <% templateStates.forEach(function(t){ %>
                <div class="flex items-center justify-between bg-slate-50 p-4 rounded-xl border border-slate-200">
                  <div><h4 class="font-bold text-slate-900"><%= t.label %></h4><p class="text-[11px] text-slate-500">Automated email sent for this event</p></div>
                  <input type="checkbox" name="enabled_<%= t.key %>" <%= t.enabled ? 'checked' : '' %> class="w-5 h-5 rounded text-blue-600">
                </div>
                <% }); %>
              </div>
            </form>
          </div>

          <!-- EMAIL: Notification Triggers -->
          <div class="settings-panel" data-cat="email" data-sub="notification_triggers">
            <form method="post" action="/admin/settings/kv" class="space-y-6">
              <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                <div><h3 class="font-bold text-base text-[#091e42]">Notification Triggers</h3><p class="text-slate-500 mt-0.5">Choose which events fire a notification email.</p></div>
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-bold px-4 py-2.5 rounded-xl transition shadow-md">Save Changes</button>
              </div>
              <div class="space-y-3">
                <div class="flex items-center justify-between bg-slate-50 p-4 rounded-xl border border-slate-100">
                  <span class="font-bold text-slate-900">Notify on Student Submission</span>
                  <input type="hidden" name="notify_on_submission" value="0"><input type="checkbox" name="notify_on_submission" value="1" <%= extra.notify_on_submission==='1'?'checked':'' %> class="w-5 h-5 rounded text-blue-600">
                </div>
                <div class="flex items-center justify-between bg-slate-50 p-4 rounded-xl border border-slate-100">
                  <span class="font-bold text-slate-900">Notify on Result Published</span>
                  <input type="hidden" name="notify_on_grade_published" value="0"><input type="checkbox" name="notify_on_grade_published" value="1" <%= extra.notify_on_grade_published==='1'?'checked':'' %> class="w-5 h-5 rounded text-blue-600">
                </div>
              </div>
            </form>
          </div>

          <!-- EMAIL: SMTP status (read-only, real) -->
          <div class="settings-panel" data-cat="email" data-sub="smtp_config">
            <div class="space-y-6">
              <div class="border-b border-slate-100 pb-4"><h3 class="font-bold text-base text-[#091e42]">SMTP Configuration</h3><p class="text-slate-500 mt-0.5">Live status from your server's environment variables.</p></div>
              <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-3">
                <div class="flex justify-between items-center"><span class="font-bold">Status</span><span class="<%= smtpStatus.configured ? 'text-emerald-600' : 'text-amber-600' %> font-bold"><%= smtpStatus.configured ? 'Connected' : 'Not configured — using demo mode (emails logged to Email Logs)' %></span></div>
                <div class="flex justify-between items-center"><span class="font-bold">From Email</span><span class="text-slate-600"><%= smtpStatus.fromEmail %></span></div>
              </div>
              <p class="text-slate-400 text-[11px]">To connect a real SMTP provider, set <code>SMTP_HOST</code>, <code>SMTP_USER</code>, <code>SMTP_PASS</code> in <code>.env</code> and restart — see Help &amp; Documentation.</p>
            </div>
          </div>

          <!-- PAYMENTS: Gateways (real Stripe) -->
          <div class="settings-panel" data-cat="payments" data-sub="gateways">
            <form method="post" action="/admin/settings/stripe" class="space-y-6">
              <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                <div><h3 class="font-bold text-base text-[#091e42]">Payment Gateway — Stripe</h3><p class="text-slate-500 mt-0.5">Configure real Stripe keys, or leave blank to keep demo mode (plans activate instantly).</p></div>
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-bold px-4 py-2.5 rounded-xl transition shadow-md">Save Changes</button>
              </div>
              <div class="flex items-center justify-between bg-slate-50 p-4 rounded-xl border border-slate-200">
                <div class="flex items-center space-x-3">
                  <div class="w-10 h-10 rounded-lg bg-purple-100 text-purple-700 flex items-center justify-center font-bold text-base"><i class="fa-brands fa-stripe"></i></div>
                  <div><h4 class="font-bold text-slate-900">Stripe</h4><p class="text-[11px] text-slate-500">Mode: <%= paymentStatus.stripeMode %></p></div>
                </div>
                <span class="<%= paymentStatus.stripeConfigured ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : 'bg-amber-50 text-amber-700 border-amber-200' %> border px-2.5 py-1 rounded-full font-bold text-[10px]"><%= paymentStatus.stripeConfigured ? 'Configured' : 'Demo mode' %></span>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div><label class="block font-semibold text-slate-700 mb-1">Publishable Key</label><input type="text" name="stripe_publishable_key" value="<%= stripeKeys.publishableKey %>" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5 font-mono text-[11px]"></div>
                <div><label class="block font-semibold text-slate-700 mb-1">Secret Key <%= stripeKeys.secretKeySet ? '(ending •••'+stripeKeys.secretKeyMasked+')' : '' %></label><input type="password" name="stripe_secret_key" placeholder="<%= stripeKeys.secretKeySet ? 'Leave blank to keep current key' : 'sk_test_...' %>" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5 font-mono text-[11px]"></div>
                <div class="sm:col-span-2"><label class="block font-semibold text-slate-700 mb-1">Webhook Secret <%= stripeKeys.webhookSecretSet ? '(set)' : '(not set)' %></label><input type="password" name="stripe_webhook_secret" placeholder="Leave blank to keep current" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5 font-mono text-[11px]"></div>
              </div>
            </form>
          </div>

          <!-- PAYMENTS: Webhook & API -->
          <div class="settings-panel" data-cat="payments" data-sub="webhook">
            <div class="space-y-6">
              <div class="border-b border-slate-100 pb-4"><h3 class="font-bold text-base text-[#091e42]">Webhook &amp; API</h3><p class="text-slate-500 mt-0.5">Your Stripe webhook endpoint.</p></div>
              <div><label class="block font-semibold text-slate-700 mb-1">Stripe Webhook URL</label><input type="text" readonly value="<%= stripeKeys.webhookUrl %>" class="w-full bg-slate-100 border border-slate-200 rounded-lg px-3 py-2.5 font-mono text-[11px]"></div>
              <div><label class="block font-semibold text-slate-700 mb-1">WooCommerce Webhook Secret</label><input type="text" readonly value="<%= paymentStatus.webhookSecretConfigured ? 'Configured (see .env WOO_WEBHOOK_SECRET)' : 'Not set' %>" class="w-full bg-slate-100 border border-slate-200 rounded-lg px-3 py-2.5 font-medium"></div>
            </div>
          </div>

          <!-- PAYMENTS: WooCommerce -->
          <div class="settings-panel" data-cat="payments" data-sub="woocommerce">
            <div class="space-y-6">
              <div class="border-b border-slate-100 pb-4"><h3 class="font-bold text-base text-[#091e42]">WooCommerce Integration</h3><p class="text-slate-500 mt-0.5">Orders arrive automatically via the webhook bridge plugin, or can be pulled on demand with "Sync Now" on the Orders &amp; Payments page.</p></div>
              <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-3">
                <div class="flex justify-between items-center"><span class="font-bold">Website</span><span class="text-blue-600"><%= general.website_url %></span></div>
                <div class="flex justify-between items-center"><span class="font-bold">Webhook Endpoint</span><span class="font-mono text-[11px]">/api/woo/order-complete</span></div>
              </div>
              <p class="text-slate-400 text-[11px]">Setup steps are in <code>wordpress-integration/aus-academy-woo-bridge.php</code> and Help &amp; Documentation.</p>
            </div>

            <form method="post" action="/admin/settings/woocommerce" class="space-y-6 mt-8 pt-6 border-t border-slate-100">
              <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                <div><h3 class="font-bold text-base text-[#091e42]">WooCommerce API Connection</h3><p class="text-slate-500 mt-0.5">Required for the real "Sync Now" REST API pull (Settings &rarr; <code>GET /wp-json/wc/v3/orders</code>).</p></div>
                <span class="<%= wooSettings.configured ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : 'bg-amber-50 text-amber-700 border-amber-200' %> border px-2.5 py-1 rounded-full font-bold text-[10px]"><%= wooSettings.configured ? 'Configured' : 'Not configured' %></span>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="sm:col-span-2"><label class="block font-semibold text-slate-700 mb-1">Store URL</label><input type="text" name="woo_store_url" value="<%= wooSettings.storeUrl %>" placeholder="https://www.yourstore.com" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5 font-mono text-[11px]"></div>
                <div><label class="block font-semibold text-slate-700 mb-1">Consumer Key <%= wooSettings.consumerKeySet ? '(ending •••'+wooSettings.consumerKeyMasked+')' : '' %></label><input type="password" name="woo_consumer_key" placeholder="<%= wooSettings.consumerKeySet ? 'Leave blank to keep current key' : 'ck_...' %>" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5 font-mono text-[11px]"></div>
                <div><label class="block font-semibold text-slate-700 mb-1">Consumer Secret <%= wooSettings.consumerSecretSet ? '(set)' : '(not set)' %></label><input type="password" name="woo_consumer_secret" placeholder="<%= wooSettings.consumerSecretSet ? 'Leave blank to keep current' : 'cs_...' %>" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5 font-mono text-[11px]"></div>
              </div>
              <p class="text-slate-400 text-[11px]">Generate these under WooCommerce &rarr; Settings &rarr; Advanced &rarr; REST API on your WordPress store (Read permission is enough for Sync Now).</p>
              <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-bold px-4 py-2.5 rounded-xl transition shadow-md">Save API Connection</button>
            </form>
          </div>

          <!-- PAYMENTS: Currency & Tax -->
          <div class="settings-panel" data-cat="payments" data-sub="currency">
            <form method="post" action="/admin/settings/kv" class="space-y-6">
              <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                <div><h3 class="font-bold text-base text-[#091e42]">Currency &amp; Tax</h3><p class="text-slate-500 mt-0.5">Set your storefront currency and GST rate.</p></div>
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-bold px-4 py-2.5 rounded-xl transition shadow-md">Save Changes</button>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div><label class="block font-semibold text-slate-700 mb-1">Currency</label><input type="text" name="currency" value="<%= extra.currency %>" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5 font-medium"></div>
                <div><label class="block font-semibold text-slate-700 mb-1">GST Rate (%)</label><input type="number" step="0.1" name="gst_rate" value="<%= extra.gst_rate %>" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5 font-medium"></div>
                <div><label class="block font-semibold text-slate-700 mb-1">Order ID Prefix</label><input type="text" name="order_prefix" value="<%= extra.order_prefix %>" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5 font-medium"></div>
              </div>
            </form>
          </div>

          <!-- PAYMENTS: Invoice -->
          <div class="settings-panel" data-cat="payments" data-sub="invoice">
            <form method="post" action="/admin/settings/kv" class="space-y-6">
              <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                <div><h3 class="font-bold text-base text-[#091e42]">Invoice Settings</h3><p class="text-slate-500 mt-0.5">Notes shown on generated invoices/receipts.</p></div>
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-bold px-4 py-2.5 rounded-xl transition shadow-md">Save Changes</button>
              </div>
              <div><label class="block font-semibold text-slate-700 mb-1">Invoice Notes</label><textarea name="invoice_notes" rows="2" class="w-full bg-slate-50 border border-slate-200 rounded-lg p-3 font-medium"><%= extra.invoice_notes %></textarea></div>
              <div class="flex items-center justify-between bg-slate-50 p-4 rounded-xl border border-slate-100">
                <span class="font-bold text-slate-900">Email me on failed payments</span>
                <input type="hidden" name="payment_notify_on_failed" value="0"><input type="checkbox" name="payment_notify_on_failed" value="1" <%= extra.payment_notify_on_failed==='1'?'checked':'' %> class="w-5 h-5 rounded text-blue-600">
              </div>
            </form>
          </div>

          <!-- APPEARANCE: Branding -->
          <div class="settings-panel" data-cat="appearance" data-sub="branding">
            <form method="post" action="/admin/settings/general" class="space-y-6">
              <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                <div><h3 class="font-bold text-base text-[#091e42]">Branding Settings</h3><p class="text-slate-500 mt-0.5">Portal name and description shown across the site.</p></div>
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-bold px-4 py-2.5 rounded-xl transition shadow-md">Save Changes</button>
              </div>
              <input type="hidden" name="contact_email" value="<%= general.contact_email %>">
              <input type="hidden" name="website_url" value="<%= general.website_url %>">
              <input type="hidden" name="timezone" value="<%= general.timezone %>">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div><label class="block font-semibold text-slate-700 mb-1">Portal Name</label><input type="text" name="platform_name" value="<%= general.platform_name %>" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5 font-medium"></div>
                <div><label class="block font-semibold text-slate-700 mb-1">Contact Email</label><input type="email" name="contact_email2" value="<%= general.contact_email %>" onchange="this.form.contact_email.value=this.value" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5 font-medium"></div>
                <div class="sm:col-span-2"><label class="block font-semibold text-slate-700 mb-1">Portal Description / Tagline</label><textarea name="portal_description" rows="2" class="w-full bg-slate-50 border border-slate-200 rounded-lg p-3 font-medium"><%= general.portal_description %></textarea></div>
              </div>
            </form>
          </div>

          <!-- APPEARANCE: Colors & Font (kept exactly as the existing working feature) -->
          <div class="settings-panel" data-cat="appearance" data-sub="colors">
            <form method="post" action="/admin/settings/theme" class="space-y-6">
              <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                <div><h3 class="font-bold text-base text-[#091e42]">Colors &amp; Font</h3><p class="text-slate-500 mt-0.5">Applies instantly across Admin, Teacher and Student portals.</p></div>
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-bold px-4 py-2.5 rounded-xl transition shadow-md">Save Changes</button>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block font-semibold text-slate-700 mb-1">Primary Color</label>
                  <div class="flex items-center space-x-3">
                    <input type="color" name="primary_color" value="<%= currentColor %>" class="w-12 h-10 rounded-lg border border-slate-200 cursor-pointer">
                    <input type="text" value="<%= currentColor %>" onchange="this.previousElementSibling.value=this.value" oninput="this.previousElementSibling.value=this.value" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5 font-mono">
                  </div>
                </div>
                <div>
                  <label class="block font-semibold text-slate-700 mb-1">Font Family</label>
                  <select name="font_family" class="custom-select w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5 font-medium">
                    <% ['Inter','Poppins','Roboto','Nunito','Work Sans','Manrope'].forEach(function(f){ %>
                    <option value="<%= f %>" <%= currentFont===f?'selected':'' %>><%= f %></option>
                    <% }); %>
                  </select>
                </div>
              </div>
            </form>
          </div>

          <!-- APPEARANCE: Logo & Homepage Image -->
          <div class="settings-panel" data-cat="appearance" data-sub="logo_favicon">
            <div class="space-y-8">
              <form method="post" action="/admin/settings/logo" enctype="multipart/form-data" class="space-y-4">
                <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                  <div><h3 class="font-bold text-base text-[#091e42]">Logo</h3><p class="text-slate-500 mt-0.5">Shown in the sidebar across all portals.</p></div>
                  <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-bold px-4 py-2 rounded-xl transition shadow-md">Upload</button>
                </div>
                <% if (logoUrl) { %><img src="<%= logoUrl %>" class="w-16 h-16 rounded-xl object-cover border border-slate-200"><% } %>
                <input type="file" name="logo" accept="image/*" class="block w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-blue-700">
              </form>
              <form method="post" action="/admin/settings/hero-image" enctype="multipart/form-data" class="space-y-4 pt-6 border-t border-slate-100">
                <div class="flex items-center justify-between">
                  <div><h3 class="font-bold text-base text-[#091e42]">Homepage / Login Image</h3><p class="text-slate-500 mt-0.5">Background image on the public homepage &amp; login screen.</p></div>
                  <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-bold px-4 py-2 rounded-xl transition shadow-md">Upload</button>
                </div>
                <% if (heroImageUrl) { %><img src="<%= heroImageUrl %>" class="w-full max-w-xs h-24 rounded-xl object-cover border border-slate-200"><% } %>
                <input type="file" name="hero_image" accept="image/*" class="block w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-blue-700">
              </form>
            </div>
          </div>

          <!-- APPEARANCE: Login Page Text -->
          <div class="settings-panel" data-cat="appearance" data-sub="login_page">
            <form method="post" action="/admin/settings/login-text" class="space-y-6">
              <div class="flex items-center justify-between border-b border-slate-100 pb-4">
