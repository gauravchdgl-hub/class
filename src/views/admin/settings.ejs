<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Settings — AUS Academy</title>
<link rel="stylesheet" href="/assets/tailwind.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<%- include('../partials/tw_head_styles') %>
</head>
<body class="bg-[#f4f6fa] text-slate-800 antialiased min-h-screen flex flex-col overflow-x-hidden">
<div class="flex flex-1 min-h-screen relative">
  <%- include('../partials/tw_sidebar', { active: 'settings' }) %>

  <main class="flex-1 flex flex-col min-w-0 overflow-y-auto bg-slate-50 min-h-screen relative">
    <%- include('../partials/tw_header', { searchPlaceholder: 'Search settings...' }) %>

    <% if (success && success.length) { %>
    <div class="mx-4 sm:mx-6 lg:mx-8 mt-4 bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-semibold px-4 py-3 rounded-xl"><%= success[0] %></div>
    <% } %>
    <% if (error && error.length) { %>
    <div class="mx-4 sm:mx-6 lg:mx-8 mt-4 bg-rose-50 border border-rose-200 text-rose-800 text-xs font-semibold px-4 py-3 rounded-xl"><%= error[0] %></div>
    <% } %>

    <div class="p-4 sm:p-6 lg:p-8 max-w-[1700px] mx-auto w-full space-y-6">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="flex items-start space-x-4">
          <div class="w-10 h-10 rounded-xl bg-blue-600 text-white flex items-center justify-center shrink-0 mt-0.5 shadow-md shadow-blue-600/30"><i class="fa-solid fa-gear text-lg"></i></div>
          <div><h1 class="text-2xl sm:text-[28px] font-bold text-[#091e42] tracking-tight">Settings</h1><p class="text-[13px] text-slate-500 mt-0.5">Manage your portal preferences, integrations and system settings.</p></div>
        </div>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-6 gap-2 bg-white p-2 rounded-xl border border-slate-200 shadow-sm text-xs font-semibold">
        <button onclick="switchCategory('general')" id="pill-general" class="pill active py-3 rounded-lg transition flex items-center justify-center space-x-2 text-slate-600"><i class="fa-solid fa-sliders"></i><span>General</span></button>
        <button onclick="switchCategory('email')" id="pill-email" class="pill py-3 rounded-lg transition flex items-center justify-center space-x-2 text-slate-600 hover:bg-slate-100"><i class="fa-solid fa-envelope"></i><span>Email</span></button>
        <button onclick="switchCategory('payments')" id="pill-payments" class="pill py-3 rounded-lg transition flex items-center justify-center space-x-2 text-slate-600 hover:bg-slate-100"><i class="fa-solid fa-credit-card"></i><span>Payments</span></button>
        <button onclick="switchCategory('appearance')" id="pill-appearance" class="pill py-3 rounded-lg transition flex items-center justify-center space-x-2 text-slate-600 hover:bg-slate-100"><i class="fa-solid fa-palette"></i><span>Appearance</span></button>
        <button onclick="switchCategory('roles')" id="pill-roles" class="pill py-3 rounded-lg transition flex items-center justify-center space-x-2 text-slate-600 hover:bg-slate-100"><i class="fa-solid fa-user-shield"></i><span>User Roles</span></button>
        <button onclick="switchCategory('security')" id="pill-security" class="pill py-3 rounded-lg transition flex items-center justify-center space-x-2 text-slate-600 hover:bg-slate-100"><i class="fa-solid fa-lock"></i><span>Security</span></button>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        <!-- LEFT SUB-NAV -->
        <div class="lg:col-span-3 bg-white rounded-xl border border-slate-200 p-2 shadow-sm space-y-1">
          <div class="cat-menu" data-cat="general">
            <a href="#" onclick="switchSub('general','profile');return false;" class="submenu-link active flex items-center space-x-3 px-3 py-2.5 rounded-lg text-xs font-semibold text-slate-600 hover:bg-slate-100"><i class="fa-solid fa-user w-5 text-center text-slate-400"></i><span>Profile Information</span></a>
            <a href="#" onclick="switchSub('general','address');return false;" class="submenu-link flex items-center space-x-3 px-3 py-2.5 rounded-lg text-xs font-semibold text-slate-600 hover:bg-slate-100"><i class="fa-solid fa-location-dot w-5 text-center text-slate-400"></i><span>Address Information</span></a>
            <a href="#" onclick="switchSub('general','login_options');return false;" class="submenu-link flex items-center space-x-3 px-3 py-2.5 rounded-lg text-xs font-semibold text-slate-600 hover:bg-slate-100"><i class="fa-solid fa-right-to-bracket w-5 text-center text-slate-400"></i><span>Login Page Options</span></a>
            <a href="#" onclick="switchSub('general','language');return false;" class="submenu-link flex items-center space-x-3 px-3 py-2.5 rounded-lg text-xs font-semibold text-slate-600 hover:bg-slate-100"><i class="fa-solid fa-globe w-5 text-center text-slate-400"></i><span>Language &amp; Timezone</span></a>
            <a href="#" onclick="switchSub('general','system');return false;" class="submenu-link flex items-center space-x-3 px-3 py-2.5 rounded-lg text-xs font-semibold text-slate-600 hover:bg-slate-100"><i class="fa-solid fa-sliders w-5 text-center text-slate-400"></i><span>System Preferences</span></a>
          </div>
          <div class="cat-menu hidden" data-cat="email">
            <a href="#" onclick="switchSub('email','email_settings');return false;" class="submenu-link active flex items-center space-x-3 px-3 py-2.5 rounded-lg text-xs font-semibold text-slate-600 hover:bg-slate-100"><i class="fa-solid fa-envelope w-5 text-center text-slate-400"></i><span>Email Settings</span></a>
            <a href="#" onclick="switchSub('email','email_templates');return false;" class="submenu-link flex items-center space-x-3 px-3 py-2.5 rounded-lg text-xs font-semibold text-slate-600 hover:bg-slate-100"><i class="fa-solid fa-file-code w-5 text-center text-slate-400"></i><span>Email Templates</span></a>
            <a href="#" onclick="switchSub('email','notification_triggers');return false;" class="submenu-link flex items-center space-x-3 px-3 py-2.5 rounded-lg text-xs font-semibold text-slate-600 hover:bg-slate-100"><i class="fa-solid fa-bell w-5 text-center text-slate-400"></i><span>Notification Triggers</span></a>
            <a href="#" onclick="switchSub('email','smtp_config');return false;" class="submenu-link flex items-center space-x-3 px-3 py-2.5 rounded-lg text-xs font-semibold text-slate-600 hover:bg-slate-100"><i class="fa-solid fa-server w-5 text-center text-slate-400"></i><span>SMTP Configuration</span></a>
          </div>
          <div class="cat-menu hidden" data-cat="payments">
            <a href="#" onclick="switchSub('payments','gateways');return false;" class="submenu-link active flex items-center space-x-3 px-3 py-2.5 rounded-lg text-xs font-semibold text-slate-600 hover:bg-slate-100"><i class="fa-solid fa-credit-card w-5 text-center text-slate-400"></i><span>Payment Gateways</span></a>
            <a href="#" onclick="switchSub('payments','webhook');return false;" class="submenu-link flex items-center space-x-3 px-3 py-2.5 rounded-lg text-xs font-semibold text-slate-600 hover:bg-slate-100"><i class="fa-solid fa-code w-5 text-center text-slate-400"></i><span>Webhook &amp; API</span></a>
            <a href="#" onclick="switchSub('payments','woocommerce');return false;" class="submenu-link flex items-center space-x-3 px-3 py-2.5 rounded-lg text-xs font-semibold text-slate-600 hover:bg-slate-100"><i class="fa-brands fa-wordpress w-5 text-center text-slate-400"></i><span>WooCommerce</span></a>
            <a href="#" onclick="switchSub('payments','currency');return false;" class="submenu-link flex items-center space-x-3 px-3 py-2.5 rounded-lg text-xs font-semibold text-slate-600 hover:bg-slate-100"><i class="fa-solid fa-calculator w-5 text-center text-slate-400"></i><span>Currency &amp; Tax</span></a>
            <a href="#" onclick="switchSub('payments','invoice');return false;" class="submenu-link flex items-center space-x-3 px-3 py-2.5 rounded-lg text-xs font-semibold text-slate-600 hover:bg-slate-100"><i class="fa-solid fa-file-invoice w-5 text-center text-slate-400"></i><span>Invoice Settings</span></a>
          </div>
          <div class="cat-menu hidden" data-cat="appearance">
            <a href="#" onclick="switchSub('appearance','branding');return false;" class="submenu-link active flex items-center space-x-3 px-3 py-2.5 rounded-lg text-xs font-semibold text-slate-600 hover:bg-slate-100"><i class="fa-solid fa-palette w-5 text-center text-slate-400"></i><span>Branding</span></a>
            <a href="#" onclick="switchSub('appearance','colors');return false;" class="submenu-link flex items-center space-x-3 px-3 py-2.5 rounded-lg text-xs font-semibold text-slate-600 hover:bg-slate-100"><i class="fa-solid fa-droplet w-5 text-center text-slate-400"></i><span>Colors &amp; Font</span></a>
            <a href="#" onclick="switchSub('appearance','logo_favicon');return false;" class="submenu-link flex items-center space-x-3 px-3 py-2.5 rounded-lg text-xs font-semibold text-slate-600 hover:bg-slate-100"><i class="fa-solid fa-image w-5 text-center text-slate-400"></i><span>Logo &amp; Homepage Image</span></a>
            <a href="#" onclick="switchSub('appearance','login_page');return false;" class="submenu-link flex items-center space-x-3 px-3 py-2.5 rounded-lg text-xs font-semibold text-slate-600 hover:bg-slate-100"><i class="fa-solid fa-right-to-bracket w-5 text-center text-slate-400"></i><span>Login Page Text</span></a>
          </div>
          <div class="cat-menu hidden" data-cat="roles">
            <a href="#" onclick="switchSub('roles','roles_mgmt');return false;" class="submenu-link active flex items-center space-x-3 px-3 py-2.5 rounded-lg text-xs font-semibold text-slate-600 hover:bg-slate-100"><i class="fa-solid fa-user-shield w-5 text-center text-slate-400"></i><span>Roles Overview</span></a>
          </div>
          <div class="cat-menu hidden" data-cat="security">
            <a href="#" onclick="switchSub('security','password_login');return false;" class="submenu-link active flex items-center space-x-3 px-3 py-2.5 rounded-lg text-xs font-semibold text-slate-600 hover:bg-slate-100"><i class="fa-solid fa-lock w-5 text-center text-slate-400"></i><span>Password &amp; Login</span></a>
            <a href="#" onclick="switchSub('security','two_factor');return false;" class="submenu-link flex items-center space-x-3 px-3 py-2.5 rounded-lg text-xs font-semibold text-slate-600 hover:bg-slate-100"><i class="fa-solid fa-shield-halved w-5 text-center text-slate-400"></i><span>Two-Factor (OTP)</span></a>
            <a href="#" onclick="switchSub('security','session_mgmt');return false;" class="submenu-link flex items-center space-x-3 px-3 py-2.5 rounded-lg text-xs font-semibold text-slate-600 hover:bg-slate-100"><i class="fa-solid fa-laptop w-5 text-center text-slate-400"></i><span>Session Management</span></a>
            <a href="#" onclick="switchSub('security','my_password');return false;" class="submenu-link flex items-center space-x-3 px-3 py-2.5 rounded-lg text-xs font-semibold text-slate-600 hover:bg-slate-100"><i class="fa-solid fa-key w-5 text-center text-slate-400"></i><span>Change My Password</span></a>
          </div>
        </div>

        <!-- RIGHT PANEL -->
        <div class="lg:col-span-9 bg-white rounded-xl border border-slate-200 p-6 shadow-sm text-xs">

          <!-- GENERAL: Profile -->
          <div class="settings-panel active" data-cat="general" data-sub="profile">
            <form method="post" action="/admin/settings/profile" class="space-y-6">
              <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                <div><h3 class="font-bold text-base text-[#091e42]">Profile Information</h3><p class="text-slate-500 mt-0.5">Update your personal and portal information.</p></div>
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-bold px-4 py-2.5 rounded-xl transition shadow-md shadow-blue-600/30">Save Changes</button>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div><label class="block font-semibold text-slate-700 mb-1">Full Name</label><input type="text" name="name" value="<%= teacherProfile.name %>" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5 font-medium"></div>
                <div><label class="block font-semibold text-slate-700 mb-1"><%= currentUser.role === 'admin' ? 'Admin' : 'Teacher' %> ID</label><input type="text" readonly value="TCH-<%= String(teacherProfile.id).padStart(3,'0') %>" class="w-full bg-slate-100 border border-slate-200 rounded-lg px-3 py-2.5 text-slate-500 font-medium"></div>
                <div><label class="block font-semibold text-slate-700 mb-1">Email Address</label><input type="email" value="<%= teacherProfile.email %>" disabled class="w-full bg-slate-100 border border-slate-200 rounded-lg px-3 py-2.5 text-slate-500 font-medium"></div>
                <div><label class="block font-semibold text-slate-700 mb-1">Phone Number</label><input type="text" name="phone" value="<%= teacherProfile.phone || '' %>" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5 font-medium"></div>
                <div><label class="block font-semibold text-slate-700 mb-1">Department / Faculty</label><input type="text" name="department" value="<%= teacherProfile.department || '' %>" placeholder="e.g. Mathematics & Science Faculty" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5 font-medium"></div>
                <div class="sm:col-span-2"><label class="block font-semibold text-slate-700 mb-1">About Me</label><textarea name="bio" rows="3" class="w-full bg-slate-50 border border-slate-200 rounded-lg p-3 font-medium"><%= teacherProfile.bio || '' %></textarea></div>
              </div>
            </form>
          </div>

          <!-- GENERAL: Address -->
          <div class="settings-panel" data-cat="general" data-sub="address">
            <form method="post" action="/admin/settings/profile" class="space-y-6">
              <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                <div><h3 class="font-bold text-base text-[#091e42]">Address Information</h3><p class="text-slate-500 mt-0.5">Manage your institutional or personal address.</p></div>
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-bold px-4 py-2.5 rounded-xl transition shadow-md">Save Changes</button>
              </div>
              <input type="hidden" name="name" value="<%= teacherProfile.name %>">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="sm:col-span-2"><label class="block font-semibold text-slate-700 mb-1">Street Address</label><input type="text" name="address" value="<%= teacherProfile.address || '' %>" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5 font-medium"></div>
                <div class="sm:col-span-2"><label class="block font-semibold text-slate-700 mb-1">Address Line 2</label><input type="text" name="address_line2" value="<%= teacherProfile.address_line2 || '' %>" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5 font-medium"></div>
                <div><label class="block font-semibold text-slate-700 mb-1">City</label><input type="text" name="city" value="<%= teacherProfile.city || '' %>" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5 font-medium"></div>
                <div><label class="block font-semibold text-slate-700 mb-1">State / Province</label><input type="text" name="state" value="<%= teacherProfile.state || '' %>" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5 font-medium"></div>
                <div><label class="block font-semibold text-slate-700 mb-1">Postal Code</label><input type="text" name="postal_code" value="<%= teacherProfile.postal_code || '' %>" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5 font-medium"></div>
                <div><label class="block font-semibold text-slate-700 mb-1">Country</label><input type="text" name="country" value="<%= teacherProfile.country || 'Australia' %>" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5 font-medium"></div>
              </div>
            </form>
          </div>

          <!-- GENERAL: Login Options -->
          <div class="settings-panel" data-cat="general" data-sub="login_options">
            <form method="post" action="/admin/settings/kv" class="space-y-6">
              <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                <div><h3 class="font-bold text-base text-[#091e42]">Login Page Options</h3><p class="text-slate-500 mt-0.5">Customize authentication options and login page behaviour.</p></div>
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-bold px-4 py-2.5 rounded-xl transition shadow-md">Save Changes</button>
              </div>
              <div class="space-y-3">
                <div class="flex items-center justify-between bg-slate-50 p-4 rounded-xl border border-slate-100">
                  <div><h4 class="font-bold text-slate-900">Google SSO Authentication</h4><p class="text-slate-500 text-[11px]">Allow users to sign in with Google accounts (requires separate OAuth setup)</p></div>
                  <input type="hidden" name="google_sso_enabled" value="0"><input type="checkbox" name="google_sso_enabled" value="1" <%= extra.google_sso_enabled==='1'?'checked':'' %> class="w-5 h-5 rounded text-blue-600">
                </div>
                <div class="flex items-center justify-between bg-slate-50 p-4 rounded-xl border border-slate-100">
                  <div><h4 class="font-bold text-slate-900">Microsoft SSO Authentication</h4><p class="text-slate-500 text-[11px]">Allow users to sign in with Microsoft school accounts</p></div>
                  <input type="hidden" name="microsoft_sso_enabled" value="0"><input type="checkbox" name="microsoft_sso_enabled" value="1" <%= extra.microsoft_sso_enabled==='1'?'checked':'' %> class="w-5 h-5 rounded text-blue-600">
                </div>
                <div class="flex items-center justify-between bg-slate-50 p-4 rounded-xl border border-slate-100">
                  <div><h4 class="font-bold text-slate-900">Remember Me Checkbox</h4><p class="text-slate-500 text-[11px]">Show 'Remember me' option on the login screen</p></div>
                  <input type="hidden" name="remember_me_enabled" value="0"><input type="checkbox" name="remember_me_enabled" value="1" <%= extra.remember_me_enabled==='1'?'checked':'' %> class="w-5 h-5 rounded text-blue-600">
                </div>
              </div>
            </form>
          </div>

          <!-- GENERAL: Language & Timezone -->
          <div class="settings-panel" data-cat="general" data-sub="language">
            <form method="post" action="/admin/settings/general" class="space-y-6">
              <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                <div><h3 class="font-bold text-base text-[#091e42]">Language &amp; Timezone</h3><p class="text-slate-500 mt-0.5">Set regional defaults for dates, times and language.</p></div>
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-bold px-4 py-2.5 rounded-xl transition shadow-md">Save Changes</button>
              </div>
              <input type="hidden" name="platform_name" value="<%= general.platform_name %>">
              <input type="hidden" name="contact_email" value="<%= general.contact_email %>">
              <input type="hidden" name="website_url" value="<%= general.website_url %>">
              <input type="hidden" name="portal_description" value="<%= general.portal_description %>">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block font-semibold text-slate-700 mb-1">Timezone</label>
                  <select name="timezone" class="custom-select w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5 font-medium">
                    <% ['Australia/Sydney','Australia/Perth','Australia/Adelaide','Australia/Brisbane'].forEach(function(tz){ %>
                    <option value="<%= tz %>" <%= general.timezone===tz?'selected':'' %>><%= tz %></option>
                    <% }); %>
                  </select>
                </div>
              </div>
            </form>
            <form method="post" action="/admin/settings/kv" class="mt-4">
              <div>
                <label class="block font-semibold text-slate-700 mb-1">Display Language</label>
                <select name="display_language" class="custom-select w-full sm:w-1/2 bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5 font-medium">
                  <option <%= extra.display_language==='English (Australia)'?'selected':'' %>>English (Australia)</option>
                  <option <%= extra.display_language==='English (US)'?'selected':'' %>>English (US)</option>
                </select>
              </div>
              <button type="submit" class="mt-3 bg-blue-600 hover:bg-blue-700 text-white font-bold px-4 py-2 rounded-xl transition shadow-md">Save Language</button>
            </form>
          </div>

          <!-- GENERAL: System Preferences -->
          <div class="settings-panel" data-cat="general" data-sub="system">
            <form method="post" action="/admin/settings/kv" class="space-y-6">
              <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                <div><h3 class="font-bold text-base text-[#091e42]">System Preferences</h3><p class="text-slate-500 mt-0.5">Configure maintenance mode and logging.</p></div>
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-bold px-4 py-2.5 rounded-xl transition shadow-md">Save Changes</button>
              </div>
              <div class="space-y-3">
                <div class="flex items-center justify-between bg-slate-50 p-4 rounded-xl border border-slate-100">
                  <div><h4 class="font-bold text-slate-900">Maintenance Mode</h4><p class="text-slate-500 text-[11px]">Temporarily restrict student portal access</p></div>
                  <input type="hidden" name="maintenance_mode" value="0"><input type="checkbox" name="maintenance_mode" value="1" <%= extra.maintenance_mode==='1'?'checked':'' %> class="w-5 h-5 rounded text-blue-600">
                </div>
                <div class="flex items-center justify-between bg-slate-50 p-4 rounded-xl border border-slate-100">
                  <div><h4 class="font-bold text-slate-900">Debug Logging</h4><p class="text-slate-500 text-[11px]">Keep detailed audit logs for troubleshooting</p></div>
                  <input type="hidden" name="debug_logging" value="0"><input type="checkbox" name="debug_logging" value="1" <%= extra.debug_logging==='1'?'checked':'' %> class="w-5 h-5 rounded text-blue-600">
                </div>
              </div>
            </form>
          </div>

          <!-- EMAIL: Settings -->
          <div class="settings-panel" data-cat="email" data-sub="email_settings">
            <form method="post" action="/admin/settings/kv" class="space-y-6">
              <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                <div><h3 class="font-bold text-base text-[#091e42]">Email Settings</h3><p class="text-slate-500 mt-0.5">Configure the sender identity for all system emails.</p></div>
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-bold px-4 py-2.5 rounded-xl transition shadow-md">Save Changes</button>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div><label class="block font-semibold text-slate-700 mb-1">From Name</label><input type="text" name="from_name" value="<%= extra.from_name %>" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5 font-medium"></div>
                <div><label class="block font-semibold text-slate-700 mb-1">From Email</label><input type="email" name="from_email" value="<%= extra.from_email %>" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5 font-medium"></div>
                <div class="sm:col-span-2"><label class="block font-semibold text-slate-700 mb-1">Email Footer</label><textarea name="email_footer" rows="2" class="w-full bg-slate-50 border border-slate-200 rounded-lg p-3 font-medium"><%= extra.email_footer %></textarea></div>
              </div>
              <p class="text-slate-400 text-[11px]">Real SMTP host/port/credentials come from your <code>.env</code> file — see <a href="/admin/help" class="text-blue-600 font-semibold">Help &amp; Documentation</a> for setup steps.</p>
            </form>
          </div>

          <!-- EMAIL: Templates (real, reusing existing template toggle system) -->
