<%- include('../partials/portal_top', { title: paper.title, active: 'papers', crumb: 'Admin / Full Exam Papers / Manage' }) %>
<div class="page-title">
  <div><h2><%= paper.title %></h2><p class="muted"><%= paper.year %> · <%= paper.subject_name %></p></div>
  <% if (!paper.is_published) { %>
    <form method="post" action="/admin/papers/<%= paper.id %>/publish"><button class="btn btn-success" type="submit">Publish on Website</button></form>
  <% } else { %><span class="chip chip-green">Published</span><% } %>
</div>

<div class="card card-pad">
  <h3>Add Question (add as many MCQ / Written / Essay as you like)</h3>
  <form method="post" action="/admin/papers/<%= paper.id %>/questions" id="qform" class="form-grid">
    <div class="field"><label>Type</label>
      <select name="type" id="qtype" onchange="document.getElementById('mcqOpts').style.display=this.value==='mcq'?'grid':'none'">
        <option value="mcq">MCQ</option><option value="written">Written</option><option value="essay">Essay</option>
      </select>
    </div>
    <div class="field"><label>Marks</label><input type="number" name="marks" value="1"></div>
    <div class="field full"><label>Question</label><textarea name="question" required></textarea></div>
    <div id="mcqOpts" class="form-grid full" style="display:grid;">
      <div class="field"><label>Option A</label><input name="option_a"></div>
      <div class="field"><label>Option B</label><input name="option_b"></div>
      <div class="field"><label>Option C</label><input name="option_c"></div>
      <div class="field"><label>Option D</label><input name="option_d"></div>
      <div class="field"><label>Correct Option</label>
        <select name="correct_option"><option>A</option><option>B</option><option>C</option><option>D</option></select></div>
    </div>
    <div class="field"><label>Word Limit (written/essay)</label><input type="number" name="word_limit" value="500"></div>
    <div class="full"><button class="btn btn-primary" type="submit">Add Question</button></div>
  </form>
</div>

<div class="card card-pad" style="margin-top:18px;">
  <h3>Questions (<%= questions.length %>)</h3>
  <div class="table-wrap"><table class="table">
    <tr><th>#</th><th>Type</th><th>Question</th><th>Marks</th><th></th></tr>
    <% questions.forEach((q,i) => { %>
      <tr>
        <td><%= i+1 %></td><td><span class="tag"><%= q.type %></span></td><td><%= q.question %></td><td><%= q.marks %></td>
        <td>
          <form method="post" action="/admin/papers/<%= paper.id %>/questions/<%= q.id %>/delete" style="margin:0;">
            <button class="btn btn-danger" type="submit" style="padding:6px 12px;">Delete</button>
          </form>
        </td>
      </tr>
    <% }) %>
    <% if (!questions.length) { %><tr><td colspan="5" class="muted">No questions yet.</td></tr><% } %>
  </table></div>
</div>
<%- include('../partials/portal_bottom') %>
