<!DOCTYPE html>
<html lang="en" class="h-full bg-[#f4f6fa]">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= paper.title %> — AUS Academy</title>
<link rel="stylesheet" href="/assets/tailwind.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<%- include('../partials/tw_head_styles') %>
</head>
<body class="h-full antialiased flex flex-col text-slate-800">
<div class="flex flex-1 min-h-screen overflow-hidden">
  <%- include('../partials/tw_sidebar', { active: 'papers' }) %>
  <main class="flex-1 flex flex-col min-w-0 overflow-y-auto">
    <%- include('../partials/tw_header', { searchPlaceholder: 'Search...' }) %>

    <div class="p-4 sm:p-6 lg:p-8 max-w-[1700px] mx-auto w-full flex-1 space-y-6">

      <% if (typeof success !== 'undefined' && success.length) { %><div class="bg-emerald-50 border border-emerald-200 text-emerald-700 text-xs font-semibold rounded-xl px-4 py-3"><%= success[0] %></div><% } %>
      <% if (typeof error !== 'undefined' && error.length) { %><div class="bg-rose-50 border border-rose-200 text-rose-700 text-xs font-semibold rounded-xl px-4 py-3"><%= error[0] %></div><% } %>

      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="flex items-start space-x-4">
          <div class="w-10 h-10 rounded-xl bg-blue-600 text-white flex items-center justify-center shrink-0 mt-0.5 shadow-md shadow-blue-600/30">
            <i class="fa-solid fa-file-signature text-lg"></i>
          </div>
          <div>
            <h1 class="text-2xl sm:text-[28px] font-bold text-[#091e42] tracking-tight"><%= paper.title %></h1>
            <p class="text-[13px] text-slate-500 mt-0.5"><%= paper.year %> &middot; <%= paper.subject_name %></p>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <a href="/admin/papers" class="bg-white hover:bg-slate-50 text-slate-700 border border-slate-300 font-semibold text-xs px-4 py-2.5 rounded-xl transition shadow-sm flex items-center space-x-2">
            <i class="fa-solid fa-arrow-left text-xs"></i><span>Back</span>
          </a>
          <% if (!paper.is_published) { %>
          <form method="post" action="/admin/papers/<%= paper.id %>/publish">
            <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs px-4 py-2.5 rounded-xl transition shadow-md shadow-blue-600/30">Publish on Website</button>
          </form>
          <% } else { %>
          <span class="bg-emerald-50 text-emerald-700 border-emerald-200 border px-3 py-1.5 rounded-full font-semibold text-xs">Published</span>
          <% } %>
        </div>
      </div>

      <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-5">
        <h3 class="font-bold text-sm text-[#091e42] mb-1">WooCommerce Link</h3>
        <p class="text-[11px] text-slate-500 mb-3">This paper is only ever bought on the WooCommerce website. Enter the matching WooCommerce Product ID so the <code class="bg-slate-100 text-blue-700 px-1.5 py-0.5 rounded text-[10px]">/api/woo/order-complete</code> webhook can auto-assign it here after purchase.</p>
        <form method="post" action="/admin/papers/<%= paper.id %>/woo-link" class="flex items-end gap-3 text-xs">
          <div class="flex-1">
            <label class="block font-semibold text-slate-600 mb-1">WooCommerce Product ID</label>
            <input type="text" name="woo_product_id" value="<%= paper.woo_product_id || '' %>" placeholder="e.g. 587" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 font-medium focus:outline-none focus:ring-2 focus:ring-blue-500">
          </div>
          <button type="submit" class="bg-white hover:bg-slate-50 text-slate-700 border border-slate-300 font-semibold px-4 py-2 rounded-lg transition shadow-sm">Save Link</button>
        </form>
      </div>

      <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-5">
        <h3 class="font-bold text-sm text-[#091e42] mb-3">Add Question (add as many MCQ / Written / Essay as you like)</h3>
        <form method="post" action="/admin/papers/<%= paper.id %>/questions" id="qform" class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
          <div>
            <label class="block font-semibold text-slate-600 mb-1">Type</label>
            <select name="type" id="qtype" onchange="document.getElementById('mcqOpts').style.display=this.value==='mcq'?'grid':'none'" class="custom-select w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 font-medium focus:outline-none focus:ring-2 focus:ring-blue-500">
              <option value="mcq">MCQ</option><option value="written">Written</option><option value="essay">Essay</option>
            </select>
          </div>
          <div>
            <label class="block font-semibold text-slate-600 mb-1">Marks</label>
            <input type="number" name="marks" value="1" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 font-medium focus:outline-none focus:ring-2 focus:ring-blue-500">
          </div>
          <div class="sm:col-span-2">
            <label class="block font-semibold text-slate-600 mb-1">Question</label>
            <textarea name="question" required rows="2" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 font-medium focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
          </div>
          <div id="mcqOpts" class="sm:col-span-2 grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div><label class="block font-semibold text-slate-600 mb-1">Option A</label><input name="option_a" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 font-medium focus:outline-none focus:ring-2 focus:ring-blue-500"></div>
            <div><label class="block font-semibold text-slate-600 mb-1">Option B</label><input name="option_b" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 font-medium focus:outline-none focus:ring-2 focus:ring-blue-500"></div>
            <div><label class="block font-semibold text-slate-600 mb-1">Option C</label><input name="option_c" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 font-medium focus:outline-none focus:ring-2 focus:ring-blue-500"></div>
            <div><label class="block font-semibold text-slate-600 mb-1">Option D</label><input name="option_d" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 font-medium focus:outline-none focus:ring-2 focus:ring-blue-500"></div>
            <div class="sm:col-span-2"><label class="block font-semibold text-slate-600 mb-1">Correct Option</label>
              <select name="correct_option" class="custom-select w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 font-medium focus:outline-none focus:ring-2 focus:ring-blue-500"><option>A</option><option>B</option><option>C</option><option>D</option></select></div>
          </div>
          <div>
            <label class="block font-semibold text-slate-600 mb-1">Word Limit (written/essay)</label>
            <input type="number" name="word_limit" value="500" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 font-medium focus:outline-none focus:ring-2 focus:ring-blue-500">
          </div>
          <div class="sm:col-span-2">
            <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-bold px-5 py-2.5 rounded-lg transition shadow-md shadow-blue-600/30">Add Question</button>
          </div>
        </form>
      </div>

      <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="px-5 py-4 border-b border-slate-100"><h3 class="font-bold text-sm text-[#091e42]">Questions (<%= questions.length %>)</h3></div>
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse text-xs">
            <thead>
              <tr class="bg-slate-50/80 border-b border-slate-200 text-slate-600 font-bold uppercase tracking-wider text-[11px]">
                <th class="p-3.5 w-10">#</th>
                <th class="p-3.5">Type</th>
                <th class="p-3.5">Question</th>
                <th class="p-3.5">Marks</th>
                <th class="p-3.5 text-center">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 font-medium text-slate-700">
              <% questions.forEach((q, i) => { %>
              <tr class="hover:bg-slate-50 transition">
                <td class="p-3.5 text-slate-500"><%= i + 1 %></td>
                <td class="p-3.5"><span class="bg-blue-50 text-blue-700 border-blue-200 border px-2 py-0.5 rounded text-[10px] font-bold"><%= q.type %></span></td>
                <td class="p-3.5 text-slate-700 max-w-md"><%= q.question %></td>
                <td class="p-3.5 text-slate-500"><%= q.marks %></td>
                <td class="p-3.5 text-center">
                  <form method="post" action="/admin/papers/<%= paper.id %>/questions/<%= q.id %>/delete" onsubmit="return confirm('Delete this question?')">
                    <button type="submit" class="px-3 py-1.5 bg-rose-50 hover:bg-rose-100 text-rose-600 rounded-lg text-xs font-semibold transition">Delete</button>
                  </form>
                </td>
              </tr>
              <% }) %>
              <% if (!questions.length) { %>
              <tr><td colspan="5" class="p-6 text-center text-slate-400">No questions yet.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </main>
</div>
<%- include('../partials/tw_scripts') %>
</body>
</html>
