<!DOCTYPE html>
<html lang="en" class="h-full bg-[#f4f6fa]">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Students — AUS Academy</title>
<link rel="stylesheet" href="/assets/tailwind.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<%- include('../partials/tw_head_styles') %>
</head>
<body class="h-full antialiased flex flex-col text-slate-800">
<div class="flex flex-1 min-h-screen overflow-hidden">
  <%- include('../partials/tw_sidebar', { active: 'students' }) %>

  <main class="flex-1 flex flex-col min-w-0 overflow-y-auto">
    <%- include('../partials/tw_header', { searchPlaceholder: 'Search students by name, email, class...' }) %>


    <div class="p-4 sm:p-6 space-y-6 max-w-7xl mx-auto w-full">

      <div>
        <nav class="flex text-xs text-slate-500 space-x-2 mb-1">
          <a href="/admin/dashboard" class="hover:text-blue-600 transition">Home</a><span>&gt;</span>
          <span class="text-slate-800 font-semibold">Students</span>
        </nav>
        <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Students</h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-0.5">Manage all students, view details, track performance and assignments.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white p-4 rounded-xl border border-slate-200/80 card-shadow flex items-center justify-between">
          <div class="flex items-center space-x-3">
            <div class="w-11 h-11 rounded-lg bg-blue-100 text-blue-600 flex items-center justify-center text-xl shrink-0"><i class="fa-solid fa-users"></i></div>
            <div><p class="text-xs font-medium text-slate-500">Total Students</p><h3 class="text-xl font-extrabold text-slate-900 leading-tight"><%= stats.total %></h3><p class="text-[10px] text-slate-400 mt-0.5">+<%= stats.newThisMonth %> new this month</p></div>
          </div>
        </div>
        <div class="bg-white p-4 rounded-xl border border-slate-200/80 card-shadow flex items-center justify-between">
          <div class="flex items-center space-x-3">
            <div class="w-11 h-11 rounded-lg bg-emerald-100 text-emerald-600 flex items-center justify-center text-xl shrink-0"><i class="fa-solid fa-user-check"></i></div>
            <div><p class="text-xs font-medium text-slate-500">Active Students</p><h3 class="text-xl font-extrabold text-slate-900 leading-tight"><%= stats.active %></h3><p class="text-[10px] text-slate-400 mt-0.5"><%= stats.total ? Math.round(stats.active/stats.total*100) : 0 %>% of total</p></div>
          </div>
        </div>
        <div class="bg-white p-4 rounded-xl border border-slate-200/80 card-shadow flex items-center justify-between">
          <div class="flex items-center space-x-3">
            <div class="w-11 h-11 rounded-lg bg-rose-100 text-rose-500 flex items-center justify-center text-xl shrink-0"><i class="fa-solid fa-circle-question"></i></div>
            <div><p class="text-xs font-medium text-slate-500">Inactive Students</p><h3 class="text-xl font-extrabold text-slate-900 leading-tight"><%= stats.inactive %></h3><p class="text-[10px] text-slate-400 mt-0.5"><%= stats.total ? Math.round(stats.inactive/stats.total*100) : 0 %>% of total</p></div>
          </div>
        </div>
        <div class="bg-white p-4 rounded-xl border border-slate-200/80 card-shadow flex items-center justify-between">
          <div class="flex items-center space-x-3">
            <div class="w-11 h-11 rounded-lg bg-purple-100 text-purple-600 flex items-center justify-center text-xl shrink-0"><i class="fa-solid fa-graduation-cap"></i></div>
            <div><p class="text-xs font-medium text-slate-500">New This Month</p><h3 class="text-xl font-extrabold text-slate-900 leading-tight"><%= stats.newThisMonth %></h3><p class="text-[10px] text-slate-400 mt-0.5">vs last month</p></div>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-xl border border-slate-200/80 card-shadow overflow-hidden">
        <form method="get" class="p-4 border-b border-slate-200/80 flex flex-col md:flex-row items-center justify-between gap-3">
          <div class="flex flex-wrap items-center gap-2.5 w-full md:w-auto">
            <div class="relative flex-1 sm:w-64">
              <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-slate-400 text-xs"></i>
              <input type="text" name="q" value="<%= filters.q %>" placeholder="Search students..." class="w-full bg-slate-50 border border-slate-200 rounded-lg pl-8 pr-3 py-1.5 text-xs outline-none focus:border-blue-500 focus:bg-white transition">
            </div>
            <div class="flex items-center space-x-1">
              <span class="text-xs font-medium text-slate-500">Year:</span>
              <select name="year" onchange="this.form.submit()" class="custom-select bg-slate-50 border border-slate-200 text-xs font-semibold text-slate-700 rounded-lg px-2.5 py-1.5 outline-none cursor-pointer">
                <option value="">All</option>
                <option value="Year 11" <%= filters.year==='Year 11'?'selected':'' %>>Y11</option>
                <option value="Year 12" <%= filters.year==='Year 12'?'selected':'' %>>Y12</option>
              </select>
            </div>
            <div class="flex items-center space-x-1">
              <span class="text-xs font-medium text-slate-500">Class:</span>
              <select name="class_section" onchange="this.form.submit()" class="custom-select bg-slate-50 border border-slate-200 text-xs font-semibold text-slate-700 rounded-lg px-2.5 py-1.5 outline-none cursor-pointer">
                <option value="">All</option>
                <% classOptions.forEach(c => { %><option value="<%= c %>" <%= filters.class_section===c?'selected':'' %>><%= c %></option><% }) %>
              </select>
            </div>
            <div class="flex items-center space-x-1">
              <span class="text-xs font-medium text-slate-500">Status:</span>
              <select name="status" onchange="this.form.submit()" class="custom-select bg-slate-50 border border-slate-200 text-xs font-semibold text-slate-700 rounded-lg px-2.5 py-1.5 outline-none cursor-pointer">
                <option value="">All</option>
                <option value="active" <%= filters.status==='active'?'selected':'' %>>Active</option>
                <option value="inactive" <%= filters.status==='inactive'?'selected':'' %>>Inactive</option>
              </select>
            </div>
          </div>
          <div class="flex items-center space-x-2 w-full md:w-auto justify-end">
            <a href="/admin/students/new" class="flex items-center space-x-1.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs px-3.5 py-2 rounded-lg transition shadow-sm">
              <i class="fa-solid fa-plus text-xs"></i><span>Add Student</span>
            </a>
          </div>
        </form>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead>
              <tr class="bg-slate-50/80 border-b border-slate-200/80 text-slate-500 font-semibold uppercase tracking-wider">
                <th class="py-3 px-3 w-8">#</th>
                <th class="py-3 px-4">Student Name</th>
                <th class="py-3 px-4">Email</th>
                <th class="py-3 px-3">Year</th>
                <th class="py-3 px-3">Class</th>
                <th class="py-3 px-3">Status</th>
                <th class="py-3 px-3">Avg. Score</th>
                <th class="py-3 px-4">Enrolled On</th>
                <th class="py-3 px-4 text-center">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 font-medium text-slate-700">
              <% students.forEach((s, i) => { %>
              <tr class="hover:bg-slate-50/60 transition">
                <td class="py-3 px-3 font-semibold text-slate-500"><%= (page-1)*pageSize + i + 1 %></td>
                <td class="py-3 px-4 flex items-center space-x-2.5">
                  <% if (s.profile_image) { %><img src="<%= s.profile_image %>" class="w-7 h-7 rounded-full object-cover">
                  <% } else { %><div class="w-7 h-7 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center text-[10px] font-bold"><%= s.name.split(' ').map(w=>w[0]).slice(0,2).join('').toUpperCase() %></div><% } %>
                  <span class="font-bold text-slate-900"><%= s.name %></span>
                </td>
                <td class="py-3 px-4 text-slate-500"><%= s.email %></td>
                <td class="py-3 px-3"><%= s.class_year ? s.class_year.replace('Year ','Y') : '—' %></td>
                <td class="py-3 px-3"><%= s.class_section || '—' %></td>
                <td class="py-3 px-3"><span class="<%= s.account_status==='active' ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-700' %> font-bold px-2.5 py-0.5 rounded-full text-[10px]"><%= s.account_status==='active' ? 'Active' : (s.account_status==='pending'?'Pending':'Inactive') %></span></td>
                <td class="py-3 px-3">
                  <% if (s.avg_score !== null) { %><span class="<%= s.avg_score>=85?'bg-emerald-100 text-emerald-800':(s.avg_score>=70?'bg-amber-100 text-amber-800':'bg-rose-100 text-rose-700') %> font-bold px-2 py-0.5 rounded-md text-[11px]"><%= s.avg_score %>%</span>
                  <% } else { %><span class="text-slate-400">—</span><% } %>
                </td>
                <td class="py-3 px-4 text-slate-500"><%= new Date(s.enrolled_at || s.created_at).toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'}) %></td>
                <td class="py-3 px-4">
                  <div class="flex items-center justify-center space-x-1.5 text-blue-600">
                    <a href="/admin/students/<%= s.id %>" class="p-1 hover:bg-blue-50 rounded transition" title="View"><i class="fa-regular fa-eye"></i></a>
                    <a href="/admin/students/<%= s.id %>/edit" class="p-1 hover:bg-blue-50 rounded transition" title="Edit"><i class="fa-regular fa-pen-to-square"></i></a>
                    <a href="/admin/students/<%= s.id %>#progress" class="p-1 hover:bg-blue-50 rounded transition" title="Performance"><i class="fa-solid fa-chart-simple"></i></a>
                  </div>
                </td>
              </tr>
              <% }) %>
              <% if (!students.length) { %><tr><td colspan="9" class="py-6 text-center text-slate-400">No students found.</td></tr><% } %>
            </tbody>
          </table>
        </div>

        <div class="p-4 border-t border-slate-200/80 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-500">
          <span>Showing <%= students.length ? (page-1)*pageSize+1 : 0 %> to <%= Math.min(page*pageSize, total) %> of <%= total %> students</span>
          <div class="flex items-center space-x-1 font-semibold">
            <% if (page > 1) { %><a class="w-7 h-7 flex items-center justify-center rounded-lg border border-slate-200 text-slate-600 hover:bg-slate-50" href="?page=<%= page-1 %>&q=<%= filters.q %>&year=<%= filters.year %>&status=<%= filters.status %>"><i class="fa-solid fa-chevron-left text-[10px]"></i></a><% } %>
            <% for (let p = Math.max(1,page-2); p <= Math.min(totalPages,page+2); p++) { %>
              <% if (p === page) { %><span class="w-7 h-7 flex items-center justify-center rounded-lg bg-blue-600 text-white shadow-sm"><%= p %></span>
              <% } else { %><a class="w-7 h-7 flex items-center justify-center rounded-lg border border-slate-200 text-slate-600 hover:bg-slate-50" href="?page=<%= p %>&q=<%= filters.q %>&year=<%= filters.year %>&status=<%= filters.status %>"><%= p %></a><% } %>
            <% } %>
            <% if (page < totalPages) { %><a class="w-7 h-7 flex items-center justify-center rounded-lg border border-slate-200 text-slate-600 hover:bg-slate-50" href="?page=<%= page+1 %>&q=<%= filters.q %>&year=<%= filters.year %>&status=<%= filters.status %>"><i class="fa-solid fa-chevron-right text-[10px]"></i></a><% } %>
          </div>
        </div>
      </div>
    </div>

    <footer class="mt-auto bg-white border-t border-slate-200 px-6 py-4 flex flex-col md:flex-row items-center justify-between text-xs text-slate-500 gap-3">
      <div class="flex items-center space-x-2">
        <div class="w-5 h-5 rounded bg-slate-800 text-white flex items-center justify-center font-bold text-[10px]">A</div>
        <span class="font-bold text-slate-700">AUS Academy</span>
        <span class="hidden sm:inline">• Australia Year 11–12 Online Exam Platform</span>
      </div>
      <div class="text-center sm:text-left">&copy; <%= new Date().getFullYear() %> AUS Academy. All rights reserved.</div>
    </footer>
  </main>
</div>
<%- include('../partials/tw_scripts') %>
</body>
</html>
