<%- include('../partials/portal_top', { title: 'New Exam Paper', active: 'papers', crumb: 'Admin / Full Exam Papers / New' }) %>
<div class="card card-pad" style="max-width:520px;">
  <h2>Create Full Exam Paper</h2>
  <form method="post" action="/admin/papers/new">
    <div class="field"><label>Title</label><input type="text" name="title" placeholder="e.g. Chemistry 2022 Exam Paper" required></div>
    <div class="field" style="margin-top:10px;"><label>Year</label><select name="year"><option>Year 11</option><option>Year 12</option></select></div>
    <div class="field" style="margin-top:10px;"><label>Subject</label>
      <select name="subject_id" required><% subjects.forEach(s=>{ %><option value="<%= s.id %>"><%= s.name %> (<%= s.year %>)</option><% }) %></select></div>
    <div class="field" style="margin-top:10px;"><label>Price (A$)</label><input type="number" step="0.01" name="price" required></div>
    <div class="field" style="margin-top:10px;"><label>Duration (minutes)</label><input type="number" name="duration_minutes" value="120"></div>
    <button class="btn btn-primary" style="margin-top:16px;" type="submit">Create Paper</button>
  </form>
</div>
<%- include('../partials/portal_bottom') %>
