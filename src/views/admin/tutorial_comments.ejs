<!DOCTYPE html>
<html lang="en" class="h-full bg-[#f4f6fa]">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Tutorial Comments — AUS Academy</title>
<link rel="stylesheet" href="/assets/tailwind.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<%- include('../partials/tw_head_styles') %>
</head>
<body class="h-full antialiased flex flex-col text-slate-800">
<div class="flex flex-1 min-h-screen overflow-hidden">
  <%- include('../partials/tw_sidebar', { active: 'tutorials' }) %>
  <main class="flex-1 flex flex-col min-w-0 overflow-y-auto">
    <%- include('../partials/tw_header', { searchPlaceholder: 'Search...' }) %>
    <div class="p-4 sm:p-6 space-y-6 max-w-4xl mx-auto w-full">
      <div class="flex items-center gap-4">
        <a href="/admin/tutorials" class="w-9 h-9 rounded-full bg-white border border-slate-200 text-slate-600 flex items-center justify-center hover:bg-slate-100 shadow-sm"><i class="fa-solid fa-arrow-left text-sm"></i></a>
        <div><h1 class="text-xl font-bold text-slate-900">Comments &amp; Questions</h1><p class="text-sm text-slate-500 mt-0.5"><%= tutorial.title %></p></div>
      </div>

      <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm space-y-4">
        <% const roots = comments.filter(c => !c.parent_id); %>
        <% roots.forEach(c => { %>
          <div class="space-y-2 border-b border-slate-100 pb-4 last:border-0">
            <div class="flex items-start space-x-3">
              <div class="w-8 h-8 rounded-full bg-slate-200 flex items-center justify-center text-xs font-bold text-slate-600 shrink-0"><%= c.user_name.charAt(0) %></div>
              <div class="flex-1 bg-slate-50 p-3.5 rounded-xl border border-slate-100 space-y-1">
                <div class="flex items-center justify-between"><h4 class="font-bold text-slate-900 text-sm"><%= c.user_name %></h4><span class="text-[10px] text-slate-400"><%= new Date(c.created_at).toLocaleString('en-GB') %></span></div>
                <p class="text-slate-700 text-xs leading-relaxed"><%= c.body %></p>
              </div>
            </div>
            <% comments.filter(r => r.parent_id === c.id).forEach(r => { %>
              <div class="flex items-start space-x-3 pl-8">
                <div class="w-8 h-8 rounded-full bg-blue-200 flex items-center justify-center text-xs font-bold text-blue-700 shrink-0"><%= r.user_name.charAt(0) %></div>
                <div class="flex-1 bg-blue-50/60 p-3.5 rounded-xl border border-blue-100 space-y-1">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center space-x-2"><h4 class="font-bold text-slate-900 text-sm"><%= r.user_name %></h4><% if (r.user_role !== 'student') { %><span class="bg-blue-600 text-white font-bold text-[9px] px-2 py-0.5 rounded-full">Teacher</span><% } %></div>
                    <span class="text-[10px] text-slate-400"><%= new Date(r.created_at).toLocaleString('en-GB') %></span>
                  </div>
                  <p class="text-slate-700 text-xs leading-relaxed"><%= r.body %></p>
                </div>
              </div>
            <% }) %>
            <form method="post" action="/admin/tutorials/<%= tutorial.id %>/comments/<%= c.id %>/reply" class="pl-8 flex gap-2 pt-1">
              <input type="text" name="body" required placeholder="Write a reply..." class="flex-1 bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-xs focus:outline-none focus:border-blue-500">
              <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold px-3 py-2 rounded-lg">Reply</button>
            </form>
          </div>
        <% }) %>
        <% if (!roots.length) { %><p class="text-sm text-slate-400 text-center py-6">No comments or questions yet on this tutorial.</p><% } %>
      </div>
    </div>
  </main>
</div>
<%- include('../partials/tw_scripts') %>
</body>
</html>
