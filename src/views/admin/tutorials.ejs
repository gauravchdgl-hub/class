<!DOCTYPE html>
<html lang="en" class="h-full bg-[#f4f6fa]">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Tutorials — AUS Academy</title>
<link rel="stylesheet" href="/assets/tailwind.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<%- include('../partials/tw_head_styles') %>
</head>
<body class="h-full antialiased flex flex-col text-slate-800">
<div class="flex flex-1 min-h-screen overflow-hidden">
  <%- include('../partials/tw_sidebar', { active: 'tutorials' }) %>

  <main class="flex-1 flex flex-col min-w-0 overflow-y-auto">
    <%- include('../partials/tw_header', { searchPlaceholder: 'Search tutorials by title, subject, or year...' }) %>

    <div class="p-4 sm:p-6 space-y-6 max-w-7xl mx-auto w-full">

      <div class="flex flex-col md:flex-row md:items-start justify-between gap-4">
        <div>
          <nav class="flex text-xs text-slate-500 space-x-2 mb-1">
            <a href="/admin/dashboard" class="hover:text-blue-600 transition">Home</a><span>&gt;</span>
            <span class="text-slate-800 font-semibold">Tutorials</span>
          </nav>
          <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Tutorials</h1>
          <p class="text-xs sm:text-sm text-slate-500 mt-0.5">Manage and publish tutorial videos by subject and year. Assign tutorials to students.</p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white rounded-xl border border-slate-200 p-5 card-shadow flex items-center space-x-4">
          <div class="w-14 h-14 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-2xl shrink-0"><i class="fa-solid fa-circle-play"></i></div>
          <div><p class="text-xs font-semibold text-slate-500">Total Tutorials</p><h3 class="text-2xl font-extrabold text-slate-900 leading-tight"><%= stats.total %></h3><p class="text-[11px] text-slate-400 mt-0.5">Total videos</p></div>
        </div>
        <div class="bg-white rounded-xl border border-slate-200 p-5 card-shadow flex items-center space-x-4">
          <div class="w-14 h-14 rounded-xl bg-emerald-50 text-emerald-500 flex items-center justify-center text-2xl shrink-0"><i class="fa-solid fa-circle-check"></i></div>
          <div><p class="text-xs font-semibold text-slate-500">Published</p><h3 class="text-2xl font-extrabold text-slate-900 leading-tight"><%= stats.published %></h3><p class="text-[11px] text-slate-400 mt-0.5"><%= stats.total ? Math.round(stats.published/stats.total*100) : 0 %>% of total</p></div>
        </div>
        <div class="bg-white rounded-xl border border-slate-200 p-5 card-shadow flex items-center space-x-4">
          <div class="w-14 h-14 rounded-xl bg-orange-50 text-orange-500 flex items-center justify-center text-2xl shrink-0"><i class="fa-solid fa-clock"></i></div>
          <div><p class="text-xs font-semibold text-slate-500">Draft</p><h3 class="text-2xl font-extrabold text-slate-900 leading-tight"><%= stats.draft %></h3><p class="text-[11px] text-slate-400 mt-0.5"><%= stats.total ? Math.round(stats.draft/stats.total*100) : 0 %>% of total</p></div>
        </div>
        <div class="bg-white rounded-xl border border-slate-200 p-5 card-shadow flex items-center space-x-4">
          <div class="w-14 h-14 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center text-2xl shrink-0"><i class="fa-solid fa-eye"></i></div>
          <div><p class="text-xs font-semibold text-slate-500">Total Views</p><h3 class="text-2xl font-extrabold text-slate-900 leading-tight"><%= stats.totalViews %></h3><p class="text-[11px] text-slate-400 mt-0.5">All time</p></div>
        </div>
      </div>

      <div class="bg-white rounded-xl border border-slate-200 card-shadow overflow-hidden flex flex-col">
        <form method="get" class="p-4 sm:p-5 border-b border-slate-200 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
          <div class="relative w-full lg:w-[320px]">
            <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-3 text-slate-400 text-sm"></i>
            <input type="text" name="q" value="<%= filters.q %>" placeholder="Search tutorials by title, subject, or year..." class="w-full bg-white border border-slate-200 rounded-lg pl-10 pr-4 py-2.5 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition">
          </div>
          <div class="flex flex-wrap items-center gap-3 w-full lg:w-auto">
            <select name="subject_id" onchange="this.form.submit()" class="custom-select min-w-[130px] bg-white border border-slate-200 rounded-lg px-3 py-2.5 text-sm text-slate-700 font-medium focus:outline-none focus:border-blue-500 transition">
              <option value="">Subject: All</option>
              <% subjects.forEach(s => { %><option value="<%= s.id %>" <%= filters.subject_id==String(s.id)?'selected':'' %>><%= s.name %> (<%= s.year %>)</option><% }) %>
            </select>
            <select name="year" onchange="this.form.submit()" class="custom-select min-w-[110px] bg-white border border-slate-200 rounded-lg px-3 py-2.5 text-sm text-slate-700 font-medium focus:outline-none focus:border-blue-500 transition">
              <option value="">Year: All</option>
              <option value="Year 11" <%= filters.year==='Year 11'?'selected':'' %>>Year 11</option>
              <option value="Year 12" <%= filters.year==='Year 12'?'selected':'' %>>Year 12</option>
            </select>
            <select name="status" onchange="this.form.submit()" class="custom-select min-w-[120px] bg-white border border-slate-200 rounded-lg px-3 py-2.5 text-sm text-slate-700 font-medium focus:outline-none focus:border-blue-500 transition">
              <option value="">Status: All</option>
              <option value="published" <%= filters.status==='published'?'selected':'' %>>Published</option>
              <option value="draft" <%= filters.status==='draft'?'selected':'' %>>Draft</option>
            </select>
            <select name="sort" onchange="this.form.submit()" class="custom-select min-w-[150px] bg-white border border-slate-200 rounded-lg px-3 py-2.5 text-sm text-slate-700 font-medium focus:outline-none focus:border-blue-500 transition">
              <option value="newest" <%= filters.sort==='newest'?'selected':'' %>>Sort By: Newest</option>
              <option value="oldest" <%= filters.sort==='oldest'?'selected':'' %>>Oldest</option>
              <option value="title" <%= filters.sort==='title'?'selected':'' %>>Title (A-Z)</option>
              <option value="views" <%= filters.sort==='views'?'selected':'' %>>Most Views</option>
            </select>
            <a href="/admin/tutorials/new" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm px-4 py-2.5 rounded-lg transition shadow-sm flex items-center space-x-2 shrink-0">
              <i class="fa-solid fa-plus text-xs"></i><span>Add Tutorial</span>
            </a>
          </div>
        </form>

        <div class="overflow-x-auto w-full">
          <table class="w-full text-left border-collapse whitespace-nowrap min-w-[1100px]">
            <thead>
              <tr class="bg-slate-50/80 border-b border-slate-200 text-[11px] uppercase tracking-wider text-slate-500 font-bold">
                <th class="py-3.5 px-4 w-10 text-center"><input type="checkbox"></th>
                <th class="py-3.5 px-2 w-10">#</th>
                <th class="py-3.5 px-4 w-36">Thumbnail</th>
                <th class="py-3.5 px-4">Title</th>
                <th class="py-3.5 px-4">Subject</th>
                <th class="py-3.5 px-4">Year</th>
                <th class="py-3.5 px-4">Duration</th>
                <th class="py-3.5 px-4">Views</th>
                <th class="py-3.5 px-4">Status</th>
                <th class="py-3.5 px-4">Published On</th>
                <th class="py-3.5 px-4 text-center">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-[13px] text-slate-700 font-medium">
              <% tutorials.forEach((t, i) => { %>
                <tr class="hover:bg-slate-50/80 transition-colors">
                  <td class="py-3 px-4 text-center"><input type="checkbox"></td>
                  <td class="py-3 px-2 text-slate-400"><%= i+1 %></td>
                  <td class="py-3 px-4">
                    <div class="relative w-24 h-14 rounded-lg overflow-hidden shadow-sm shrink-0 bg-slate-200 flex items-center justify-center">
                      <% if (t.thumbnail_url) { %><img src="<%= t.thumbnail_url %>" class="w-full h-full object-cover"><% } else { %><i class="fa-solid fa-video text-slate-400"></i><% } %>
                      <div class="absolute bottom-1 right-1 bg-black/80 text-white text-[9px] font-bold px-1.5 py-0.5 rounded"><%= t.duration_minutes %>m</div>
                    </div>
                  </td>
                  <td class="py-3 px-4 font-bold text-slate-800"><%= t.title %></td>
                  <td class="py-3 px-4 text-slate-600"><%= t.subject_name || '—' %></td>
                  <td class="py-3 px-4 text-slate-600"><%= t.year ? t.year.replace('Year ','Y') : '—' %></td>
                  <td class="py-3 px-4 text-slate-600"><%= t.duration_minutes %> min</td>
                  <td class="py-3 px-4 text-slate-600 font-semibold"><%= t.views %></td>
                  <td class="py-3 px-4">
                    <% if (t.is_published) { %>
                    <span class="inline-flex items-center space-x-1.5 bg-emerald-50 border border-emerald-100 text-emerald-700 font-bold px-2.5 py-1 rounded-full text-[11px]"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span><span>Published</span></span>
                    <% } else { %>
                    <span class="inline-flex items-center space-x-1.5 bg-orange-50 border border-orange-100 text-orange-700 font-bold px-2.5 py-1 rounded-full text-[11px]"><span class="w-1.5 h-1.5 rounded-full bg-orange-500"></span><span>Draft</span></span>
                    <% } %>
                  </td>
                  <td class="py-3 px-4 text-slate-500"><%= new Date(t.created_at).toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'}) %></td>
                  <td class="py-3 px-4 text-center">
                    <div class="flex items-center justify-center space-x-2">
                      <a href="/admin/tutorials/<%= t.id %>/assign" class="bg-blue-50 border border-blue-200 text-blue-600 hover:bg-blue-100 font-semibold text-xs px-3 py-1.5 rounded-lg transition shadow-sm">Assign to Students</a>
                      <a href="/admin/tutorials/<%= t.id %>/edit" class="w-7 h-7 rounded border border-slate-200 text-slate-500 hover:bg-slate-100 flex items-center justify-center transition" title="Edit"><i class="fa-solid fa-pen text-xs"></i></a>
                      <a href="/admin/tutorials/<%= t.id %>/comments" class="w-7 h-7 rounded border border-slate-200 text-slate-500 hover:bg-slate-100 flex items-center justify-center transition" title="Comments"><i class="fa-regular fa-comments text-xs"></i></a>
                      <form method="post" action="/admin/tutorials/<%= t.id %>/toggle"><button class="w-7 h-7 rounded border border-slate-200 text-slate-500 hover:bg-slate-100 flex items-center justify-center transition" title="<%= t.is_published ? 'Unpublish' : 'Publish' %>"><i class="fa-solid <%= t.is_published ? 'fa-eye-slash' : 'fa-eye' %> text-xs"></i></button></form>
                      <form method="post" action="/admin/tutorials/<%= t.id %>/delete" onsubmit="return confirm('Delete this tutorial?');"><button class="w-7 h-7 rounded border border-red-100 text-red-500 hover:bg-red-50 flex items-center justify-center transition" title="Delete"><i class="fa-solid fa-trash text-xs"></i></button></form>
                    </div>
                  </td>
                </tr>
              <% }) %>
              <% if (!tutorials.length) { %><tr><td colspan="11" class="py-6 px-4 text-slate-400 text-center">No tutorials found. Click "Add Tutorial" to create one.</td></tr><% } %>
            </tbody>
          </table>
        </div>
        <p class="p-4 text-xs text-slate-500 border-t border-slate-200">Showing <%= tutorials.length %> of <%= stats.total %> tutorials</p>
      </div>

      <% if (featured.length) { %>
      <div class="space-y-4 pt-2">
        <h2 class="text-lg font-bold text-[#091e42]">Featured Tutorials</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
          <% featured.forEach(t => { %>
            <div class="bg-white rounded-xl border border-slate-200 p-3 card-shadow flex flex-col justify-between">
              <div class="relative w-full h-32 rounded-lg overflow-hidden mb-3 bg-slate-200 flex items-center justify-center">
                <% if (t.thumbnail_url) { %><img src="<%= t.thumbnail_url %>" class="w-full h-full object-cover"><% } else { %><i class="fa-solid fa-video text-slate-400 text-2xl"></i><% } %>
                <div class="absolute bottom-2 right-2 bg-black/80 text-white text-[10px] font-bold px-1.5 py-0.5 rounded"><%= t.duration_minutes %>m</div>
              </div>
              <div><h4 class="font-bold text-slate-800 text-[13px] leading-snug line-clamp-1"><%= t.title %></h4><p class="text-xs text-slate-500 mt-0.5"><%= t.subject_name || '—' %></p></div>
            </div>
          <% }) %>
        </div>
      </div>
      <% } %>

    </div>
  </main>
</div>
<%- include('../partials/tw_scripts') %>
</body>
</html>
