<%- include('../partials/header', { title: 'MCQ Bank' }) %>
<div class="nav-tabs">
  <a href="/admin/dashboard">Dashboard</a>
  <a href="/admin/subjects">Subjects</a>
  <a href="/admin/mcq-plans">MCQ Plans</a>
  <a class="active" href="/admin/mcqs">MCQ Bank</a>
  <a href="/admin/papers">Exam Papers</a>
  <a href="/admin/submissions">Submissions</a>
</div>
<div class="card">
  <h3>Add MCQ (add as many as you want)</h3>
  <form method="post" action="/admin/mcqs">
    <div class="grid grid-2">
      <div><label>Subject</label>
        <select name="subject_id" required><% subjects.forEach(s=>{ %><option value="<%= s.id %>"><%= s.name %> (<%= s.year %>)</option><% }) %></select>
      </div>
      <div><label>Year</label><select name="year"><option>Year 11</option><option>Year 12</option></select></div>
    </div>
    <label>Topic</label><input type="text" name="topic">
    <label>Question</label><textarea name="question" required></textarea>
    <div class="grid grid-2">
      <div><label>Option A</label><input name="option_a" required></div>
      <div><label>Option B</label><input name="option_b" required></div>
      <div><label>Option C</label><input name="option_c" required></div>
      <div><label>Option D</label><input name="option_d" required></div>
    </div>
    <label>Correct Option</label>
    <select name="correct_option"><option>A</option><option>B</option><option>C</option><option>D</option></select>
    <button class="btn" type="submit">Add MCQ</button>
  </form>
</div>
<div class="card">
  <h3>Recent MCQs</h3>
  <table><tr><th>Subject</th><th>Question</th><th>Correct</th></tr>
    <% mcqs.forEach(m => { %><tr><td><%= m.subject_name %></td><td><%= m.question %></td><td><%= m.correct_option %></td></tr><% }) %>
  </table>
</div>
<%- include('../partials/footer') %>
