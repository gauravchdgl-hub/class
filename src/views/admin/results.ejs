<!DOCTYPE html>
<html lang="en" class="h-full bg-[#f4f6fa]">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Results Dashboard — AUS Academy</title>
<link rel="stylesheet" href="/assets/tailwind.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<%- include('../partials/tw_head_styles') %>
</head>
<body class="h-full antialiased flex flex-col text-slate-800">
<div class="flex flex-1 min-h-screen overflow-hidden">
  <%- include('../partials/tw_sidebar', { active: 'results' }) %>
  <main class="flex-1 flex flex-col min-w-0 overflow-y-auto">
    <%- include('../partials/tw_header', { searchPlaceholder: 'Search students, subjects, exam papers...' }) %>

    <div class="p-4 sm:p-6 lg:p-8 max-w-[1700px] mx-auto w-full flex-1 space-y-6">

      <!-- Page Title & Export -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="flex items-start space-x-4">
          <div class="w-10 h-10 rounded-xl bg-blue-600/10 text-blue-600 flex items-center justify-center shrink-0 mt-0.5">
            <i class="fa-solid fa-chart-pie text-xl"></i>
          </div>
          <div>
            <h1 class="text-2xl sm:text-[28px] font-bold text-[#091e42] tracking-tight">Results</h1>
            <p class="text-[13px] text-slate-500 mt-0.5">View student performance, marks, and detailed analysis.</p>
          </div>
        </div>
        <div class="flex items-center justify-between md:justify-end gap-4">
          <nav class="hidden xl:flex text-[13px] text-slate-500 space-x-2 font-medium">
            <a href="/admin/dashboard" class="hover:text-blue-600 transition">Home</a>
            <span class="text-slate-400">&gt;</span>
            <span class="text-[#091e42] font-semibold">Results</span>
          </nav>
          <a href="/admin/results/export?<%= new URLSearchParams(filters).toString() %>" class="bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs sm:text-sm px-5 py-2.5 rounded-xl transition shadow-md shadow-blue-600/30 flex items-center space-x-2">
            <i class="fa-solid fa-download text-xs"></i><span>Export Results</span>
          </a>
        </div>
      </div>

      <!-- Filter Toolbar -->
      <form method="get" class="bg-white rounded-xl border border-slate-200 p-4 shadow-sm grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-7 gap-3 text-xs items-end">
        <div>
          <label class="block font-semibold text-slate-600 mb-1">Subject</label>
          <select name="subject_id" class="custom-select w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-blue-500">
            <option value="">All Subjects</option>
            <% subjects.forEach(s => { %><option value="<%= s.id %>" <%= String(filters.subject_id)===String(s.id)?'selected':'' %>><%= s.name %> (<%= s.year %>)</option><% }) %>
          </select>
        </div>
        <div>
          <label class="block font-semibold text-slate-600 mb-1">Year Level</label>
          <select name="year" class="custom-select w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-blue-500">
            <option value="">All Years</option>
            <option value="Year 11" <%= filters.year==='Year 11'?'selected':'' %>>Year 11</option>
            <option value="Year 12" <%= filters.year==='Year 12'?'selected':'' %>>Year 12</option>
          </select>
        </div>
        <div>
          <label class="block font-semibold text-slate-600 mb-1">Class</label>
          <input type="text" name="class_name" value="<%= filters.class_name || '' %>" placeholder="e.g. 12A" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>
        <div>
          <label class="block font-semibold text-slate-600 mb-1">Exam Paper</label>
          <select name="paper_id" class="custom-select w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-blue-500">
            <option value="">All Exam Papers</option>
            <% papers.forEach(p => { %><option value="<%= p.id %>" <%= String(filters.paper_id)===String(p.id)?'selected':'' %>><%= p.title %></option><% }) %>
          </select>
        </div>
        <div>
          <label class="block font-semibold text-slate-600 mb-1">Student</label>
          <select name="student_id" class="custom-select w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-blue-500">
            <option value="">All Students</option>
            <% students.forEach(s => { %><option value="<%= s.id %>" <%= String(filters.student_id)===String(s.id)?'selected':'' %>><%= s.name %> (<%= s.year %>)</option><% }) %>
          </select>
        </div>
        <div>
          <label class="block font-semibold text-slate-600 mb-1">Date Range</label>
          <div class="grid grid-cols-2 gap-1.5">
            <input type="date" name="date_from" value="<%= filters.date_from || '' %>" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-2 py-2 text-slate-700 font-medium text-[11px] focus:outline-none focus:ring-2 focus:ring-blue-500">
            <input type="date" name="date_to" value="<%= filters.date_to || '' %>" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-2 py-2 text-slate-700 font-medium text-[11px] focus:outline-none focus:ring-2 focus:ring-blue-500">
          </div>
        </div>
        <div>
          <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-lg transition shadow-sm flex items-center justify-center space-x-1.5 h-[38px]">
            <span>Apply Filters</span>
          </button>
        </div>
      </form>

      <!-- 6 KPI Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-4">
        <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-sm flex items-center justify-between">
          <div>
            <span class="text-[11px] font-semibold text-slate-500 block mb-1">Total Students</span>
            <h3 class="text-2xl font-bold text-[#091e42]"><%= kpi.totalStudents %></h3>
          </div>
          <div class="w-11 h-11 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-lg shrink-0"><i class="fa-solid fa-users"></i></div>
        </div>
        <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-sm flex items-center justify-between">
          <div>
            <span class="text-[11px] font-semibold text-slate-500 block mb-1">Total Submissions</span>
            <h3 class="text-2xl font-bold text-[#091e42]"><%= kpi.totalSubmissions %></h3>
          </div>
          <div class="w-11 h-11 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center text-lg shrink-0"><i class="fa-solid fa-file-lines"></i></div>
        </div>
        <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-sm flex items-center justify-between">
          <div>
            <span class="text-[11px] font-semibold text-slate-500 block mb-1">Average Score</span>
            <h3 class="text-2xl font-bold text-emerald-600"><%= kpi.avgScore %>%</h3>
          </div>
          <div class="w-11 h-11 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-lg shrink-0"><i class="fa-solid fa-chart-line"></i></div>
        </div>
        <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-sm flex items-center justify-between">
          <div>
            <span class="text-[11px] font-semibold text-slate-500 block mb-1">Highest Score</span>
            <h3 class="text-2xl font-bold text-[#091e42]"><%= kpi.highest ? kpi.highest.percentage : 0 %>%</h3>
            <span class="text-[10px] text-slate-400 mt-1 block truncate max-w-[110px]"><%= kpi.highest ? kpi.highest.student_name : '—' %></span>
          </div>
          <div class="w-11 h-11 rounded-xl bg-amber-50 text-amber-500 flex items-center justify-center text-lg shrink-0"><i class="fa-solid fa-trophy"></i></div>
        </div>
        <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-sm flex items-center justify-between">
          <div>
            <span class="text-[11px] font-semibold text-slate-500 block mb-1">Lowest Score</span>
            <h3 class="text-2xl font-bold text-rose-600"><%= kpi.lowest ? kpi.lowest.percentage : 0 %>%</h3>
            <span class="text-[10px] text-slate-400 mt-1 block truncate max-w-[110px]"><%= kpi.lowest ? kpi.lowest.student_name : '—' %></span>
          </div>
          <div class="w-11 h-11 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center text-lg shrink-0"><i class="fa-solid fa-chart-pie"></i></div>
        </div>
        <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-sm flex items-center justify-between">
          <div>
            <span class="text-[11px] font-semibold text-slate-500 block mb-1">Pass Rate</span>
            <h3 class="text-2xl font-bold text-blue-600"><%= kpi.passRate %>%</h3>
            <span class="text-[10px] text-slate-400 mt-1 block"><%= kpi.passedCount %> of <%= kpi.totalSubmissions %> results</span>
          </div>
          <div class="w-11 h-11 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-lg shrink-0"><i class="fa-solid fa-circle-check"></i></div>
        </div>
      </div>

      <!-- Charts: Overall Performance + Section-wise -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        <div class="lg:col-span-8 bg-white rounded-xl border border-slate-200 p-5 shadow-sm space-y-4">
          <div class="flex items-center justify-between border-b border-slate-100 pb-3">
            <div class="flex items-center space-x-2">
              <i class="fa-solid fa-chart-line text-blue-600"></i>
              <h3 class="font-bold text-sm text-[#091e42]">Overall Performance</h3>
            </div>
            <div class="flex items-center space-x-4 text-xs font-semibold">
              <div class="flex items-center space-x-1.5">
                <span class="w-3 h-3 rounded-full bg-blue-500 inline-block"></span>
                <span class="text-slate-600">Average Score</span>
              </div>
            </div>
          </div>
          <div class="h-[280px] w-full relative">
            <% if (chart.monthLabels.length) { %>
            <canvas id="overallPerformanceChart"></canvas>
            <% } else { %>
            <div class="h-full flex items-center justify-center text-slate-400 text-sm">No submitted results yet for this filter.</div>
            <% } %>
          </div>
        </div>

        <div class="lg:col-span-4 bg-white rounded-xl border border-slate-200 p-5 shadow-sm space-y-4">
          <div class="flex items-center justify-between border-b border-slate-100 pb-3">
            <div class="flex items-center space-x-2">
              <i class="fa-solid fa-chart-pie text-blue-600"></i>
              <h3 class="font-bold text-sm text-[#091e42]">Section-wise Performance</h3>
            </div>
          </div>
          <div class="grid grid-cols-3 gap-2 pt-2 text-center">
            <div class="space-y-2">
              <div class="relative w-20 h-20 mx-auto flex items-center justify-center">
                <canvas id="sectionAChart" width="80" height="80"></canvas>
                <span class="absolute text-xs font-bold text-slate-800"><%= sectionA.pct %>%</span>
              </div>
              <div>
                <h4 class="font-bold text-xs text-slate-800">Section A</h4>
                <span class="text-[10px] text-slate-400 block">MCQs</span>
                <span class="text-[10px] font-semibold text-slate-600 mt-0.5 block">Avg. <%= sectionA.total ? Math.round(sectionA.score / (kpi.totalSubmissions || 1)) : 0 %>/<%= kpi.totalSubmissions ? Math.round(sectionA.total / kpi.totalSubmissions) : 0 %></span>
              </div>
            </div>
            <div class="space-y-2">
              <div class="relative w-20 h-20 mx-auto flex items-center justify-center">
                <canvas id="sectionBChart" width="80" height="80"></canvas>
                <span class="absolute text-xs font-bold text-slate-800"><%= sectionB.pct %>%</span>
              </div>
              <div>
                <h4 class="font-bold text-xs text-slate-800">Section B</h4>
                <span class="text-[10px] text-slate-400 block">Written</span>
                <span class="text-[10px] font-semibold text-slate-600 mt-0.5 block">Avg. <%= sectionB.total ? Math.round(sectionB.score / (kpi.totalSubmissions || 1)) : 0 %>/<%= kpi.totalSubmissions ? Math.round(sectionB.total / kpi.totalSubmissions) : 0 %></span>
              </div>
            </div>
            <div class="space-y-2">
              <div class="relative w-20 h-20 mx-auto flex items-center justify-center">
                <canvas id="sectionCChart" width="80" height="80"></canvas>
                <span class="absolute text-xs font-bold text-slate-800"><%= sectionC.pct %>%</span>
              </div>
              <div>
                <h4 class="font-bold text-xs text-slate-800">Section C</h4>
                <span class="text-[10px] text-slate-400 block">Essay</span>
                <span class="text-[10px] font-semibold text-slate-600 mt-0.5 block">Avg. <%= sectionC.total ? Math.round(sectionC.score / (kpi.totalSubmissions || 1)) : 0 %>/<%= kpi.totalSubmissions ? Math.round(sectionC.total / kpi.totalSubmissions) : 0 %></span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Three-Column Analytics: Top Performers / Score Distribution / Subject-wise Average -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
        <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-sm space-y-4">
          <div class="flex items-center justify-between border-b border-slate-100 pb-3">
            <div class="flex items-center space-x-2">
              <i class="fa-solid fa-trophy text-amber-500"></i>
              <h3 class="font-bold text-sm text-[#091e42]">Top Performers</h3>
            </div>
          </div>
          <div class="space-y-3">
            <% if (!topPerformers.length) { %>
              <p class="text-xs text-slate-400 text-center py-4">No results yet.</p>
            <% } %>
            <% topPerformers.forEach((p, i) => {
                 const initials = p.student_name.split(' ').map(w => w[0]).slice(0, 2).join('').toUpperCase();
                 const rankBg = i===0 ? 'bg-amber-100 text-amber-700' : i===1 ? 'bg-slate-200 text-slate-700' : i===2 ? 'bg-amber-700/10 text-amber-800' : 'bg-slate-100 text-slate-600';
            %>
              <div class="flex items-center justify-between p-2.5 rounded-lg bg-slate-50 border border-slate-100">
                <div class="flex items-center space-x-3">
                  <span class="w-6 h-6 rounded-full <%= rankBg %> font-bold text-xs flex items-center justify-center"><%= i + 1 %></span>
                  <div class="w-9 h-9 rounded-full bg-blue-600 text-white flex items-center justify-center font-bold text-xs shrink-0"><%= initials %></div>
                  <div>
                    <h4 class="font-bold text-xs text-slate-900 leading-tight"><%= p.student_name %></h4>
                    <span class="text-[10px] text-slate-400">STU-<%= String(p.student_id).padStart(3, '0') %></span>
                  </div>
                </div>
                <span class="font-bold text-sm text-emerald-600"><%= p.percentage %>%</span>
              </div>
            <% }) %>
          </div>
        </div>

        <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-sm space-y-4">
          <div class="flex items-center justify-between border-b border-slate-100 pb-3">
            <div class="flex items-center space-x-2">
              <i class="fa-solid fa-chart-column text-blue-600"></i>
              <h3 class="font-bold text-sm text-[#091e42]">Score Distribution</h3>
            </div>
          </div>
          <div class="h-[265px]">
            <canvas id="scoreDistributionChart"></canvas>
          </div>
        </div>

        <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-sm space-y-4">
          <div class="flex items-center justify-between border-b border-slate-100 pb-3">
            <div class="flex items-center space-x-2">
              <i class="fa-solid fa-book-open text-blue-600"></i>
              <h3 class="font-bold text-sm text-[#091e42]">Subject-wise Average</h3>
            </div>
          </div>
          <div class="space-y-3.5 pt-1 text-xs">
            <% if (!subjectAverages.length) { %><p class="text-slate-400 text-center py-4">No results yet.</p><% } %>
            <% const barColors = ['bg-blue-600','bg-purple-600','bg-emerald-500','bg-rose-500','bg-amber-500']; %>
            <% subjectAverages.forEach((s, i) => { %>
              <div class="space-y-1">
                <div class="flex justify-between font-semibold text-slate-700">
                  <span><%= s.name %></span>
                  <span class="text-slate-900 font-bold"><%= s.avg %>%</span>
                </div>
                <div class="w-full bg-slate-100 rounded-full h-2.5 overflow-hidden">
                  <div class="<%= barColors[i % barColors.length] %> h-2.5 rounded-full" style="width: <%= s.avg %>%"></div>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      </div>

      <!-- Results Data Table -->
      <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden space-y-4">
        <div class="p-4 border-b border-slate-200 flex flex-col lg:flex-row items-center justify-between gap-4">
          <div class="flex flex-wrap items-center gap-1.5 text-xs font-semibold w-full lg:w-auto">
            <% function tabUrl(t) { const p = new URLSearchParams(filters); p.set('tab', t); p.delete('page'); return '?' + p.toString(); } %>
            <a href="<%= tabUrl('all') %>" class="px-4 py-2 rounded-lg shadow-sm transition <%= tab==='all'?'bg-blue-600 text-white':'bg-slate-100 hover:bg-slate-200 text-slate-700' %>">All Results (<%= tabCounts.all %>)</a>
            <a href="<%= tabUrl('sectionA') %>" class="px-4 py-2 rounded-lg transition <%= tab==='sectionA'?'bg-blue-600 text-white':'bg-slate-100 hover:bg-slate-200 text-slate-700' %>">Section A - MCQs (<%= tabCounts.sectionA %>)</a>
            <a href="<%= tabUrl('sectionB') %>" class="px-4 py-2 rounded-lg transition <%= tab==='sectionB'?'bg-blue-600 text-white':'bg-slate-100 hover:bg-slate-200 text-slate-700' %>">Section B - Written (<%= tabCounts.sectionB %>)</a>
            <a href="<%= tabUrl('sectionC') %>" class="px-4 py-2 rounded-lg transition <%= tab==='sectionC'?'bg-blue-600 text-white':'bg-slate-100 hover:bg-slate-200 text-slate-700' %>">Section C - Long Answer (<%= tabCounts.sectionC %>)</a>
            <a href="<%= tabUrl('bySubject') %>" class="px-4 py-2 rounded-lg transition <%= tab==='bySubject'?'bg-blue-600 text-white':'bg-slate-100 hover:bg-slate-200 text-slate-700' %>">By Subject</a>
            <a href="<%= tabUrl('byClass') %>" class="px-4 py-2 rounded-lg transition <%= tab==='byClass'?'bg-blue-600 text-white':'bg-slate-100 hover:bg-slate-200 text-slate-700' %>">By Class</a>
          </div>
          <div class="flex items-center space-x-2.5 w-full lg:w-auto justify-end">
            <a href="/admin/results/export?<%= new URLSearchParams(filters).toString() %>" class="bg-white hover:bg-slate-50 text-slate-700 border border-slate-300 font-semibold text-xs px-3.5 py-2 rounded-lg transition shadow-sm flex items-center space-x-1.5">
              <i class="fa-solid fa-download text-xs"></i><span>Export</span>
            </a>
            <button type="button" onclick="toggleColumnPicker()" class="bg-white hover:bg-slate-50 text-slate-700 border border-slate-300 font-semibold text-xs px-3.5 py-2 rounded-lg transition shadow-sm flex items-center space-x-1.5 relative">
              <i class="fa-solid fa-columns text-xs"></i><span>Columns</span>
            </button>
          </div>
        </div>

        <!-- Column visibility picker -->
        <div id="columnPicker" class="hidden px-4 pb-2 flex flex-wrap gap-3 text-[11px] font-semibold text-slate-600">
          <label class="flex items-center gap-1"><input type="checkbox" checked data-col="col-year" onchange="toggleCol(this)"> Year</label>
          <label class="flex items-center gap-1"><input type="checkbox" checked data-col="col-class" onchange="toggleCol(this)"> Class</label>
          <label class="flex items-center gap-1"><input type="checkbox" checked data-col="col-sections" onchange="toggleCol(this)"> Sections</label>
          <label class="flex items-center gap-1"><input type="checkbox" checked data-col="col-submitted" onchange="toggleCol(this)"> Submitted On</label>
        </div>

        <!-- Search -->
        <div class="px-4">
          <form method="get" class="relative max-w-md">
            <% Object.keys(filters).forEach(k => { if (k !== 'q') { %><input type="hidden" name="<%= k %>" value="<%= filters[k] %>"><% } }) %>
            <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
            <input type="text" name="q" value="<%= filters.q || '' %>" placeholder="Search by student name, exam paper, or subject..." class="w-full bg-slate-50 border border-slate-200 rounded-lg pl-9 pr-3 py-2 text-xs text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-blue-500">
          </form>
        </div>

        <!-- Table -->
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse text-xs">
            <thead>
              <tr class="bg-slate-50/80 border-y border-slate-200 text-slate-600 font-bold uppercase tracking-wider text-[11px]">
                <th class="p-3.5 w-12">#</th>
                <th class="p-3.5">Student</th>
                <th class="p-3.5">Exam Paper</th>
                <th class="p-3.5">Subject</th>
                <th class="p-3.5 col-year">Year</th>
                <th class="p-3.5 col-class">Class</th>
                <th class="p-3.5 text-center col-sections">Sections (A / B / C)</th>
                <th class="p-3.5">Total / Max</th>
                <th class="p-3.5">Percentage</th>
                <th class="p-3.5">Result</th>
                <th class="p-3.5 col-submitted">Submitted On</th>
                <th class="p-3.5 text-center">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 font-medium text-slate-700">
              <%
                function renderRow(r, i) {
                  const initials = r.student_name.split(' ').map(w => w[0]).slice(0, 2).join('').toUpperCase();
              %>
                <tr class="hover:bg-slate-50/80 transition">
                  <td class="p-3.5 text-slate-500"><%= i + 1 %></td>
                  <td class="p-3.5">
                    <div class="flex items-center space-x-2.5">
                      <div class="w-8 h-8 rounded-full bg-blue-600 text-white flex items-center justify-center font-bold text-[11px] shrink-0"><%= initials %></div>
                      <div>
                        <span class="block font-bold text-slate-900 leading-tight"><%= r.student_name %></span>
                        <span class="text-[10px] text-slate-400">STU-<%= String(r.student_id).padStart(3, '0') %></span>
                      </div>
                    </div>
                  </td>
                  <td class="p-3.5 font-semibold text-slate-800"><%= r.title %></td>
                  <td class="p-3.5"><span class="bg-blue-50 text-blue-700 border border-blue-200 px-2 py-0.5 rounded-md font-semibold text-[11px]"><%= r.subject_name || '—' %></span></td>
                  <td class="p-3.5 col-year"><%= (r.year || '').replace('Year ', '') || '—' %></td>
                  <td class="p-3.5 col-class"><%= r.class_name || '—' %></td>
                  <td class="p-3.5 text-center col-sections">
                    <div class="inline-flex items-center space-x-1 bg-slate-100 px-2 py-1 rounded-md text-[11px] font-bold">
                      <span class="text-blue-600"><%= r.mcq_score %>/<%= r.mcq_total %></span>
                      <span class="text-slate-300">/</span>
                      <span class="text-purple-600"><%= r.written_score %>/<%= r.written_total %></span>
                      <span class="text-slate-300">/</span>
                      <span class="text-emerald-600"><%= r.essay_score %>/<%= r.essay_total %></span>
                    </div>
                  </td>
                  <td class="p-3.5 font-bold text-slate-900"><%= r.total_score %> / <%= r.total_marks %></td>
                  <td class="p-3.5 font-bold <%= r.passed ? 'text-emerald-600' : 'text-rose-600' %>"><%= r.percentage %>%</td>
                  <td class="p-3.5">
                    <% if (r.passed) { %><span class="bg-emerald-50 text-emerald-700 border border-emerald-200 px-2.5 py-0.5 rounded-full font-bold text-[10px]">Pass</span>
                    <% } else { %><span class="bg-rose-50 text-rose-700 border border-rose-200 px-2.5 py-0.5 rounded-full font-bold text-[10px]">Fail</span><% } %>
                  </td>
                  <td class="p-3.5 text-slate-600 col-submitted"><% if (r.submitted_at) { const d = new Date(r.submitted_at); %><%= d.toLocaleDateString('en-AU', { day: '2-digit', month: 'short', year: 'numeric' }) %><br><span class="text-[10px] text-slate-400"><%= d.toLocaleTimeString('en-AU', { hour: '2-digit', minute: '2-digit' }) %></span><% } else { %>—<% } %></td>
                  <td class="p-3.5 text-center">
                    <a href="/admin/submissions/<%= r.id %>/review" class="p-1.5 text-blue-600 hover:bg-blue-50 rounded-lg transition inline-block" title="View"><i class="fa-regular fa-eye text-sm"></i></a>
                  </td>
                </tr>
              <% } %>

              <% if (groupBy === 'subject') {
                   const groups = {};
                   allGroupedRows.forEach(r => { const k = r.subject_name || 'Unknown'; (groups[k] = groups[k] || []).push(r); });
                   const keys = Object.keys(groups).sort();
                   if (!keys.length) { %><tr><td colspan="12" class="p-6 text-center text-slate-400">No results match these filters.</td></tr><% }
                   keys.forEach(k => { %>
                     <tr class="bg-slate-50"><td colspan="12" class="p-2.5 font-bold text-slate-700 text-xs"><%= k %> (<%= groups[k].length %>)</td></tr>
                     <% groups[k].forEach((r, i) => { renderRow(r, i); }) %>
                   <% })
                 } else if (groupBy === 'class') {
                   const groups = {};
                   allGroupedRows.forEach(r => { const k = r.class_name || 'Unassigned'; (groups[k] = groups[k] || []).push(r); });
                   const keys = Object.keys(groups).sort();
                   if (!keys.length) { %><tr><td colspan="12" class="p-6 text-center text-slate-400">No results match these filters.</td></tr><% }
                   keys.forEach(k => { %>
                     <tr class="bg-slate-50"><td colspan="12" class="p-2.5 font-bold text-slate-700 text-xs"><%= k %> (<%= groups[k].length %>)</td></tr>
                     <% groups[k].forEach((r, i) => { renderRow(r, i); }) %>
                   <% })
                 } else {
                   if (!tableRows.length) { %><tr><td colspan="12" class="p-6 text-center text-slate-400">No results match these filters.</td></tr><% }
                   tableRows.forEach((r, i) => { renderRow(r, (pagination.page - 1) * pagination.pageSize + i); })
                 }
              %>
            </tbody>
          </table>
        </div>

        <!-- Pagination -->
        <% if (!groupBy) { %>
        <div class="px-5 py-4 bg-slate-50 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-500 font-medium">
          <span>Showing <%= pagination.totalRows === 0 ? 0 : ((pagination.page - 1) * pagination.pageSize + 1) %> to <%= Math.min(pagination.page * pagination.pageSize, pagination.totalRows) %> of <%= pagination.totalRows %> results</span>
          <% function pageUrl(p) { const q = new URLSearchParams(filters); q.set('tab', tab); q.set('page', p); return '?' + q.toString(); } %>
          <div class="flex items-center space-x-1">
            <a href="<%= pageUrl(Math.max(1, pagination.page - 1)) %>" class="w-8 h-8 rounded-lg border border-slate-200 bg-white flex items-center justify-center text-slate-500 hover:bg-slate-100 transition"><i class="fa-solid fa-chevron-left text-[10px]"></i></a>
            <% for (let p = 1; p <= pagination.totalPages; p++) {
                 if (p === 1 || p === pagination.totalPages || Math.abs(p - pagination.page) <= 2) { %>
                   <a href="<%= pageUrl(p) %>" class="w-8 h-8 rounded-lg <%= p===pagination.page ? 'bg-blue-600 text-white font-bold shadow-sm' : 'border border-slate-200 bg-white hover:bg-slate-100 text-slate-700' %> flex items-center justify-center transition"><%= p %></a>
            <% } else if (p === pagination.page - 3 || p === pagination.page + 3) { %>
              <span class="px-2 text-slate-400">...</span>
            <% } } %>
            <a href="<%= pageUrl(Math.min(pagination.totalPages, pagination.page + 1)) %>" class="w-8 h-8 rounded-lg border border-slate-200 bg-white hover:bg-slate-100 text-slate-700 flex items-center justify-center transition"><i class="fa-solid fa-chevron-right text-[10px]"></i></a>
          </div>
        </div>
        <% } %>
      </div>

      <footer class="pt-6 pb-4 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 font-medium">
        <p>&copy; 2026 AUS Academy. All rights reserved.</p>
      </footer>
    </div>
  </main>
</div>
<%- include('../partials/tw_scripts') %>
<script>
  function toggleColumnPicker() {
    document.getElementById('columnPicker').classList.toggle('hidden');
  }
  function toggleCol(cb) {
    document.querySelectorAll('.' + cb.dataset.col).forEach(el => el.classList.toggle('hidden', !cb.checked));
  }
  window.addEventListener('DOMContentLoaded', () => {
    <% if (chart.monthLabels.length) { %>
    new Chart(document.getElementById('overallPerformanceChart').getContext('2d'), {
      type: 'line',
      data: {
        labels: <%- JSON.stringify(chart.monthLabels) %>,
        datasets: [{
          label: 'Average Score',
          data: <%- JSON.stringify(chart.monthAverages) %>,
          borderColor: '#2563eb',
          backgroundColor: 'rgba(37, 99, 235, 0.05)',
          borderWidth: 3, fill: true, tension: 0.35, pointRadius: 4, pointBackgroundColor: '#2563eb'
        }]
      },
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { display: false }, tooltip: { mode: 'index', intersect: false } },
        scales: {
          y: { min: 0, max: 100, ticks: { callback: v => v + '%', font: { size: 11 } }, grid: { color: '#f1f5f9' } },
          x: { grid: { display: false }, ticks: { font: { size: 11 } } }
        }
      }
    });
    <% } %>

    function createDoughnut(canvasId, value, color) {
      new Chart(document.getElementById(canvasId).getContext('2d'), {
        type: 'doughnut',
        data: { datasets: [{ data: [value, 100 - value], backgroundColor: [color, '#f1f5f9'], borderWidth: 0 }] },
        options: { responsive: false, cutout: '75%', plugins: { legend: { display: false }, tooltip: { enabled: false } } }
      });
    }
    createDoughnut('sectionAChart', <%= sectionA.pct %>, '#2563eb');
    createDoughnut('sectionBChart', <%= sectionB.pct %>, '#f59e0b');
    createDoughnut('sectionCChart', <%= sectionC.pct %>, '#ec4899');

    new Chart(document.getElementById('scoreDistributionChart').getContext('2d'), {
      type: 'bar',
      data: {
        labels: ['0-20', '21-40', '41-60', '61-80', '81-100'],
        datasets: [{ data: <%- JSON.stringify(buckets) %>, backgroundColor: ['#f43f5e', '#f97316', '#eab308', '#3b82f6', '#10b981'], borderRadius: 6 }]
      },
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
          y: { min: 0, beginAtZero: true, grid: { color: '#f1f5f9' }, ticks: { font: { size: 11 }, precision: 0 } },
          x: { grid: { display: false }, ticks: { font: { size: 11 } } }
        }
      }
    });
  });
</script>
</body>
</html>
