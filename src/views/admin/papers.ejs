<!DOCTYPE html>
<html lang="en" class="h-full bg-[#f4f6fa]">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Full Exam Papers — AUS Academy</title>
<link rel="stylesheet" href="/assets/tailwind.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<%- include('../partials/tw_head_styles') %>
</head>
<body class="h-full antialiased flex flex-col text-slate-800">
<div class="flex flex-1 min-h-screen overflow-hidden">
  <%- include('../partials/tw_sidebar', { active: 'papers' }) %>
  <main class="flex-1 flex flex-col min-w-0 overflow-y-auto">
    <%- include('../partials/tw_header', { searchPlaceholder: 'Search students, subjects, exam papers, or anything...' }) %>

    <div class="p-4 sm:p-6 lg:p-8 max-w-[1700px] mx-auto w-full flex-1 space-y-6">

      <div class="flex flex-col md:flex-row md:items-start justify-between gap-4">
        <div>
          <h1 class="text-2xl sm:text-[28px] font-bold text-[#091e42] tracking-tight">Full Exam Papers</h1>
          <p class="text-[13px] text-slate-500 mt-1">Create, edit and manage all full exam papers, exam types, modules &amp; topics.</p>
        </div>
        <div class="flex items-center gap-3">
          <nav class="flex text-[13px] text-slate-500 space-x-2 font-medium pr-2">
            <a href="/admin/dashboard" class="hover:text-blue-600 transition">Home</a><span class="text-slate-400">&gt;</span>
            <span class="text-[#091e42] font-semibold">Full Exam Papers</span>
          </nav>
          <a href="/admin/papers/new" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs sm:text-sm px-4 py-2.5 rounded-lg transition shadow-md shadow-blue-600/30 flex items-center space-x-2">
            <i class="fa-solid fa-plus text-xs"></i><span>Add Exam Paper</span>
          </a>
        </div>
      </div>

      <% if (typeof success !== 'undefined' && success.length) { %><div class="bg-emerald-50 border border-emerald-200 text-emerald-700 text-xs font-semibold rounded-xl px-4 py-3"><%= success[0] %></div><% } %>
      <% if (typeof error !== 'undefined' && error.length) { %><div class="bg-rose-50 border border-rose-200 text-rose-700 text-xs font-semibold rounded-xl px-4 py-3"><%= error[0] %></div><% } %>

      <!-- Filters -->
      <form method="get" class="bg-white rounded-xl border border-slate-200 p-4 shadow-sm">
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 text-xs">
          <div>
            <label class="block font-semibold text-slate-500 mb-1">Subject</label>
            <select name="subject_id" onchange="this.form.submit()" class="custom-select w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-slate-700 font-medium">
              <option value="">All Subjects</option>
              <% subjects.forEach(s => { %><option value="<%= s.id %>" <%= String(filters.subject_id)===String(s.id)?'selected':'' %>><%= s.name %> (<%= s.year %>)</option><% }) %>
            </select>
          </div>
          <div>
            <label class="block font-semibold text-slate-500 mb-1">Year Level</label>
            <select name="year" onchange="this.form.submit()" class="custom-select w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-slate-700 font-medium">
              <option value="">All Years</option>
              <option value="Year 11" <%= filters.year==='Year 11'?'selected':'' %>>Year 11</option>
              <option value="Year 12" <%= filters.year==='Year 12'?'selected':'' %>>Year 12</option>
            </select>
          </div>
          <div>
            <label class="block font-semibold text-slate-500 mb-1">Class</label>
            <input type="text" name="class_name" value="<%= filters.class_name || '' %>" placeholder="e.g. 12A" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-slate-700 font-medium">
          </div>
          <div>
            <label class="block font-semibold text-slate-500 mb-1">Exam Type</label>
            <select name="exam_type_id" onchange="this.form.submit()" class="custom-select w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-slate-700 font-medium">
              <option value="">All Types</option>
              <% examTypes.forEach(t => { %><option value="<%= t.id %>" <%= String(filters.exam_type_id)===String(t.id)?'selected':'' %>><%= t.name %></option><% }) %>
            </select>
          </div>
          <div>
            <label class="block font-semibold text-slate-500 mb-1">Search</label>
            <div class="relative">
              <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
              <input type="text" name="q" value="<%= filters.q || '' %>" placeholder="Search exam papers..." class="w-full bg-slate-50 border border-slate-200 rounded-lg pl-9 pr-3 py-2 text-slate-800 font-medium">
            </div>
          </div>
        </div>
        <button type="submit" class="hidden"></button>
      </form>

      <!-- Papers Table -->
      <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-50 text-slate-500 font-semibold border-b border-slate-200 uppercase tracking-wider text-[10px]">
              <tr>
                <th class="p-3.5 w-12">#</th>
                <th class="p-3.5">Exam Paper Title</th>
                <th class="p-3.5">Subject</th>
                <th class="p-3.5">Year Level</th>
                <th class="p-3.5">Class</th>
                <th class="p-3.5">Type</th>
                <th class="p-3.5">Total Marks</th>
                <th class="p-3.5">Duration</th>
                <th class="p-3.5">Status</th>
                <th class="p-3.5 text-center">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-slate-700 font-medium">
              <% papers.forEach((p, i) => { %>
                <tr class="hover:bg-slate-50/80 transition-colors">
                  <td class="p-3.5 text-slate-400"><%= i + 1 %></td>
                  <td class="p-3.5 font-bold text-slate-900"><%= p.title %><% if (p.module_title) { %><br><span class="text-[10px] font-medium text-slate-400"><%= p.module_title %></span><% } %></td>
                  <td class="p-3.5"><span class="bg-blue-50 text-blue-700 px-2 py-0.5 rounded font-semibold"><%= p.subject_name %></span></td>
                  <td class="p-3.5 text-slate-600"><%= p.year || '—' %></td>
                  <td class="p-3.5 text-slate-600"><%= p.class_name || '—' %></td>
                  <td class="p-3.5 text-slate-600"><%= p.exam_type_name || '—' %></td>
                  <td class="p-3.5 font-bold text-slate-800"><%= p.total_marks %> <span class="text-slate-400 font-normal">(<%= p.question_count %> Qs)</span></td>
                  <td class="p-3.5 text-slate-600"><%= p.duration_minutes %> min</td>
                  <td class="p-3.5"><span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold <%= p.is_published ? 'bg-emerald-50 text-emerald-600' : 'bg-amber-50 text-amber-600' %>"><%= p.is_published ? 'Published' : 'Draft' %></span></td>
                  <td class="p-3.5 text-center whitespace-nowrap space-x-1">
                    <a href="/admin/papers/<%= p.slug %>" class="w-7 h-7 rounded bg-slate-50 hover:bg-blue-50 hover:text-blue-600 text-slate-500 transition inline-flex items-center justify-center" title="View / Edit"><i class="fa-solid fa-pen-to-square text-xs"></i></a>
                    <form method="post" action="/admin/papers/<%= p.slug %>/duplicate" class="inline"><button class="w-7 h-7 rounded bg-slate-50 hover:bg-indigo-50 hover:text-indigo-600 text-slate-500 transition inline-flex items-center justify-center" title="Duplicate"><i class="fa-regular fa-copy text-xs"></i></button></form>
                    <form method="post" action="/admin/papers/<%= p.slug %>/delete" class="inline" onsubmit="return confirm('Delete this exam paper and all its questions?');"><button class="w-7 h-7 rounded bg-slate-50 hover:bg-rose-50 hover:text-rose-600 text-slate-500 transition inline-flex items-center justify-center" title="Delete"><i class="fa-regular fa-trash-can text-xs"></i></button></form>
                  </td>
                </tr>
              <% }) %>
              <% if (!papers.length) { %><tr><td colspan="10" class="p-6 text-center text-slate-400">No exam papers match these filters.</td></tr><% } %>
            </tbody>
          </table>
        </div>
        <div class="px-6 py-4 bg-white border-t border-slate-200 text-xs text-slate-500 font-medium">Showing <%= papers.length %> paper(s)</div>
      </div>

      <!-- Manage Exam Types / Modules / Topics -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <!-- Manage Exam Types -->
        <div id="exam-types" class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden scroll-mt-24">
          <div class="p-4 border-b border-slate-100 flex items-center justify-between">
            <h3 class="font-bold text-sm text-[#091e42]">Manage Exam Types</h3>
            <button type="button" onclick="document.getElementById('examTypeForm').classList.toggle('hidden')" class="text-blue-600 hover:text-blue-700 font-semibold text-xs flex items-center space-x-1"><i class="fa-solid fa-plus text-[10px]"></i><span>Add Exam Type</span></button>
          </div>
          <form id="examTypeForm" method="post" action="/admin/exam-types/new" class="hidden p-4 border-b border-slate-100 space-y-2 bg-slate-50">
            <input name="name" required placeholder="Exam type name" class="form-input">
            <textarea name="description" placeholder="Description (optional)" rows="2" class="form-input"></textarea>
            <button class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs py-2 rounded-lg">Save</button>
          </form>
          <div class="p-3">
            <input type="text" oninput="filterTable(this,'examTypesTable')" placeholder="Search exam types..." class="w-full bg-slate-50 border border-slate-200 rounded-lg pl-3 pr-3 py-2 text-xs text-slate-800 font-medium">
          </div>
          <div class="overflow-x-auto max-h-[420px] overflow-y-auto">
            <table class="w-full text-left text-[11px]" id="examTypesTable">
              <thead class="bg-slate-50 text-slate-500 font-semibold border-b border-slate-200 uppercase tracking-wider text-[9px] sticky top-0">
                <tr><th class="p-2.5 w-8">#</th><th class="p-2.5">Exam Type Name</th><th class="p-2.5">Description</th><th class="p-2.5">Status</th><th class="p-2.5 text-center">Actions</th></tr>
              </thead>
              <tbody class="divide-y divide-slate-100 text-slate-700 font-medium">
                <% examTypes.forEach((t, i) => { %>
                  <tr>
                    <td class="p-2.5 text-slate-400"><%= i + 1 %></td>
                    <td class="p-2.5 font-bold text-slate-900"><%= t.name %></td>
                    <td class="p-2.5 text-slate-500 max-w-[140px] truncate" title="<%= t.description || '' %>"><%= t.description || '—' %></td>
                    <td class="p-2.5"><span class="px-2 py-0.5 rounded-full text-[9px] font-bold <%= t.is_active ? 'bg-emerald-50 text-emerald-600' : 'bg-slate-100 text-slate-500' %>"><%= t.is_active ? 'Active' : 'Inactive' %></span></td>
                    <td class="p-2.5 text-center whitespace-nowrap">
                      <button type="button" onclick="document.getElementById('editType<%= t.id %>').classList.toggle('hidden')" class="w-6 h-6 rounded bg-slate-50 hover:bg-blue-50 hover:text-blue-600 text-slate-500 inline-flex items-center justify-center"><i class="fa-solid fa-pen-to-square text-[10px]"></i></button>
                      <form method="post" action="/admin/exam-types/<%= t.id %>/delete" class="inline" onsubmit="return confirm('Delete this exam type?');"><button class="w-6 h-6 rounded bg-slate-50 hover:bg-rose-50 hover:text-rose-600 text-slate-500 inline-flex items-center justify-center"><i class="fa-regular fa-trash-can text-[10px]"></i></button></form>
                    </td>
                  </tr>
                  <tr id="editType<%= t.id %>" class="hidden bg-slate-50">
                    <td colspan="5" class="p-3">
                      <form method="post" action="/admin/exam-types/<%= t.id %>/edit" class="space-y-2">
                        <input name="name" value="<%= t.name %>" required class="form-input">
                        <textarea name="description" rows="2" class="form-input"><%= t.description || '' %></textarea>
                        <label class="flex items-center space-x-2 text-[11px] font-semibold text-slate-700"><input type="checkbox" name="is_active" <%= t.is_active ? 'checked' : '' %>><span>Active</span></label>
                        <button class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs py-2 rounded-lg">Save Changes</button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
                <% if (!examTypes.length) { %><tr><td colspan="5" class="p-4 text-center text-slate-400">None yet.</td></tr><% } %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Manage Modules -->
        <div id="modules" class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden scroll-mt-24">
          <div class="p-4 border-b border-slate-100 flex items-center justify-between">
            <h3 class="font-bold text-sm text-[#091e42]">Manage Modules</h3>
            <button type="button" onclick="document.getElementById('moduleForm').classList.toggle('hidden')" class="text-blue-600 hover:text-blue-700 font-semibold text-xs flex items-center space-x-1"><i class="fa-solid fa-plus text-[10px]"></i><span>Add Module</span></button>
          </div>
          <form id="moduleForm" method="post" action="/admin/exam-modules/new" class="hidden p-4 border-b border-slate-100 space-y-2 bg-slate-50">
            <select name="subject_id" required class="form-input custom-select"><option value="" disabled selected>Select subject</option><% subjects.forEach(s => { %><option value="<%= s.id %>"><%= s.name %> (<%= s.year %>)</option><% }) %></select>
            <input name="title" required placeholder="Module name" class="form-input">
            <div class="grid grid-cols-2 gap-2">
              <input name="year_level" placeholder="Year Level" class="form-input">
              <input name="class_name" placeholder="Class" class="form-input">
            </div>
            <textarea name="description" placeholder="Description (optional)" rows="2" class="form-input"></textarea>
            <button class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs py-2 rounded-lg">Save</button>
          </form>
          <div class="p-3">
            <input type="text" oninput="filterTable(this,'modulesTable')" placeholder="Search modules..." class="w-full bg-slate-50 border border-slate-200 rounded-lg pl-3 pr-3 py-2 text-xs text-slate-800 font-medium">
          </div>
          <div class="overflow-x-auto max-h-[420px] overflow-y-auto">
            <table class="w-full text-left text-[11px]" id="modulesTable">
              <thead class="bg-slate-50 text-slate-500 font-semibold border-b border-slate-200 uppercase tracking-wider text-[9px] sticky top-0">
                <tr><th class="p-2.5 w-8">#</th><th class="p-2.5">Module Name</th><th class="p-2.5">Subject</th><th class="p-2.5">Year Level</th><th class="p-2.5">Status</th><th class="p-2.5 text-center">Actions</th></tr>
              </thead>
              <tbody class="divide-y divide-slate-100 text-slate-700 font-medium">
                <% modules.forEach((m, i) => { %>
                  <tr>
                    <td class="p-2.5 text-slate-400"><%= i + 1 %></td>
                    <td class="p-2.5 font-bold text-slate-900"><%= m.title %></td>
                    <td class="p-2.5 text-slate-500"><%= m.subject_name %></td>
                    <td class="p-2.5 text-slate-500"><%= m.year_level || '—' %></td>
                    <td class="p-2.5"><span class="px-2 py-0.5 rounded-full text-[9px] font-bold <%= m.is_active ? 'bg-emerald-50 text-emerald-600' : 'bg-slate-100 text-slate-500' %>"><%= m.is_active ? 'Active' : 'Inactive' %></span></td>
                    <td class="p-2.5 text-center whitespace-nowrap">
                      <button type="button" onclick="document.getElementById('editMod<%= m.id %>').classList.toggle('hidden')" class="w-6 h-6 rounded bg-slate-50 hover:bg-blue-50 hover:text-blue-600 text-slate-500 inline-flex items-center justify-center"><i class="fa-solid fa-pen-to-square text-[10px]"></i></button>
                      <form method="post" action="/admin/exam-modules/<%= m.id %>/delete" class="inline" onsubmit="return confirm('Delete this module?');"><button class="w-6 h-6 rounded bg-slate-50 hover:bg-rose-50 hover:text-rose-600 text-slate-500 inline-flex items-center justify-center"><i class="fa-regular fa-trash-can text-[10px]"></i></button></form>
                    </td>
                  </tr>
                  <tr id="editMod<%= m.id %>" class="hidden bg-slate-50">
                    <td colspan="6" class="p-3">
                      <form method="post" action="/admin/exam-modules/<%= m.id %>/edit" class="space-y-2">
                        <select name="subject_id" required class="form-input custom-select"><% subjects.forEach(s => { %><option value="<%= s.id %>" <%= s.id===m.subject_id?'selected':'' %>><%= s.name %> (<%= s.year %>)</option><% }) %></select>
                        <input name="title" value="<%= m.title %>" required class="form-input">
                        <div class="grid grid-cols-2 gap-2">
                          <input name="year_level" value="<%= m.year_level || '' %>" placeholder="Year Level" class="form-input">
                          <input name="class_name" value="<%= m.class_name || '' %>" placeholder="Class" class="form-input">
                        </div>
                        <textarea name="description" rows="2" class="form-input"><%= m.description || '' %></textarea>
                        <label class="flex items-center space-x-2 text-[11px] font-semibold text-slate-700"><input type="checkbox" name="is_active" <%= m.is_active ? 'checked' : '' %>><span>Active</span></label>
                        <button class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs py-2 rounded-lg">Save Changes</button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
                <% if (!modules.length) { %><tr><td colspan="6" class="p-4 text-center text-slate-400">None yet.</td></tr><% } %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Manage Topics -->
        <div id="topics" class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden scroll-mt-24">
          <div class="p-4 border-b border-slate-100 flex items-center justify-between">
            <h3 class="font-bold text-sm text-[#091e42]">Manage Topics</h3>
            <button type="button" onclick="document.getElementById('topicForm').classList.toggle('hidden')" class="text-blue-600 hover:text-blue-700 font-semibold text-xs flex items-center space-x-1"><i class="fa-solid fa-plus text-[10px]"></i><span>Add Topic</span></button>
          </div>
          <form id="topicForm" method="post" action="/admin/exam-topics/new" class="hidden p-4 border-b border-slate-100 space-y-2 bg-slate-50">
            <select name="module_id" required class="form-input custom-select"><option value="" disabled selected>Select module</option><% modules.forEach(m => { %><option value="<%= m.id %>"><%= m.title %> (<%= m.subject_name %>)</option><% }) %></select>
            <input name="name" required placeholder="Topic name" class="form-input">
            <button class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs py-2 rounded-lg">Save</button>
          </form>
          <div class="p-3">
            <input type="text" oninput="filterTable(this,'topicsTable')" placeholder="Search topics..." class="w-full bg-slate-50 border border-slate-200 rounded-lg pl-3 pr-3 py-2 text-xs text-slate-800 font-medium">
          </div>
          <div class="overflow-x-auto max-h-[420px] overflow-y-auto">
            <table class="w-full text-left text-[11px]" id="topicsTable">
              <thead class="bg-slate-50 text-slate-500 font-semibold border-b border-slate-200 uppercase tracking-wider text-[9px] sticky top-0">
                <tr><th class="p-2.5 w-8">#</th><th class="p-2.5">Topic Name</th><th class="p-2.5">Module</th><th class="p-2.5">Status</th><th class="p-2.5 text-center">Actions</th></tr>
              </thead>
              <tbody class="divide-y divide-slate-100 text-slate-700 font-medium">
                <% topics.forEach((t, i) => { %>
                  <tr>
                    <td class="p-2.5 text-slate-400"><%= i + 1 %></td>
                    <td class="p-2.5 font-bold text-slate-900"><%= t.name %></td>
                    <td class="p-2.5 text-slate-500"><%= t.module_title %></td>
                    <td class="p-2.5"><span class="px-2 py-0.5 rounded-full text-[9px] font-bold <%= t.is_active ? 'bg-emerald-50 text-emerald-600' : 'bg-slate-100 text-slate-500' %>"><%= t.is_active ? 'Active' : 'Inactive' %></span></td>
                    <td class="p-2.5 text-center whitespace-nowrap">
                      <button type="button" onclick="document.getElementById('editTopic<%= t.id %>').classList.toggle('hidden')" class="w-6 h-6 rounded bg-slate-50 hover:bg-blue-50 hover:text-blue-600 text-slate-500 inline-flex items-center justify-center"><i class="fa-solid fa-pen-to-square text-[10px]"></i></button>
                      <form method="post" action="/admin/exam-topics/<%= t.id %>/delete" class="inline" onsubmit="return confirm('Delete this topic?');"><button class="w-6 h-6 rounded bg-slate-50 hover:bg-rose-50 hover:text-rose-600 text-slate-500 inline-flex items-center justify-center"><i class="fa-regular fa-trash-can text-[10px]"></i></button></form>
                    </td>
                  </tr>
                  <tr id="editTopic<%= t.id %>" class="hidden bg-slate-50">
                    <td colspan="5" class="p-3">
                      <form method="post" action="/admin/exam-topics/<%= t.id %>/edit" class="space-y-2">
                        <select name="module_id" required class="form-input custom-select"><% modules.forEach(m => { %><option value="<%= m.id %>" <%= m.id===t.module_id?'selected':'' %>><%= m.title %> (<%= m.subject_name %>)</option><% }) %></select>
                        <input name="name" value="<%= t.name %>" required class="form-input">
                        <label class="flex items-center space-x-2 text-[11px] font-semibold text-slate-700"><input type="checkbox" name="is_active" <%= t.is_active ? 'checked' : '' %>><span>Active</span></label>
                        <button class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs py-2 rounded-lg">Save Changes</button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
                <% if (!topics.length) { %><tr><td colspan="5" class="p-4 text-center text-slate-400">None yet.</td></tr><% } %>
              </tbody>
            </table>
          </div>
        </div>

      </div>

    </div>
  </main>
</div>
<%- include('../partials/tw_scripts') %>
<script>
  function filterTable(input, tableId) {
    const q = input.value.toLowerCase();
    document.querySelectorAll('#' + tableId + ' > tbody > tr').forEach(tr => {
      if (tr.id && tr.id.startsWith('edit')) return; // never hide the inline edit rows themselves
      tr.style.display = tr.textContent.toLowerCase().includes(q) ? '' : 'none';
    });
  }
</script>
</body>
</html>
