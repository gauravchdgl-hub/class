<%- include('../partials/header', { title: 'Exam Papers' }) %>
<%- include('../partials/admin_nav') %>
<a class="btn" href="/admin/papers/new">+ Create Full Exam Paper</a>
<table class="card" style="margin-top:14px;">
  <tr><th>Title</th><th>Subject</th><th>Price</th><th>Published</th><th></th></tr>
  <% papers.forEach(p => { %>
    <tr>
      <td><%= p.title %></td><td><%= p.subject_name %> (<%= p.year %>)</td><td>A$<%= p.price.toFixed(2) %></td>
      <td><%= p.is_published ? 'Yes' : 'No' %></td>
      <td><a class="btn outline" href="/admin/papers/<%= p.id %>">Manage</a></td>
    </tr>
  <% }) %>
</table>
<%- include('../partials/footer') %>
