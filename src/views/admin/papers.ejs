<%- include('../partials/portal_top', { title: 'Exam Papers', active: 'papers', crumb: 'Admin / Full Exam Papers' }) %>
<div class="page-title"><div><h2>Full Exam Papers</h2><p>Create as many papers as you like, for any year and subject.</p></div>
  <a class="btn btn-primary" href="/admin/papers/new">+ Create Full Exam Paper</a>
</div>
<div class="card">
<div class="table-wrap"><table class="table">
  <tr><th>Title</th><th>Subject</th><th>Price</th><th>Published</th><th></th></tr>
  <% papers.forEach(p => { %>
    <tr>
      <td><%= p.title %></td><td><%= p.subject_name %> (<%= p.year %>)</td><td>A$<%= p.price.toFixed(2) %></td>
      <td><span class="chip chip-<%= p.is_published ? 'green' : 'orange' %>"><%= p.is_published ? 'Published' : 'Draft' %></span></td>
      <td><a class="btn btn-outline" href="/admin/papers/<%= p.id %>">Manage</a></td>
    </tr>
  <% }) %>
</table></div>
</div>
<%- include('../partials/portal_bottom') %>
