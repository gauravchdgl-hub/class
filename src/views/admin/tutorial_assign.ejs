<!DOCTYPE html>
<html lang="en" class="h-full bg-[#f4f6fa]">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Assign Tutorial — AUS Academy</title>
<link rel="stylesheet" href="/assets/tailwind.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<%- include('../partials/tw_head_styles') %>
</head>
<body class="h-full antialiased flex flex-col text-slate-800">
<div class="flex flex-1 min-h-screen overflow-hidden">
  <%- include('../partials/tw_sidebar', { active: 'tutorial-assign' }) %>

  <main class="flex-1 flex flex-col min-w-0 overflow-y-auto">
    <%- include('../partials/tw_header', { searchPlaceholder: 'Search students, tutorials, subjects...' }) %>

    <div class="p-4 sm:p-6 space-y-6 max-w-7xl mx-auto w-full">

      <div class="flex items-center justify-between gap-4">
        <div class="flex items-center gap-4">
          <a href="/admin/tutorials" class="w-9 h-9 rounded-full bg-white border border-slate-200 text-slate-600 flex items-center justify-center hover:bg-slate-100 transition-colors shadow-sm"><i class="fa-solid fa-arrow-left text-sm"></i></a>
          <div>
            <h1 class="text-2xl font-bold text-slate-900">Assign Tutorial to Students</h1>
            <p class="text-sm text-slate-500 mt-0.5">Select students and configure assignment settings for this tutorial.</p>
          </div>
        </div>
        <div class="text-xs font-medium text-slate-500 flex items-center gap-1.5">
          <a href="/admin/dashboard" class="hover:text-blue-600">Home</a><i class="fa-solid fa-chevron-right text-[10px] text-slate-400"></i>
          <a href="/admin/tutorials" class="hover:text-blue-600">Tutorials</a><i class="fa-solid fa-chevron-right text-[10px] text-slate-400"></i>
          <span class="text-blue-600 font-semibold">Assign Tutorial</span>
        </div>
      </div>

      <!-- Tutorial Preview -->
      <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-sm flex flex-col md:flex-row gap-6 items-center">
        <div class="relative w-full md:w-72 h-40 rounded-lg overflow-hidden shrink-0 bg-slate-900 flex items-center justify-center">
          <% if (tutorial.thumbnail_url) { %><img src="<%= tutorial.thumbnail_url %>" class="w-full h-full object-cover opacity-90"><% } else { %><i class="fa-solid fa-video text-slate-500 text-3xl"></i><% } %>
          <span class="absolute bottom-2 right-2 bg-black/75 text-white text-xs px-2.5 py-0.5 rounded font-medium"><%= tutorial.duration_minutes %> min</span>
        </div>
        <div class="flex-1 w-full">
          <h2 class="text-lg font-bold text-slate-900 tracking-tight"><%= tutorial.title %></h2>
          <div class="flex flex-wrap items-center gap-4 mt-2 text-xs text-slate-600 font-medium">
            <span class="bg-blue-50 text-blue-700 px-2.5 py-1 rounded-md flex items-center gap-1.5 border border-blue-100"><i class="fa-solid fa-book-open text-blue-500"></i> <%= tutorial.subject_name || '—' %></span>
            <span class="flex items-center gap-1.5"><i class="fa-regular fa-calendar text-slate-400"></i> <%= tutorial.year || '—' %></span>
            <span class="flex items-center gap-1.5"><i class="fa-regular fa-clock text-slate-400"></i> <%= tutorial.duration_minutes %> min</span>
            <span class="flex items-center gap-1.5"><i class="fa-regular fa-eye text-slate-400"></i> <%= tutorial.views %> views</span>
          </div>
          <p class="text-xs text-slate-500 mt-2.5 leading-relaxed"><%= tutorial.description || '' %></p>
        </div>
      </div>

      <form method="post" action="/admin/tutorials/<%= tutorial.id %>/assign">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

          <div class="lg:col-span-7 bg-white rounded-xl border border-slate-200 shadow-sm p-6 space-y-4">
            <h3 class="text-base font-bold text-slate-900 flex items-center gap-2"><i class="fa-solid fa-users text-blue-600"></i> Assign To Students</h3>
            <div class="relative">
              <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
              <input type="text" id="studentSearch" onkeyup="filterStudents()" placeholder="Search and select students by name or email..." class="w-full bg-slate-50 border border-slate-200 rounded-lg pl-9 pr-3 py-2 text-xs text-slate-700 focus:outline-none focus:border-blue-500 transition-colors">
            </div>
            <div class="border border-slate-200 rounded-lg overflow-hidden">
              <table class="w-full text-left text-xs">
                <thead class="bg-slate-50 text-slate-500 font-semibold border-b border-slate-200 uppercase tracking-wider text-[10px]">
                  <tr><th class="p-3 w-10 text-center"><input type="checkbox" onclick="toggleAll(this)"></th><th class="py-3 px-2">Student Name</th><th class="py-3 px-2">Class</th><th class="py-3 px-3">Email</th></tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-slate-700 font-medium" id="studentRows">
                  <% students.forEach(s => { %>
                    <tr class="hover:bg-slate-50/80 transition-colors student-row" data-name="<%= s.name.toLowerCase() %>" data-email="<%= s.email.toLowerCase() %>">
                      <td class="p-3 text-center"><input type="checkbox" name="student_ids" value="<%= s.id %>" class="student-check" <%= alreadyAssigned.has(s.id) ? 'checked' : '' %>></td>
                      <td class="py-2.5 px-2 text-slate-900 font-semibold"><%= s.name %></td>
                      <td class="py-2.5 px-2 text-slate-600"><%= s.class_section || s.class_year || '—' %></td>
                      <td class="py-2.5 px-3 text-slate-500 font-normal"><%= s.email %></td>
                    </tr>
                  <% }) %>
                  <% if (!students.length) { %><tr><td colspan="4" class="p-4 text-center text-slate-400">No students yet.</td></tr><% } %>
                </tbody>
              </table>
            </div>
            <div class="flex items-center justify-between text-xs pt-1">
              <span class="text-blue-600 font-semibold" id="selectedCount">0 students selected</span>
              <button type="button" onclick="clearAll()" class="text-slate-500 hover:text-red-600 font-medium transition-colors">Clear All</button>
            </div>
          </div>

          <div class="lg:col-span-5 bg-white rounded-xl border border-slate-200 shadow-sm p-6 space-y-4">
            <h3 class="text-base font-bold text-slate-900 flex items-center gap-2"><i class="fa-solid fa-gear text-blue-600"></i> Assignment Settings</h3>
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Due Date</label>
              <input type="date" name="due_date" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-xs text-slate-800 font-medium focus:outline-none focus:border-blue-500">
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Notify Students</label>
              <select name="notify" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-xs text-slate-800 font-medium focus:outline-none focus:border-blue-500">
                <option value="yes">Yes, send email notification</option>
                <option value="no">No notification</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Access Type</label>
              <select name="access_type" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-xs text-slate-800 font-medium focus:outline-none focus:border-blue-500">
                <option value="until_due">Until Due Date</option>
                <option value="lifetime">Lifetime Access</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Allow Download</label>
              <select name="allow_download" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-xs text-slate-800 font-medium focus:outline-none focus:border-blue-500">
                <option value="no" <%= !tutorial.allow_download ? 'selected' : '' %>>No (Streaming Only)</option>
                <option value="yes" <%= tutorial.allow_download ? 'selected' : '' %>>Yes, Allow Download</option>
              </select>
            </div>
            <div class="space-y-2 pt-1">
              <label class="flex items-center gap-2 text-xs font-semibold text-slate-800">Custom message (optional)</label>
              <textarea name="custom_message" rows="3" maxlength="500" placeholder="Please watch this tutorial before attempting the quiz." class="w-full bg-slate-50 border border-slate-200 rounded-lg p-3 text-xs text-slate-700 focus:outline-none focus:border-blue-500 resize-none"></textarea>
            </div>
            <div class="grid grid-cols-2 gap-3 pt-3">
              <a href="/admin/tutorials" class="w-full py-2.5 px-4 bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 font-semibold rounded-lg text-xs transition-colors text-center shadow-sm">Cancel</a>
              <button type="submit" class="w-full py-2.5 px-4 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg text-xs shadow-md shadow-blue-600/30 transition-colors text-center" id="assignBtn">Assign to Students</button>
            </div>
          </div>
        </div>
      </form>

    </div>
  </main>
</div>
<%- include('../partials/tw_scripts') %>
<script>
  function updateCount() {
    const n = document.querySelectorAll('.student-check:checked').length;
    document.getElementById('selectedCount').textContent = n + ' student' + (n===1?'':'s') + ' selected';
    document.getElementById('assignBtn').textContent = 'Assign to ' + n + ' Student' + (n===1?'':'s');
  }
  document.querySelectorAll('.student-check').forEach(c => c.addEventListener('change', updateCount));
  function toggleAll(box) { document.querySelectorAll('.student-check').forEach(c => c.checked = box.checked); updateCount(); }
  function clearAll() { document.querySelectorAll('.student-check').forEach(c => c.checked = false); updateCount(); }
  function filterStudents() {
    const q = document.getElementById('studentSearch').value.toLowerCase();
    document.querySelectorAll('.student-row').forEach(r => {
      const match = r.dataset.name.includes(q) || r.dataset.email.includes(q);
      r.style.display = match ? '' : 'none';
    });
  }
  updateCount();
</script>
</body>
</html>
