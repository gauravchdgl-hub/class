<!DOCTYPE html>
<html lang="en" class="h-full bg-[#f4f6fa]">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Review Submission — AUS Academy</title>
<link rel="stylesheet" href="/assets/tailwind.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<%- include('../partials/tw_head_styles') %>
</head>
<body class="h-full antialiased flex flex-col text-slate-800">
<div class="flex flex-1 min-h-screen overflow-hidden">
  <%- include('../partials/tw_sidebar', { active: 'submissions' }) %>
  <main class="flex-1 flex flex-col min-w-0 overflow-y-auto pb-24">
    <%- include('../partials/tw_header', { searchPlaceholder: 'Search students, subjects, exam papers...' }) %>

    <div class="p-4 sm:p-6 lg:p-8 max-w-[1700px] mx-auto w-full flex-1 space-y-6">

      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
        <div class="flex items-start space-x-4">
          <div class="w-10 h-10 rounded-xl bg-purple-600/10 text-purple-600 flex items-center justify-center shrink-0 mt-0.5"><i class="fa-solid fa-file-pen text-xl"></i></div>
          <div>
            <h1 class="text-2xl sm:text-[28px] font-bold text-[#091e42] tracking-tight">Review Submission</h1>
            <p class="text-[13px] text-slate-500 mt-0.5">Review and grade written questions and essay. (MCQs are auto-checked)</p>
          </div>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <a href="/admin/submissions" class="bg-white hover:bg-slate-50 text-slate-700 border border-slate-300 font-semibold text-xs px-4 py-2.5 rounded-xl transition shadow-sm flex items-center space-x-2">
            <i class="fa-solid fa-arrow-left text-xs"></i><span>Back to Submissions</span>
          </a>
          <% if (prevId) { %>
            <a href="/admin/submissions/<%= prevId %>/review" class="bg-white hover:bg-slate-50 text-slate-700 border border-slate-300 font-semibold text-xs px-4 py-2.5 rounded-xl transition shadow-sm flex items-center space-x-2">
              <i class="fa-solid fa-chevron-left text-xs"></i><span>Previous Student</span>
            </a>
          <% } else { %>
            <span class="bg-slate-100 text-slate-400 font-semibold text-xs px-4 py-2.5 rounded-xl flex items-center space-x-2 cursor-not-allowed"><i class="fa-solid fa-chevron-left text-xs"></i><span>Previous Student</span></span>
          <% } %>
          <% if (nextId) { %>
            <a href="/admin/submissions/<%= nextId %>/review" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs px-4 py-2.5 rounded-xl transition shadow-md shadow-blue-600/30 flex items-center space-x-2">
              <span>Next Student</span><i class="fa-solid fa-chevron-right text-xs"></i>
            </a>
          <% } else { %>
            <span class="bg-slate-100 text-slate-400 font-semibold text-xs px-4 py-2.5 rounded-xl flex items-center space-x-2 cursor-not-allowed"><span>Next Student</span><i class="fa-solid fa-chevron-right text-xs"></i></span>
          <% } %>
        </div>
      </div>

      <% if (typeof success !== 'undefined' && success.length) { %><div class="bg-emerald-50 border border-emerald-200 text-emerald-700 text-xs font-semibold rounded-xl px-4 py-3"><%= success[0] %></div><% } %>
      <% if (typeof error !== 'undefined' && error.length) { %><div class="bg-rose-50 border border-rose-200 text-rose-700 text-xs font-semibold rounded-xl px-4 py-3"><%= error[0] %></div><% } %>

      <%
        const writtenAwarded = written.reduce((sum, a) => sum + (a.marks_awarded || 0), 0);
        const essayAwarded = essays.reduce((sum, a) => sum + (a.marks_awarded || 0), 0);
        const writtenGraded = written.length && written.every(a => a.reviewed_at);
        const essayGraded = essays.length && essays.every(a => a.reviewed_at);
        const totalAwarded = submission.mcq_score + writtenAwarded + essayAwarded;
        const totalMarks = submission.mcq_total + submission.written_total + submission.essay_total;
      %>

      <!-- Top Info Panels -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        <div class="lg:col-span-3 bg-white rounded-xl border border-slate-200 p-5 shadow-sm space-y-4">
          <div class="flex items-center space-x-3.5 pb-4 border-b border-slate-100">
            <div class="w-14 h-14 rounded-full bg-blue-600 text-white flex items-center justify-center font-bold text-lg shrink-0"><%= submission.student_name.split(' ').map(w=>w[0]).slice(0,2).join('').toUpperCase() %></div>
            <div>
              <h3 class="font-bold text-base text-[#091e42]"><%= submission.student_name %></h3>
              <span class="text-xs text-blue-600 font-semibold">Student ID: #<%= submission.assignment_id %></span>
            </div>
          </div>
          <div class="space-y-2 text-xs font-medium text-slate-600">
            <div class="flex justify-between py-1 border-b border-slate-50"><span class="text-slate-400">Class:</span><span class="font-bold text-slate-800"><%= submission.class_name || '—' %></span></div>
            <div class="flex justify-between py-1 border-b border-slate-50"><span class="text-slate-400">Year:</span><span class="font-bold text-slate-800"><%= submission.year || '—' %></span></div>
            <div class="flex justify-between py-1"><span class="text-slate-400">Email:</span><span class="font-semibold text-slate-800 truncate max-w-[160px]" title="<%= submission.email %>"><%= submission.email %></span></div>
          </div>
        </div>

        <div class="lg:col-span-5 bg-white rounded-xl border border-slate-200 p-5 shadow-sm space-y-4">
          <div class="flex items-center space-x-2 text-[#091e42] pb-3 border-b border-slate-100"><i class="fa-solid fa-file-lines text-blue-600"></i><h3 class="font-bold text-sm">Exam Paper Details</h3></div>
          <div class="space-y-2 text-xs font-medium text-slate-600">
            <h4 class="font-bold text-slate-900 text-sm mb-2"><%= submission.title %></h4>
            <div class="grid grid-cols-2 gap-x-4 gap-y-1.5">
              <div class="flex justify-between"><span class="text-slate-400">Subject:</span><span class="font-semibold text-slate-800"><%= submission.subject_name || '—' %></span></div>
              <div class="flex justify-between"><span class="text-slate-400">Year Level:</span><span class="font-semibold text-slate-800"><%= submission.year || '—' %></span></div>
              <div class="flex justify-between"><span class="text-slate-400">Class:</span><span class="font-semibold text-slate-800"><%= submission.class_name || '—' %></span></div>
              <div class="flex justify-between"><span class="text-slate-400">Total Marks:</span><span class="font-semibold text-slate-800"><%= totalMarks %></span></div>
              <div class="flex justify-between"><span class="text-slate-400">Duration:</span><span class="font-semibold text-slate-800"><%= submission.duration_minutes || '—' %> Minutes</span></div>
            </div>
            <div class="pt-2 border-t border-slate-100 flex justify-between text-[11px]">
              <span class="text-slate-400">Submitted On:</span>
              <span class="font-bold text-slate-700"><%= submission.submitted_at ? new Date(submission.submitted_at).toLocaleString('en-AU') : '—' %></span>
            </div>
          </div>
        </div>

        <div class="lg:col-span-4 bg-white rounded-xl border border-slate-200 p-5 shadow-sm space-y-3">
          <div class="flex items-center space-x-2 text-[#091e42] pb-3 border-b border-slate-100"><i class="fa-solid fa-chart-pie text-blue-600"></i><h3 class="font-bold text-sm">Submission Summary</h3></div>
          <div class="space-y-2.5 text-xs">
            <div class="flex items-center justify-between p-2.5 bg-slate-50 rounded-lg border border-slate-200">
              <span class="font-semibold text-slate-700">Section A - MCQs</span>
              <div class="flex items-center space-x-2">
                <span class="font-bold text-slate-900"><%= submission.mcq_score %> / <%= submission.mcq_total %></span>
                <span class="bg-emerald-50 text-emerald-700 border border-emerald-200 text-[10px] font-bold px-2 py-0.5 rounded-full flex items-center space-x-1"><i class="fa-solid fa-check text-[9px]"></i><span>Auto-graded</span></span>
              </div>
            </div>
            <% if (written.length) { %>
            <div class="flex items-center justify-between p-2.5 bg-slate-50 rounded-lg border border-slate-200">
              <span class="font-semibold text-slate-700">Section B - Written</span>
              <div class="flex items-center space-x-2">
                <span class="font-bold text-slate-900"><%= writtenAwarded %> / <%= submission.written_total %></span>
                <% if (writtenGraded) { %><span class="bg-emerald-50 text-emerald-700 border border-emerald-200 text-[10px] font-bold px-2 py-0.5 rounded-full flex items-center space-x-1"><i class="fa-solid fa-check text-[9px]"></i><span>Graded</span></span>
                <% } else { %><span class="bg-amber-50 text-amber-700 border border-amber-200 text-[10px] font-bold px-2 py-0.5 rounded-full flex items-center space-x-1"><i class="fa-regular fa-clock text-[9px]"></i><span>Pending</span></span><% } %>
              </div>
            </div>
            <% } %>
            <% if (essays.length) { %>
            <div class="flex items-center justify-between p-2.5 bg-slate-50 rounded-lg border border-slate-200">
              <span class="font-semibold text-slate-700">Section C - Essay</span>
              <div class="flex items-center space-x-2">
                <span class="font-bold text-slate-900"><%= essayAwarded %> / <%= submission.essay_total %></span>
                <% if (essayGraded) { %><span class="bg-emerald-50 text-emerald-700 border border-emerald-200 text-[10px] font-bold px-2 py-0.5 rounded-full flex items-center space-x-1"><i class="fa-solid fa-check text-[9px]"></i><span>Graded</span></span>
                <% } else { %><span class="bg-amber-50 text-amber-700 border border-amber-200 text-[10px] font-bold px-2 py-0.5 rounded-full flex items-center space-x-1"><i class="fa-regular fa-clock text-[9px]"></i><span>Pending</span></span><% } %>
              </div>
            </div>
            <% } %>
          </div>
          <div class="pt-3 border-t border-slate-100 flex items-center justify-between font-bold text-sm">
            <span class="text-slate-700">Total Marks</span>
            <span class="text-blue-600 text-base"><%= totalAwarded %> / <%= totalMarks %></span>
          </div>
        </div>
      </div>

      <form method="post" action="/admin/submissions/<%= submission.id %>/review" id="reviewForm">

        <!-- Section Tabs -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 bg-white p-2 rounded-xl border border-slate-200 shadow-sm text-xs font-semibold mb-6">
          <button type="button" onclick="showSection('mcq')" id="tabbtn-mcq" class="section-tab py-3 rounded-lg transition flex items-center justify-center space-x-2 text-slate-600 hover:bg-slate-100">
            <i class="fa-regular fa-file-lines text-emerald-600"></i><span>Section A - MCQs (<%= mcqCount %>)</span><i class="fa-solid fa-check text-emerald-600 text-xs"></i>
          </button>
          <button type="button" onclick="showSection('written')" id="tabbtn-written" class="section-tab py-3 rounded-lg transition flex items-center justify-center space-x-2 text-slate-600 hover:bg-slate-100">
            <i class="fa-regular fa-pen-to-square"></i><span>Section B - Written Questions (<%= written.length %>)</span>
          </button>
          <button type="button" onclick="showSection('essay')" id="tabbtn-essay" class="section-tab py-3 rounded-lg transition flex items-center justify-center space-x-2 text-slate-600 hover:bg-slate-100">
            <i class="fa-regular fa-file-lines"></i><span>Section C - Long Answer / Essay (<%= essays.length %>)</span>
          </button>
        </div>

        <!-- Section A: MCQs (read-only) -->
        <div id="panel-mcq" class="section-panel bg-white rounded-xl border border-slate-200 p-6 shadow-sm space-y-4">
          <div class="bg-emerald-50/60 border border-emerald-100 rounded-xl p-4 flex items-center justify-between gap-3 text-xs">
            <div>
              <h3 class="font-bold text-sm text-[#091e42]">Section A - Multiple Choice Questions</h3>
              <p class="text-slate-500 mt-0.5">Auto-graded by the system — no manual grading required.</p>
            </div>
            <div class="text-right shrink-0">
              <span class="block text-[10px] text-slate-400 uppercase font-bold tracking-wide">Score</span>
              <span class="font-bold text-sm text-emerald-600"><%= submission.mcq_score %> / <%= submission.mcq_total %></span>
            </div>
          </div>
          <p class="text-xs text-slate-400 text-center py-6">MCQ answers are checked automatically at submission time.</p>
        </div>

        <!-- Section B: Written -->
        <div id="panel-written" class="section-panel bg-white rounded-xl border border-slate-200 p-6 shadow-sm space-y-6">
          <div class="bg-blue-50/60 border border-blue-100 rounded-xl p-4 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs">
            <div>
              <h3 class="font-bold text-sm text-[#091e42]">Section B - Written Questions</h3>
              <p class="text-slate-500 mt-0.5">Review and provide feedback for each written question.</p>
            </div>
            <div class="flex items-center space-x-4 bg-white px-4 py-2 rounded-xl border border-blue-200 shrink-0">
              <div class="text-right">
                <span class="block text-[10px] text-slate-400 uppercase font-bold tracking-wide">Total Marks (Section B)</span>
                <span class="font-bold text-sm text-blue-600"><%= writtenAwarded %> / <%= submission.written_total %></span>
              </div>
            </div>
          </div>
          <% written.forEach((a, i) => { %>
            <div class="border border-slate-200 rounded-xl p-5 space-y-4 bg-slate-50/30">
              <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <div class="flex items-center space-x-3">
                  <span class="w-8 h-8 rounded-lg bg-blue-600 text-white font-bold text-xs flex items-center justify-center shadow-sm">Q<%= i + 1 %></span>
                  <span class="font-bold text-xs text-slate-700 bg-slate-100 px-2.5 py-1 rounded-md"><%= a.marks %> Marks</span>
                </div>
              </div>
              <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
                <div class="lg:col-span-7 space-y-4">
                  <h4 class="font-bold text-xs sm:text-sm text-slate-900 leading-relaxed"><%= a.question %></h4>
                  <div class="space-y-1">
                    <div class="flex items-center space-x-1.5 text-xs font-semibold text-amber-800"><i class="fa-solid fa-user text-amber-600"></i><span>Student's Answer</span></div>
                    <div class="bg-amber-50/50 border border-amber-200/60 rounded-xl p-4 text-xs text-slate-800 font-medium leading-relaxed whitespace-pre-line"><%= a.answer_text || '(no answer)' %></div>
                  </div>
                  <% if (a.model_answer) { %>
                  <div class="space-y-1">
                    <div class="flex items-center space-x-1.5 text-xs font-semibold text-emerald-800"><i class="fa-solid fa-circle-check text-emerald-600"></i><span>Model Answer <span class="font-normal text-slate-400">(your reference — not shown to the student unless Show Model Answers is on)</span></span></div>
                    <div class="bg-emerald-50/50 border border-emerald-200/60 rounded-xl p-4 text-xs text-slate-800 font-medium leading-relaxed whitespace-pre-line"><%= a.model_answer %></div>
                  </div>
                  <% } %>
                </div>
                <div class="lg:col-span-5 space-y-4 bg-white border border-slate-200 rounded-xl p-4 shadow-sm">
                  <div class="space-y-1.5">
                    <label class="block font-bold text-slate-700 text-xs">Teacher Feedback</label>
                    <textarea name="feedback_<%= a.id %>" rows="3" placeholder="Write feedback for this answer..." class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-lg text-xs text-slate-700 outline-none resize-none focus:ring-2 focus:ring-blue-500"><%= a.feedback || '' %></textarea>
                  </div>
                  <% if (a.rubricParsed && a.rubricParsed.length) { %>
                  <div class="space-y-1.5">
                    <label class="font-bold text-slate-700 text-xs flex items-center space-x-1.5"><i class="fa-solid fa-list-check text-blue-600 text-[10px]"></i><span>Marking Rubric</span></label>
                    <div class="space-y-1.5">
                      <% a.rubricParsed.forEach((pt, idx) => { %>
                      <label class="flex items-center justify-between gap-2 bg-slate-50 border border-slate-200 rounded-lg px-2.5 py-2 cursor-pointer hover:bg-blue-50/50 transition">
                        <span class="flex items-center gap-2 min-w-0">
                          <input type="checkbox" class="rubric-check custom-checkbox" data-answer="<%= a.id %>" data-marks="<%= pt.marks %>" name="rubric_checked_<%= a.id %>[]" value="<%= idx %>" <%= a.rubricChecked.includes(idx) ? 'checked' : '' %>>
                          <span class="text-xs text-slate-700 truncate"><%= pt.text %></span>
                        </span>
                        <span class="text-[10px] font-bold text-slate-400 shrink-0"><%= pt.marks %> mk</span>
                      </label>
                      <% }) %>
                    </div>
                  </div>
                  <% } %>
                  <div class="space-y-1.5">
                    <div class="flex items-center justify-between">
                      <label class="font-bold text-slate-700 text-xs">Marks for this Question</label>
                      <div class="flex items-center space-x-1">
                        <input type="number" step="0.5" min="0" max="<%= a.marks %>" name="marks_<%= a.id %>" id="marks_<%= a.id %>" value="<%= a.marks_awarded || '' %>" placeholder="0" class="mark-input w-14 bg-slate-50 border border-slate-200 rounded-lg px-2 py-1 text-center font-bold text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <span class="text-xs text-slate-400 font-semibold">/ <%= a.marks %></span>
                      </div>
                    </div>
                    <% if (!(a.rubricParsed && a.rubricParsed.length)) { %>
                    <div class="grid grid-cols-5 gap-1 pt-1">
                      <% [0, 0.25, 0.5, 0.75, 1].forEach(pct => { const val = Math.round(a.marks * pct * 2) / 2; %>
                        <button type="button" onclick="document.getElementById('marks_<%= a.id %>').value = <%= val %>" class="py-1 bg-slate-100 hover:bg-blue-50 hover:text-blue-600 hover:border-blue-300 border border-slate-200 rounded text-xs font-semibold text-slate-700 transition"><%= val %></button>
                      <% }) %>
                    </div>
                    <% } else { %>
                    <p class="text-[10px] text-slate-400 pt-1">Ticking rubric points above fills this in automatically — you can still fine-tune it by hand.</p>
                    <% } %>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
          <% if (!written.length) { %><p class="text-xs text-slate-400 text-center py-6">No written questions in this paper.</p><% } %>
        </div>

        <!-- Section C: Essay -->
        <div id="panel-essay" class="section-panel bg-white rounded-xl border border-slate-200 p-6 shadow-sm space-y-6">
          <div class="bg-purple-50/60 border border-purple-100 rounded-xl p-4 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs">
            <div>
              <h3 class="font-bold text-sm text-[#091e42]">Section C - Long Answer / Essay</h3>
              <p class="text-slate-500 mt-0.5">Review and provide feedback for extended responses.</p>
            </div>
            <div class="flex items-center space-x-4 bg-white px-4 py-2 rounded-xl border border-purple-200 shrink-0">
              <div class="text-right">
                <span class="block text-[10px] text-slate-400 uppercase font-bold tracking-wide">Total Marks (Section C)</span>
                <span class="font-bold text-sm text-purple-600"><%= essayAwarded %> / <%= submission.essay_total %></span>
              </div>
            </div>
          </div>
          <% essays.forEach((a, i) => { %>
            <div class="border border-slate-200 rounded-xl p-5 space-y-4 bg-slate-50/30">
              <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <div class="flex items-center space-x-3">
                  <span class="w-8 h-8 rounded-lg bg-purple-600 text-white font-bold text-xs flex items-center justify-center shadow-sm">Q<%= i + 1 %></span>
                  <span class="font-bold text-xs text-slate-700 bg-slate-100 px-2.5 py-1 rounded-md"><%= a.marks %> Marks</span>
                </div>
              </div>
              <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
                <div class="lg:col-span-7 space-y-4">
                  <h4 class="font-bold text-xs sm:text-sm text-slate-900 leading-relaxed"><%= a.question %></h4>
                  <div class="space-y-1">
                    <div class="flex items-center space-x-1.5 text-xs font-semibold text-amber-800"><i class="fa-solid fa-user text-amber-600"></i><span>Student's Answer</span></div>
                    <div class="bg-amber-50/50 border border-amber-200/60 rounded-xl p-4 text-xs text-slate-800 font-medium leading-relaxed whitespace-pre-line"><%= a.answer_text || '(no answer)' %></div>
                  </div>
                  <% if (a.model_answer) { %>
                  <div class="space-y-1">
                    <div class="flex items-center space-x-1.5 text-xs font-semibold text-emerald-800"><i class="fa-solid fa-circle-check text-emerald-600"></i><span>Model Answer <span class="font-normal text-slate-400">(your reference — not shown to the student unless Show Model Answers is on)</span></span></div>
                    <div class="bg-emerald-50/50 border border-emerald-200/60 rounded-xl p-4 text-xs text-slate-800 font-medium leading-relaxed whitespace-pre-line"><%= a.model_answer %></div>
                  </div>
                  <% } %>
                </div>
                <div class="lg:col-span-5 space-y-4 bg-white border border-slate-200 rounded-xl p-4 shadow-sm">
                  <div class="space-y-1.5">
                    <label class="block font-bold text-slate-700 text-xs">Teacher Feedback</label>
                    <textarea name="feedback_<%= a.id %>" rows="4" placeholder="Write feedback for this answer..." class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-lg text-xs text-slate-700 outline-none resize-none focus:ring-2 focus:ring-blue-500"><%= a.feedback || '' %></textarea>
                  </div>
                  <% if (a.rubricParsed && a.rubricParsed.length) { %>
                  <div class="space-y-1.5">
                    <label class="font-bold text-slate-700 text-xs flex items-center space-x-1.5"><i class="fa-solid fa-list-check text-blue-600 text-[10px]"></i><span>Marking Rubric</span></label>
                    <div class="space-y-1.5">
                      <% a.rubricParsed.forEach((pt, idx) => { %>
                      <label class="flex items-center justify-between gap-2 bg-slate-50 border border-slate-200 rounded-lg px-2.5 py-2 cursor-pointer hover:bg-blue-50/50 transition">
                        <span class="flex items-center gap-2 min-w-0">
                          <input type="checkbox" class="rubric-check custom-checkbox" data-answer="<%= a.id %>" data-marks="<%= pt.marks %>" name="rubric_checked_<%= a.id %>[]" value="<%= idx %>" <%= a.rubricChecked.includes(idx) ? 'checked' : '' %>>
                          <span class="text-xs text-slate-700 truncate"><%= pt.text %></span>
                        </span>
                        <span class="text-[10px] font-bold text-slate-400 shrink-0"><%= pt.marks %> mk</span>
                      </label>
                      <% }) %>
                    </div>
                  </div>
                  <% } %>
                  <div class="space-y-1.5">
                    <div class="flex items-center justify-between">
                      <label class="font-bold text-slate-700 text-xs">Marks for this Question</label>
                      <div class="flex items-center space-x-1">
                        <input type="number" step="0.5" min="0" max="<%= a.marks %>" name="marks_<%= a.id %>" id="marks_<%= a.id %>" value="<%= a.marks_awarded || '' %>" placeholder="0" class="mark-input w-14 bg-slate-50 border border-slate-200 rounded-lg px-2 py-1 text-center font-bold text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <span class="text-xs text-slate-400 font-semibold">/ <%= a.marks %></span>
                      </div>
                    </div>
                    <% if (!(a.rubricParsed && a.rubricParsed.length)) { %>
                    <div class="grid grid-cols-5 gap-1 pt-1">
                      <% [0, 0.25, 0.5, 0.75, 1].forEach(pct => { const val = Math.round(a.marks * pct * 2) / 2; %>
                        <button type="button" onclick="document.getElementById('marks_<%= a.id %>').value = <%= val %>" class="py-1 bg-slate-100 hover:bg-blue-50 hover:text-blue-600 hover:border-blue-300 border border-slate-200 rounded text-xs font-semibold text-slate-700 transition"><%= val %></button>
                      <% }) %>
                    </div>
                    <% } else { %>
                    <p class="text-[10px] text-slate-400 pt-1">Ticking rubric points above fills this in automatically — you can still fine-tune it by hand.</p>
                    <% } %>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
          <% if (!essays.length) { %><p class="text-xs text-slate-400 text-center py-6">No essay question in this paper.</p><% } %>
        </div>

        <!-- Bottom Fixed Action Bar -->
        <div class="fixed bottom-0 left-0 lg:left-64 right-0 bg-white border-t border-slate-200 px-6 py-4 flex items-center justify-between z-30 shadow-lg">
          <button type="button" onclick="resetMarks()" class="bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 font-semibold text-xs sm:text-sm px-6 py-2.5 rounded-xl transition shadow-sm">Reset Marks</button>
          <div class="flex items-center space-x-3">
            <button type="submit" name="action" value="draft" class="bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 font-semibold text-xs sm:text-sm px-6 py-2.5 rounded-xl transition shadow-sm">Save as Draft</button>
            <button type="submit" name="action" value="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs sm:text-sm px-6 py-2.5 rounded-xl transition shadow-md shadow-blue-600/30">Submit &amp; Publish</button>
          </div>
        </div>
      </form>
    </div>
  </main>
</div>
<%- include('../partials/tw_scripts') %>
<script>
  function showSection(section) {
    ['mcq', 'written', 'essay'].forEach(s => {
      document.getElementById('panel-' + s).classList.toggle('active', s === section);
      document.getElementById('tabbtn-' + s).classList.toggle('active', s === section);
    });
  }
  function resetMarks() {
    document.querySelectorAll('.mark-input').forEach(el => el.value = '');
  }

  // Marking rubric: ticking points for an answer sums their marks straight into that
  // answer's marks field. The field stays editable afterwards — this is a starting point,
  // not a lock, so a teacher can still nudge the total up or down by hand.
  document.querySelectorAll('.rubric-check').forEach((cb) => {
    cb.addEventListener('change', () => {
      const answerId = cb.dataset.answer;
      const group = document.querySelectorAll('.rubric-check[data-answer="' + answerId + '"]:checked');
      const sum = Array.from(group).reduce((s, el) => s + (parseFloat(el.dataset.marks) || 0), 0);
      const marksInput = document.getElementById('marks_' + answerId);
      if (marksInput) marksInput.value = sum;
    });
  });

  showSection('written');
</script>
</body>
</html>
