<%- include('../partials/portal_top', { title: 'Review Submission', active: 'submissions', crumb: 'Admin / Submissions / Review' }) %>
<div class="page-title"><div><h2><%= submission.title %></h2><p class="muted"><%= submission.student_name %> · <%= submission.email %></p></div></div>
<div class="alert">MCQ auto-checked: <%= submission.mcq_score %> / <%= submission.mcq_total %> (<%= mcqCount %> questions)</div>

<form method="post" action="/admin/submissions/<%= submission.id %>/review">
  <div class="section-title" style="margin-top:18px;"><h3>Written Questions</h3></div>
  <% written.forEach((a, i) => { %>
    <div class="card card-pad feedback" style="margin-bottom:14px;">
      <p><strong>Question <%= i+1 %></strong> · <%= a.marks %> marks</p>
      <p><%= a.question %></p>
      <div class="review-box"><%= a.answer_text || '(no answer)' %></div>
      <div class="form-grid" style="margin-top:12px;">
        <div class="field"><label>Marks (out of <%= a.marks %>)</label><input type="number" step="0.5" max="<%= a.marks %>" name="marks_<%= a.id %>" value="<%= a.marks_awarded || '' %>"></div>
        <div class="field"><label>Feedback</label><input name="feedback_<%= a.id %>" value="<%= a.feedback || '' %>"></div>
      </div>
    </div>
  <% }) %>

  <div class="section-title"><h3>Essay Question</h3></div>
  <% essays.forEach((a, i) => { %>
    <div class="card card-pad feedback" style="margin-bottom:14px;">
      <p><strong>Question <%= i+1 %></strong> · <%= a.marks %> marks</p>
      <p><%= a.question %></p>
      <div class="review-box"><%= a.answer_text || '(no answer)' %></div>
      <div class="form-grid" style="margin-top:12px;">
        <div class="field"><label>Marks (out of <%= a.marks %>)</label><input type="number" step="0.5" max="<%= a.marks %>" name="marks_<%= a.id %>" value="<%= a.marks_awarded || '' %>"></div>
        <div class="field"><label>Feedback</label><input name="feedback_<%= a.id %>" value="<%= a.feedback || '' %>"></div>
      </div>
    </div>
  <% }) %>

  <button class="btn btn-success" style="width:100%;padding:14px;" type="submit">Save & Publish Result</button>
</form>
<%- include('../partials/portal_bottom') %>
