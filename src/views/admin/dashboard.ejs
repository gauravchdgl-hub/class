<%- include('../partials/portal_top', { title: 'Dashboard', active: 'dashboard', crumb: 'Admin / Dashboard' }) %>
<div class="page-title"><div><h2>Admin Dashboard</h2><p>Overview of students, papers and pending work.</p></div></div>
<div class="grid grid-4">
  <div class="card stat"><div class="label">Students</div><div class="value"><%= stats.students %></div></div>
  <div class="card stat"><div class="label">Exam Papers</div><div class="value"><%= stats.papers %></div></div>
  <div class="card stat"><div class="label">MCQ Plans</div><div class="value"><%= stats.plans %></div></div>
  <div class="card stat"><div class="label">Pending Reviews</div><div class="value"><%= stats.pending %></div><div class="hint"><a href="/admin/submissions">Review now →</a></div></div>
</div>
<%- include('../partials/portal_bottom') %>
