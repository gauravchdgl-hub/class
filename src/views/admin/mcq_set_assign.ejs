<!DOCTYPE html>
<html lang="en" class="h-full bg-[#f4f6fa]">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Assign MCQ Set — AUS Academy</title>
<link rel="stylesheet" href="/assets/tailwind.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<%- include('../partials/tw_head_styles') %>
</head>
<body class="h-full antialiased flex flex-col text-slate-800">
<div class="flex flex-1 min-h-screen overflow-hidden">
  <%- include('../partials/tw_sidebar', { active: 'mcq-set-assign' }) %>
  <main class="flex-1 flex flex-col min-w-0 overflow-y-auto">
    <%- include('../partials/tw_header', { searchPlaceholder: 'Search students, subjects, MCQs, or anything...' }) %>

    <form method="post" action="/admin/mcq-sets/<%= set.id %>/assign">
    <div class="p-4 sm:p-6 lg:p-8 max-w-[1600px] mx-auto w-full flex-1 space-y-6">

      <div class="flex flex-col md:flex-row md:items-start justify-between gap-4">
        <div class="flex items-start space-x-4">
          <a href="/admin/mcqs" class="w-9 h-9 rounded-full bg-white text-slate-600 flex items-center justify-center hover:bg-slate-100 transition shrink-0 mt-0.5 border border-slate-200 shadow-sm" title="Back"><i class="fa-solid fa-arrow-left"></i></a>
          <div>
            <h1 class="text-2xl sm:text-[28px] font-bold text-[#091e42] tracking-tight">Assign MCQ Set</h1>
            <p class="text-[13px] text-slate-500 mt-1">Assign this MCQ set to students, classes, or specific students.</p>
          </div>
        </div>
        <nav class="flex text-[13px] text-slate-500 space-x-2 pt-2 md:pt-0 shrink-0 font-medium">
          <a href="/admin/dashboard" class="hover:text-blue-600 transition">Home</a><span class="text-slate-400">&gt;</span>
          <a href="/admin/mcqs" class="hover:text-blue-600 transition">MCQ Question Bank</a><span class="text-slate-400">&gt;</span>
          <span class="text-[#091e42] font-semibold">Assign MCQ</span>
        </nav>
      </div>

      <% if (typeof error !== 'undefined' && error.length) { %><div class="bg-rose-50 border border-rose-200 text-rose-700 text-xs font-semibold rounded-xl px-4 py-3"><%= error[0] %></div><% } %>

      <!-- Set Preview -->
      <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-sm flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="flex items-center space-x-4 w-full md:w-auto">
          <div class="w-24 h-28 bg-gradient-to-br from-slate-100 to-slate-200 rounded-lg p-3 border border-slate-200 flex flex-col justify-between text-left shadow-inner shrink-0">
            <div><span class="text-[9px] font-bold text-slate-400 uppercase tracking-wider block"><%= set.module_title || 'General' %></span><h5 class="text-[11px] font-bold text-slate-800 leading-tight mt-0.5"><%= questions.length %> MCQs</h5></div>
            <div class="text-[7px] text-slate-400 font-medium pt-1 border-t border-slate-200"><%= set.subject_name %><br><%= set.year %></div>
          </div>
          <div class="space-y-2 overflow-hidden">
            <div class="flex items-center space-x-2"><i class="fa-solid fa-circle-question text-blue-600 text-base"></i><h2 class="text-base font-bold text-[#091e42] truncate"><%= set.title %></h2></div>
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-slate-600 font-medium">
              <span class="flex items-center space-x-1"><i class="fa-solid fa-circle-question text-purple-600"></i><span class="font-semibold text-slate-800"><%= questions.length %> Questions</span></span>
              <span class="flex items-center space-x-1"><i class="fa-solid fa-award text-blue-600"></i><span class="font-semibold text-slate-800"><%= set.default_marks %> Marks each</span></span>
              <span class="flex items-center space-x-1 text-slate-400"><i class="fa-regular fa-calendar"></i><span>Created: <%= new Date(set.created_at).toLocaleDateString() %></span></span>
            </div>
            <div class="flex flex-wrap items-center gap-2 pt-1 text-xs">
              <span class="bg-slate-100 border border-slate-200 px-2.5 py-1 rounded-lg text-slate-700 font-medium"><strong class="text-slate-500">Subject:</strong> <%= set.subject_name %></span>
              <span class="bg-slate-100 border border-slate-200 px-2.5 py-1 rounded-lg text-slate-700 font-medium"><strong class="text-slate-500">Year Level:</strong> <%= set.year %></span>
              <% if (set.module_title) { %><span class="bg-slate-100 border border-slate-200 px-2.5 py-1 rounded-lg text-slate-700 font-medium"><strong class="text-slate-500">Module:</strong> <%= set.module_title %></span><% } %>
            </div>
          </div>
        </div>
      </div>
      <% if (set.description) { %><p class="text-xs text-slate-600 px-1 font-medium"><%= set.description %></p><% } %>

      <div class="grid grid-cols-1 xl:grid-cols-12 gap-6 items-start">
        <div class="xl:col-span-8 space-y-6">

          <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 space-y-5">
            <div class="flex items-center space-x-2"><i class="fa-solid fa-user-group text-blue-600"></i><h2 class="text-base font-bold text-[#091e42]">Assignment Settings</h2></div>
            <div>
              <label class="block text-[13px] font-semibold text-[#091e42] mb-1.5">Assign To <span class="text-red-500">*</span></label>
              <div class="grid grid-cols-3 gap-2 bg-slate-100 p-1 rounded-lg text-[13px] font-medium">
                <label class="assignto-tab py-2 rounded-md transition text-center cursor-pointer"><input type="radio" name="assignto" value="all" class="hidden" onchange="toggleAssignBoxes()"><span>All Students</span></label>
                <label class="assignto-tab py-2 rounded-md transition text-center cursor-pointer"><input type="radio" name="assignto" value="classes" class="hidden" onchange="toggleAssignBoxes()"><span>Specific Classes</span></label>
                <label class="assignto-tab py-2 rounded-md transition text-center cursor-pointer"><input type="radio" name="assignto" value="students" class="hidden" checked onchange="toggleAssignBoxes()"><span>Specific Students</span></label>
              </div>
            </div>

            <div id="classesBox" class="hidden border border-slate-200 rounded-xl p-4 bg-slate-50/50 space-y-2">
              <h4 class="text-xs font-bold text-slate-700 uppercase tracking-wider">Select Classes</h4>
              <div class="grid grid-cols-3 gap-2">
                <% classes.forEach(c => { %>
                  <label class="flex items-center space-x-2 p-2 bg-white border border-slate-200 rounded-lg text-xs font-medium text-slate-800 cursor-pointer shadow-sm">
                    <input type="checkbox" name="class_names" value="<%= c %>" class="w-3.5 h-3.5 rounded border-slate-300 text-blue-600 focus:ring-blue-500 class-check"><span><%= c %></span>
                  </label>
                <% }) %>
                <% if (!classes.length) { %><p class="text-xs text-slate-400 col-span-3">No classes found yet.</p><% } %>
              </div>
            </div>

            <div id="studentsBox" class="border border-slate-200 rounded-xl p-4 bg-slate-50/50 space-y-3">
              <h4 class="text-xs font-bold text-slate-700 uppercase tracking-wider">Select Students</h4>
              <input type="text" id="studentSearch" onkeyup="filterStudents()" placeholder="Search students by name or email..." class="w-full bg-white border border-slate-200 rounded-lg px-3 py-2 text-xs text-slate-700 focus:outline-none focus:border-blue-500">
              <div class="max-h-56 overflow-y-auto border border-slate-200 rounded-lg bg-white divide-y divide-slate-100">
                <% students.forEach(s => { %>
                  <label class="flex items-center justify-between px-3 py-2 text-xs cursor-pointer hover:bg-slate-50 student-row" data-name="<%= s.name.toLowerCase() %>" data-email="<%= s.email.toLowerCase() %>">
                    <span class="font-semibold text-slate-800"><%= s.name %> <span class="text-slate-400 font-normal">· <%= s.class_section || s.class_year || '—' %></span></span>
                    <input type="checkbox" name="student_ids" value="<%= s.id %>" class="student-check w-3.5 h-3.5 rounded border-slate-300 text-blue-600 focus:ring-blue-500">
                  </label>
                <% }) %>
                <% if (!students.length) { %><p class="text-xs text-slate-400 p-3">No students yet.</p><% } %>
              </div>
              <span class="text-xs text-blue-600 font-semibold" id="selectedCount">0 students selected</span>
            </div>
          </div>

          <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 space-y-4">
            <div class="flex items-center space-x-2"><i class="fa-regular fa-clock text-blue-600"></i><h2 class="text-base font-bold text-[#091e42]">Schedule <span class="text-xs text-slate-400 font-normal">(Optional)</span></h2></div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
              <label class="sched-opt border-2 border-blue-600 bg-blue-50/40 rounded-xl p-4 flex items-start space-x-3 cursor-pointer transition">
                <input type="radio" name="schedule" value="now" checked class="mt-0.5 text-blue-600 focus:ring-blue-500" onchange="toggleSchedule()">
                <div><span class="block text-xs font-bold text-[#091e42]">Assign Now</span><span class="block text-[11px] text-slate-500 mt-0.5">Students can access immediately</span></div>
              </label>
              <label class="sched-opt border border-slate-200 hover:border-slate-300 rounded-xl p-4 flex items-start space-x-3 cursor-pointer transition">
                <input type="radio" name="schedule" value="later" class="mt-0.5 text-blue-600 focus:ring-blue-500" onchange="toggleSchedule()">
                <div><span class="block text-xs font-bold text-[#091e42]">Schedule for Later</span><span class="block text-[11px] text-slate-500 mt-0.5">Set a future date</span></div>
              </label>
              <label class="sched-opt border border-slate-200 hover:border-slate-300 rounded-xl p-4 flex items-start space-x-3 cursor-pointer transition">
                <input type="radio" name="schedule" value="until" class="mt-0.5 text-blue-600 focus:ring-blue-500" onchange="toggleSchedule()">
                <div><span class="block text-xs font-bold text-[#091e42]">Assign Until</span><span class="block text-[11px] text-slate-500 mt-0.5">Set a due date</span></div>
              </label>
            </div>
            <div id="scheduleDateBox" class="hidden pt-1">
              <label class="block text-xs font-semibold text-slate-700 mb-1" id="scheduleDateLabel">Date</label>
              <input type="date" name="schedule_date" class="bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-xs text-slate-800">
              <input type="date" name="due_date" class="hidden">
            </div>
          </div>

          <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 space-y-4">
            <div class="flex items-center space-x-2"><i class="fa-regular fa-comment-dots text-blue-600"></i><h2 class="text-base font-bold text-[#091e42]">Assignment Message <span class="text-xs text-slate-400 font-normal">(Optional)</span></h2></div>
            <textarea name="message" rows="3" maxlength="500" placeholder="Please complete this MCQ set carefully within the given time." class="w-full p-3.5 text-[13px] text-slate-700 bg-white border border-slate-200 rounded-lg outline-none resize-none"></textarea>
          </div>

          <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 space-y-5">
            <div class="flex items-center space-x-2"><i class="fa-solid fa-gear text-blue-600"></i><h2 class="text-base font-bold text-[#091e42]">Additional Options</h2></div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-y-5 gap-x-8 pt-1">
              <label class="flex items-center justify-between cursor-pointer">
                <div><span class="text-[13px] text-[#091e42] font-semibold block">Send Notification to Students</span><span class="text-[11px] text-slate-500">Email + in-portal notification</span></div>
                <input type="checkbox" name="notify" value="yes" checked class="w-4 h-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500">
              </label>
            </div>
          </div>
        </div>

        <div class="xl:col-span-4 space-y-6">
          <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-5 space-y-4">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
              <div class="flex items-center space-x-2 text-[#091e42]"><i class="fa-regular fa-eye text-blue-600"></i><h3 class="font-bold text-sm">MCQ Set Preview</h3></div>
            </div>
            <% const q0 = questions[0]; %>
            <% if (q0) { %>
            <div class="space-y-3 text-xs">
              <div class="flex items-center justify-between"><span class="font-bold text-slate-900">Q1.</span><span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-50 text-emerald-600"><%= q0.difficulty %></span></div>
              <p class="font-semibold text-slate-800 leading-tight"><%= q0.question %></p>
              <div class="space-y-1.5 pt-1">
                <% ['A','B','C','D'].forEach(letter => { %>
                  <% const correct = q0.correct_option === letter; %>
                  <div class="flex items-center space-x-2 <%= correct ? 'bg-emerald-50 border border-emerald-300' : 'bg-slate-50 border border-slate-200' %> rounded-lg px-2.5 py-1.5">
                    <span class="w-5 h-5 rounded-full <%= correct ? 'bg-emerald-600 text-white' : 'bg-slate-200 text-slate-600' %> font-bold flex items-center justify-center text-[10px] shrink-0"><%= letter %></span>
                    <span class="font-medium text-slate-700"><%= q0['option_' + letter.toLowerCase()] %></span>
                  </div>
                <% }) %>
              </div>
              <div class="pt-2 border-t border-slate-100 text-center text-slate-500 font-bold">1 / <%= questions.length %></div>
            </div>
            <% } else { %><p class="text-xs text-slate-400">No questions in this set.</p><% } %>
          </div>

          <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-5 space-y-3">
            <div class="flex items-center space-x-2 text-[#091e42] pb-2 border-b border-slate-100"><i class="fa-solid fa-circle-info text-blue-600"></i><h3 class="font-bold text-sm">Important Information</h3></div>
            <ul class="space-y-2 text-[11px] text-slate-600 font-medium">
              <li class="flex items-start space-x-2"><i class="fa-solid fa-check text-emerald-600 mt-0.5 shrink-0"></i><span>Students will be assigned this MCQ set.</span></li>
              <li class="flex items-start space-x-2"><i class="fa-solid fa-check text-emerald-600 mt-0.5 shrink-0"></i><span>A Free Plan quota is created/topped up automatically if needed.</span></li>
              <li class="flex items-start space-x-2"><i class="fa-solid fa-check text-emerald-600 mt-0.5 shrink-0"></i><span>Notifications will be sent to selected students.</span></li>
            </ul>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-4 flex flex-col sm:flex-row items-center justify-between gap-4 mb-6">
        <a href="/admin/mcqs" class="w-full sm:w-auto bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 font-semibold text-sm px-6 py-2.5 rounded-lg transition shadow-sm text-center">Cancel</a>
        <button type="submit" class="w-full sm:w-auto bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm px-6 py-2.5 rounded-lg transition shadow-md shadow-blue-600/30 flex items-center justify-center space-x-2">
          <i class="fa-solid fa-paper-plane text-xs"></i><span>Assign MCQ Set</span>
        </button>
      </div>
    </div>
    </form>
  </main>
</div>
<%- include('../partials/tw_scripts') %>
<script>
  function toggleAssignBoxes() {
    const val = document.querySelector('input[name="assignto"]:checked').value;
    document.getElementById('classesBox').classList.toggle('hidden', val !== 'classes');
    document.getElementById('studentsBox').classList.toggle('hidden', val !== 'students');
    document.querySelectorAll('.assignto-tab').forEach(l => {
      const checked = l.querySelector('input').checked;
      l.classList.toggle('bg-blue-600', checked);
      l.classList.toggle('text-white', checked);
      l.classList.toggle('shadow-sm', checked);
      l.classList.toggle('text-slate-600', !checked);
    });
  }
  function toggleSchedule() {
    const val = document.querySelector('input[name="schedule"]:checked').value;
    const box = document.getElementById('scheduleDateBox');
    box.classList.toggle('hidden', val === 'now');
    document.getElementById('scheduleDateLabel').textContent = val === 'until' ? 'Assign Until' : 'Schedule Date';
    document.querySelectorAll('.sched-opt').forEach(l => {
      const checked = l.querySelector('input').checked;
      l.classList.toggle('border-blue-600', checked);
      l.classList.toggle('bg-blue-50/40', checked);
      l.classList.toggle('border-2', checked);
      l.classList.toggle('border-slate-200', !checked);
    });
    // Route the visible date into the field the server expects.
    const dateInput = box.querySelector('input[name="schedule_date"]');
    const dueInput = box.querySelector('input[name="due_date"]');
    dueInput.classList.toggle('hidden', val !== 'until');
  }
  function updateCount() {
    const n = document.querySelectorAll('.student-check:checked').length;
    document.getElementById('selectedCount').textContent = n + ' student' + (n===1?'':'s') + ' selected';
  }
  document.querySelectorAll('.student-check').forEach(c => c.addEventListener('change', updateCount));
  function filterStudents() {
    const q = document.getElementById('studentSearch').value.toLowerCase();
    document.querySelectorAll('.student-row').forEach(r => {
      r.style.display = (r.dataset.name.includes(q) || r.dataset.email.includes(q)) ? '' : 'none';
    });
  }
  document.querySelector('form').addEventListener('submit', function (e) {
    const val = document.querySelector('input[name="schedule"]:checked').value;
    const dateInput = document.querySelector('input[name="schedule_date"]');
    const dueInput = document.querySelector('input[name="due_date"]');
    if (val === 'until') { dueInput.value = dateInput.value; dueInput.disabled = false; dateInput.disabled = true; }
    else { dueInput.disabled = true; dateInput.disabled = (val === 'now'); }
  });
  toggleAssignBoxes();
  toggleSchedule();
  updateCount();
</script>
</body>
</html>
