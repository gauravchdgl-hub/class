<!DOCTYPE html>
<html lang="en" class="h-full bg-[#f4f6fa]">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= tutorial ? 'Edit Tutorial' : 'Add Tutorial' %> — AUS Academy</title>
<link rel="stylesheet" href="/assets/tailwind.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<%- include('../partials/tw_head_styles') %>
</head>
<body class="h-full antialiased flex flex-col text-slate-800">
<div class="flex flex-1 min-h-screen overflow-hidden">
  <%- include('../partials/tw_sidebar', { active: tutorial ? 'tutorial-edit' : 'tutorial-new' }) %>

  <main class="flex-1 flex flex-col min-w-0 overflow-y-auto">
    <%- include('../partials/tw_header', { searchPlaceholder: 'Search...' }) %>

    <div class="p-4 sm:p-6 space-y-6 max-w-7xl mx-auto w-full">

      <div class="flex flex-col md:flex-row md:items-start justify-between gap-4">
        <div class="flex items-start space-x-4">
          <a href="/admin/tutorials" class="w-9 h-9 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center hover:bg-blue-100 transition shrink-0 mt-0.5 border border-blue-100" title="Go Back"><i class="fa-solid fa-arrow-left"></i></a>
          <div>
            <h1 class="text-2xl sm:text-[28px] font-bold text-[#091e42] tracking-tight"><%= tutorial ? 'Edit Tutorial' : 'Add Tutorial' %></h1>
            <p class="text-[13px] text-slate-500 mt-1">Create and publish a tutorial video for a subject and year level.</p>
          </div>
        </div>
        <nav class="flex text-[13px] text-slate-500 space-x-2 pt-2 md:pt-0 shrink-0 font-medium">
          <a href="/admin/dashboard" class="hover:text-blue-600 transition">Home</a><span class="text-slate-400">&gt;</span>
          <a href="/admin/tutorials" class="hover:text-blue-600 transition">Tutorials</a><span class="text-slate-400">&gt;</span>
          <span class="text-[#091e42] font-semibold"><%= tutorial ? 'Edit Tutorial' : 'Add Tutorial' %></span>
        </nav>
      </div>

      <form method="post" enctype="multipart/form-data" action="<%= tutorial ? '/admin/tutorials/' + tutorial.id + '/edit' : '/admin/tutorials/new' %>">
        <div class="grid grid-cols-1 xl:grid-cols-3 gap-6 items-start">

          <div class="xl:col-span-2 space-y-6">
            <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden p-6">
              <div class="flex items-center space-x-2 mb-5"><i class="fa-solid fa-file-lines text-blue-600"></i><h2 class="text-base font-bold text-[#091e42]">Basic Information</h2></div>

              <div class="flex flex-col lg:flex-row gap-6">
                <div class="flex-1 space-y-5">
                  <div>
                    <label class="block text-[13px] font-semibold text-[#091e42] mb-1.5">Title <span class="text-red-500">*</span></label>
                    <input type="text" name="title" required value="<%= tutorial ? tutorial.title : '' %>" placeholder="Enter tutorial title (e.g. Introduction to Economics)" class="w-full bg-white border border-slate-200 rounded-lg px-3.5 py-2.5 text-[13px] text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition shadow-sm">
                  </div>
                  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
                    <div>
                      <label class="block text-[13px] font-semibold text-[#091e42] mb-1.5">Subject <span class="text-red-500">*</span></label>
                      <select name="subject_id" required class="custom-select w-full bg-white border border-slate-200 rounded-lg px-3 py-2.5 text-[13px] text-slate-600 focus:outline-none focus:ring-2 focus:ring-blue-500 transition shadow-sm">
                        <option value="">Select subject</option>
                        <% subjects.forEach(s => { %><option value="<%= s.id %>" <%= tutorial && tutorial.subject_id==s.id ? 'selected':'' %>><%= s.name %> (<%= s.year %>)</option><% }) %>
                      </select>
                    </div>
                    <div>
                      <label class="block text-[13px] font-semibold text-[#091e42] mb-1.5">Year <span class="text-red-500">*</span></label>
                      <select name="year" required class="custom-select w-full bg-white border border-slate-200 rounded-lg px-3 py-2.5 text-[13px] text-slate-600 focus:outline-none focus:ring-2 focus:ring-blue-500 transition shadow-sm">
                        <option value="">Select year</option>
                        <option value="Year 11" <%= tutorial && tutorial.year==='Year 11'?'selected':'' %>>Year 11</option>
                        <option value="Year 12" <%= tutorial && tutorial.year==='Year 12'?'selected':'' %>>Year 12</option>
                      </select>
                    </div>
                    <div>
                      <label class="block text-[13px] font-semibold text-[#091e42] mb-1.5">Duration (minutes)</label>
                      <div class="relative">
                        <i class="fa-regular fa-clock absolute left-3 top-[11px] text-slate-400 text-[13px]"></i>
                        <input type="number" min="0" name="duration_minutes" value="<%= tutorial ? tutorial.duration_minutes : '' %>" placeholder="e.g. 45" class="w-full bg-white border border-slate-200 rounded-lg pl-8 pr-3 py-2.5 text-[13px] text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 transition shadow-sm">
                      </div>
                    </div>
                    <div>
                      <label class="block text-[13px] font-semibold text-[#091e42] mb-1.5">Difficulty Level</label>
                      <select name="level" class="custom-select w-full bg-white border border-slate-200 rounded-lg px-3 py-2.5 text-[13px] text-slate-600 focus:outline-none focus:ring-2 focus:ring-blue-500 transition shadow-sm">
                        <% ['Beginner','Intermediate','Advanced'].forEach(l => { %><option value="<%= l %>" <%= tutorial && tutorial.level===l ? 'selected' : (!tutorial && l==='Beginner' ? 'selected':'') %>><%= l %></option><% }) %>
                      </select>
                    </div>
                  </div>
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                      <label class="block text-[13px] font-semibold text-[#091e42] mb-1.5">Module</label>
                      <input type="text" name="module" value="<%= tutorial ? (tutorial.module||'') : '' %>" placeholder="e.g. Module 1: Foundations" class="w-full bg-white border border-slate-200 rounded-lg px-3.5 py-2.5 text-[13px] text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 transition shadow-sm">
                    </div>
                    <div>
                      <label class="block text-[13px] font-semibold text-[#091e42] mb-1.5">Lesson</label>
                      <input type="text" name="lesson" value="<%= tutorial ? (tutorial.lesson||'') : '' %>" placeholder="e.g. Lesson 1: Introduction" class="w-full bg-white border border-slate-200 rounded-lg px-3.5 py-2.5 text-[13px] text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 transition shadow-sm">
                    </div>
                  </div>
                </div>

                <div class="w-full lg:w-[220px] shrink-0 flex flex-col">
                  <div class="flex items-center space-x-2 mb-1.5"><i class="fa-regular fa-image text-blue-600 text-[13px]"></i><label class="block text-[13px] font-semibold text-[#091e42]">Thumbnail</label></div>
                  <label class="flex-1 border border-slate-200 rounded-xl flex flex-col items-center justify-center p-4 cursor-pointer hover:bg-slate-50 transition group text-center min-h-[140px] shadow-sm">
                    <input type="file" name="thumbnail" accept="image/*" class="hidden" onchange="previewThumb(this)">
                    <% if (tutorial && tutorial.thumbnail_url) { %>
                      <img src="<%= tutorial.thumbnail_url %>" id="thumbPreview" class="w-full h-20 object-cover rounded-lg mb-2">
                    <% } else { %>
                      <div class="w-10 h-10 rounded-lg text-slate-400 flex items-center justify-center text-2xl mb-2 group-hover:text-blue-500 transition-colors"><i class="fa-regular fa-image"></i></div>
                    <% } %>
                    <span class="text-[13px] font-semibold text-blue-600">Upload Thumbnail</span>
                    <span class="text-[10px] text-slate-500 mt-1 block">JPG, PNG or WebP (1280 × 720px)</span>
                  </label>
                </div>
              </div>

              <div class="mt-6">
                <label class="block text-[13px] font-semibold text-[#091e42] mb-1.5">Description</label>
                <div class="border border-slate-200 rounded-lg overflow-hidden focus-within:ring-2 focus-within:ring-blue-500 focus-within:border-blue-500 transition bg-white shadow-sm">
                  <div class="bg-white border-b border-slate-200 px-3 py-2 flex flex-wrap items-center gap-1">
                    <button type="button" class="rt-btn font-bold">B</button><button type="button" class="rt-btn italic">I</button><button type="button" class="rt-btn underline">U</button>
                    <div class="w-px h-5 bg-slate-200 mx-1"></div>
                    <button type="button" class="rt-btn"><i class="fa-solid fa-list-ul"></i></button>
                    <button type="button" class="rt-btn"><i class="fa-solid fa-list-ol"></i></button>
                  </div>
                  <textarea name="description" rows="4" maxlength="1000" placeholder="Write a short description about this tutorial..." class="w-full p-4 text-[13px] text-slate-700 placeholder-slate-400 outline-none resize-y min-h-[140px]"><%= tutorial ? (tutorial.description||'') : '' %></textarea>
                </div>
              </div>
            </div>

            <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden p-6">
              <div class="flex items-center space-x-2 mb-5"><i class="fa-solid fa-circle-play text-blue-600"></i><h2 class="text-base font-bold text-[#091e42]">Video</h2></div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-[13px] font-semibold text-[#091e42] mb-1.5">Video URL (YouTube/Vimeo/external)</label>
                  <input type="text" name="video_url" value="<%= tutorial ? (tutorial.video_url||'') : '' %>" placeholder="https://..." class="w-full bg-white border border-slate-200 rounded-lg px-3.5 py-2.5 text-[13px] text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 transition shadow-sm">
                </div>
                <div>
                  <label class="block text-[13px] font-semibold text-[#091e42] mb-1.5">Or upload a video file</label>
                  <input type="file" name="video_file" accept="video/*" class="w-full bg-white border border-slate-200 rounded-lg px-3 py-2 text-[13px] text-slate-600 shadow-sm">
                  <p class="text-[10px] text-slate-500 mt-1">If both are set, the uploaded file is used.</p>
                </div>
              </div>
            </div>
          </div>

          <div class="xl:col-span-1 space-y-6">
            <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-5">
              <div class="flex items-center space-x-2 mb-4"><i class="fa-solid fa-paper-plane text-blue-600"></i><h2 class="text-base font-bold text-[#091e42]">Publish</h2></div>
              <div class="space-y-4">
                <div>
                  <label class="block text-[13px] font-semibold text-[#091e42] mb-1.5">Status</label>
                  <select name="status" class="custom-select w-full bg-white border border-slate-200 rounded-lg px-3 py-2.5 text-[13px] text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-blue-500 transition cursor-pointer">
                    <option value="published" <%= (!tutorial || tutorial.is_published) ? 'selected' : '' %>>Publish Immediately</option>
                    <option value="draft" <%= tutorial && !tutorial.is_published ? 'selected' : '' %>>Save as Draft</option>
                  </select>
                </div>
                <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold text-[13px] px-4 py-2.5 rounded-lg transition shadow-sm flex items-center justify-center space-x-2">
                  <i class="fa-solid fa-paper-plane text-xs"></i><span><%= tutorial ? 'Save Changes' : 'Publish Tutorial' %></span>
                </button>
              </div>
            </div>

            <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-5">
              <div class="flex items-center space-x-2 mb-5"><i class="fa-solid fa-gear text-blue-600"></i><h2 class="text-base font-bold text-[#091e42]">Additional Settings</h2></div>
              <div class="space-y-4">
                <label class="flex items-center justify-between cursor-pointer">
                  <span class="flex items-center space-x-2.5 text-[13px] text-[#091e42] font-medium"><i class="fa-regular fa-comments text-slate-400 w-4 text-center"></i><span>Allow Comments</span></span>
                  <input type="checkbox" name="allow_comments" <%= (!tutorial || tutorial.allow_comments) ? 'checked' : '' %> class="w-9 h-5 accent-blue-600">
                </label>
                <label class="flex items-center justify-between cursor-pointer">
                  <span class="flex items-center space-x-2.5 text-[13px] text-[#091e42] font-medium"><i class="fa-solid fa-download text-slate-400 w-4 text-center"></i><span>Allow Download</span></span>
                  <input type="checkbox" name="allow_download" <%= tutorial && tutorial.allow_download ? 'checked' : '' %> class="w-9 h-5 accent-blue-600">
                </label>
                <label class="flex items-center justify-between cursor-pointer">
                  <span class="flex items-center space-x-2.5 text-[13px] text-[#091e42] font-medium"><i class="fa-regular fa-star text-slate-400 w-4 text-center"></i><span>Mark as Featured</span></span>
                  <input type="checkbox" name="is_featured" <%= tutorial && tutorial.is_featured ? 'checked' : '' %> class="w-9 h-5 accent-blue-600">
                </label>
              </div>
            </div>

            <% if (!tutorial) { %>
            <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-5">
              <div class="flex items-center space-x-2 mb-4"><i class="fa-solid fa-user-group text-blue-600"></i><h2 class="text-base font-bold text-[#091e42]">Assign To</h2></div>
              <div class="space-y-3">
                <label class="flex items-start space-x-3 cursor-pointer"><input type="radio" name="assignto" value="none" checked class="mt-1"><span class="text-[13px] font-semibold text-[#091e42]">None (assign later)</span></label>
                <label class="flex items-start space-x-3 cursor-pointer"><input type="radio" name="assignto" value="students" onchange="document.getElementById('assignStudentsBox').classList.remove('hidden')" class="mt-1"><span class="text-[13px] font-medium text-[#091e42]">Specific Students</span></label>
              </div>
              <div id="assignStudentsBox" class="hidden mt-3 max-h-48 overflow-y-auto border border-slate-200 rounded-lg p-2 space-y-1">
                <% students.forEach(s => { %>
                  <label class="flex items-center space-x-2 text-xs py-1 cursor-pointer"><input type="checkbox" name="student_ids" value="<%= s.id %>"><span><%= s.name %> — <%= s.email %></span></label>
                <% }) %>
              </div>
              <div class="mt-3"><label class="block text-[13px] font-semibold text-[#091e42] mb-1.5">Due date (optional)</label><input type="date" name="due_date" class="w-full bg-white border border-slate-200 rounded-lg px-3 py-2 text-[13px]"></div>
            </div>
            <% } %>

            <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-5">
              <div class="flex items-center space-x-2 mb-4"><i class="fa-solid fa-tags text-blue-600"></i><h2 class="text-base font-bold text-[#091e42]">Tags</h2></div>
              <input type="text" name="tags" value="<%= tutorial ? (tutorial.tags||'') : '' %>" placeholder="Add tags (e.g. Algebra, Basics, Revision)" class="w-full bg-white border border-slate-200 rounded-lg px-3 py-2.5 text-[13px] text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition shadow-sm">
            </div>
          </div>
        </div>
      </form>

    </div>
  </main>
</div>
<%- include('../partials/tw_scripts') %>
<script>
  function previewThumb(input) {
    if (!input.files || !input.files[0]) return;
    const reader = new FileReader();
    reader.onload = (e) => {
      let img = document.getElementById('thumbPreview');
      if (!img) { img = document.createElement('img'); img.id = 'thumbPreview'; img.className = 'w-full h-20 object-cover rounded-lg mb-2'; input.closest('label').prepend(img); }
      img.src = e.target.result;
    };
    reader.readAsDataURL(input.files[0]);
  }
</script>
</body>
</html>
