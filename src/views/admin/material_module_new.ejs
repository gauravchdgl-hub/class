<!DOCTYPE html>
<html lang="en" class="h-full bg-[#f4f6fa]">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Add Class Module/ Topic/ Year — AUS Academy</title>
<link rel="stylesheet" href="/assets/tailwind.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<%- include('../partials/tw_head_styles') %>
</head>
<body class="h-full antialiased flex flex-col text-slate-800">
<div class="flex flex-1 min-h-screen overflow-hidden">
  <%- include('../partials/tw_sidebar', { active: 'material-module' }) %>
  <main class="flex-1 flex flex-col min-w-0 overflow-y-auto">
    <%- include('../partials/tw_header', { searchPlaceholder: 'Search students, subjects, tutorials, or anything...' }) %>

    <div class="p-4 sm:p-6 lg:p-8 max-w-[1400px] mx-auto w-full flex-1 flex flex-col space-y-6">

      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="flex items-center space-x-3">
          <a href="/admin/material" class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 border border-blue-200 hover:bg-blue-100 flex items-center justify-center transition shadow-sm"><i class="fa-solid fa-arrow-left text-sm"></i></a>
          <div>
            <h1 class="text-2xl sm:text-[28px] font-extrabold text-[#091e42] tracking-tight">Add Class Module/ Topic/ Year</h1>
            <p class="text-xs sm:text-sm text-slate-500 mt-0.5">Create and organize class, year level and module/topic for your subjects.</p>
          </div>
        </div>
        <nav class="flex text-xs font-semibold text-slate-500 space-x-2 shrink-0">
          <a href="/admin/dashboard" class="hover:text-blue-600 transition">Home</a><span class="text-slate-400">&gt;</span>
          <a href="/admin/material" class="hover:text-blue-600 transition">Study Material</a><span class="text-slate-400">&gt;</span>
          <span class="text-blue-600 font-bold">Add Class Module/ Topic/ Year</span>
        </nav>
      </div>

      <form method="post" action="<%= item ? ('/admin/material/module/' + item.id + '/edit') : '/admin/material/module' %>" class="bg-white rounded-3xl border border-slate-200 card-shadow p-6 sm:p-8 space-y-6">

        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          <div class="space-y-1.5">
            <label class="block text-xs font-bold text-slate-800">Subject <span class="text-red-500">*</span></label>
            <select name="subject_id" required class="form-input custom-select text-xs font-semibold text-slate-800">
              <option value="" disabled <%= !item ? 'selected' : '' %>>Select subject</option>
              <% subjects.forEach(s => { %><option value="<%= s.id %>" <%= item && item.subject_id === s.id ? 'selected' : '' %>><%= s.name %> (<%= s.year %>)</option><% }) %>
            </select>
          </div>
          <div class="space-y-1.5">
            <label class="block text-xs font-bold text-slate-800">Class <span class="text-red-500">*</span></label>
            <input type="text" name="class_name" value="<%= item ? (item.class_name||'') : '' %>" required placeholder="Enter class name" class="form-input">
            <p class="text-[10px] text-slate-400 font-medium pl-1">e.g. Australia Year 11–12, A Level, IB</p>
          </div>
          <div class="space-y-1.5">
            <label class="block text-xs font-bold text-slate-800">Year Level <span class="text-red-500">*</span></label>
            <input type="text" name="year_level" value="<%= item ? (item.year_level||'') : '' %>" required placeholder="Enter year level" class="form-input">
            <p class="text-[10px] text-slate-400 font-medium pl-1">e.g. Year 11, Year 12, or custom</p>
          </div>
        </div>

        <div class="space-y-1.5">
          <label class="block text-xs font-bold text-slate-800">Module / Topic <span class="text-red-500">*</span></label>
          <input type="text" name="title" value="<%= item ? item.title : '' %>" required placeholder="Enter module or topic name" class="form-input">
          <p class="text-[10px] text-slate-400 font-medium pl-1">e.g. Module 1, Unit 1, Chapter 2, Functions, Algebra</p>
        </div>

        <div class="space-y-1.5">
          <label class="block text-xs font-bold text-slate-800">Description (Optional)</label>
          <textarea name="description" rows="4" maxlength="1000" placeholder="Write a short description about this class, year level or module/topic..." class="form-input resize-y"><%= item ? (item.description||'') : '' %></textarea>
        </div>

        <div class="bg-slate-50 border border-slate-200/80 rounded-2xl p-5 grid grid-cols-1 sm:grid-cols-2 gap-6 items-center">
          <div class="space-y-1">
            <label class="block text-xs font-bold text-slate-800 flex items-center space-x-2"><i class="fa-solid fa-gear text-blue-600 text-xs"></i><span>Status</span></label>
            <div class="flex items-center space-x-3 pt-1">
              <label class="relative inline-flex items-center cursor-pointer">
                <input type="checkbox" name="is_active" <%= (!item || item.is_active) ? 'checked' : '' %> class="sr-only peer">
                <div class="w-11 h-6 bg-slate-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
              </label>
              <div><span class="text-xs font-bold text-slate-900 block leading-tight">Active</span><span class="text-[11px] text-slate-500 font-medium">Make this available for study materials</span></div>
            </div>
          </div>
          <div class="space-y-1.5">
            <label class="block text-xs font-bold text-slate-800">Display Order</label>
            <input type="number" name="order_no" value="<%= item ? item.order_no : 1 %>" class="form-input font-bold text-slate-800">
            <p class="text-[10px] text-slate-400 font-medium pl-1">Lower number will appear first</p>
          </div>
        </div>

        <div class="flex items-center justify-end space-x-3 pt-4 border-t border-slate-100">
          <a href="/admin/material" class="px-6 py-3 rounded-xl border border-blue-200 bg-white text-blue-600 font-bold text-xs hover:bg-blue-50 transition shadow-sm">Cancel</a>
          <button type="submit" class="px-7 py-3 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs shadow-md shadow-blue-600/30 transition flex items-center space-x-2">
            <i class="fa-solid fa-floppy-disk text-xs"></i><span><%= item ? 'Save Changes' : 'Save Class Module/ Topic/ Year' %></span>
          </button>
        </div>
      </form>

      <% if (!item) { %>
      <div class="bg-white rounded-2xl border border-slate-200 card-shadow overflow-hidden">
        <div class="p-5 border-b border-slate-100"><h3 class="font-bold text-sm text-slate-800">Existing Class Modules / Topics / Years</h3></div>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-50 text-slate-500 font-semibold border-b border-slate-200 uppercase tracking-wider text-[10px]">
              <tr><th class="py-3 px-4">Subject</th><th class="py-3 px-4">Class</th><th class="py-3 px-4">Year Level</th><th class="py-3 px-4">Module/Topic</th><th class="py-3 px-4">Status</th><th class="py-3 px-4 text-right">Actions</th></tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-slate-700 font-medium">
              <% (typeof allModules !== 'undefined' ? allModules : []).forEach(m => { %>
                <tr class="hover:bg-slate-50">
                  <td class="py-3 px-4"><%= m.subject_name %></td>
                  <td class="py-3 px-4"><%= m.class_name || '—' %></td>
                  <td class="py-3 px-4"><%= m.year_level || '—' %></td>
                  <td class="py-3 px-4 font-bold text-slate-900"><%= m.title %></td>
                  <td class="py-3 px-4"><span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold <%= m.is_active ? 'bg-emerald-50 text-emerald-600' : 'bg-slate-100 text-slate-500' %>"><%= m.is_active ? 'Active' : 'Inactive' %></span></td>
                  <td class="py-3 px-4 text-right space-x-1">
                    <a href="/admin/material/module/<%= m.id %>/edit" class="w-7 h-7 rounded bg-slate-50 hover:bg-blue-50 hover:text-blue-600 text-slate-500 transition inline-flex items-center justify-center"><i class="fa-solid fa-pen-to-square text-xs"></i></a>
                    <form method="post" action="/admin/material/module/<%= m.id %>/delete" class="inline" onsubmit="return confirm('Delete this module? Its study materials will be unassigned, not deleted.');"><button class="w-7 h-7 rounded bg-slate-50 hover:bg-red-50 hover:text-red-600 text-slate-500 transition inline-flex items-center justify-center"><i class="fa-solid fa-trash text-xs"></i></button></form>
                  </td>
                </tr>
              <% }) %>
              <% if (!(typeof allModules !== 'undefined' ? allModules : []).length) { %><tr><td colspan="6" class="p-4 text-center text-slate-400">None yet.</td></tr><% } %>
            </tbody>
          </table>
        </div>
      </div>
      <% } %>

    </div>
  </main>
</div>
<%- include('../partials/tw_scripts') %>
</body>
</html>
