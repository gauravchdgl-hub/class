<%- include('../partials/header', { title: 'MCQ Plans' }) %>
<div class="nav-tabs">
  <a href="/admin/dashboard">Dashboard</a>
  <a href="/admin/subjects">Subjects</a>
  <a class="active" href="/admin/mcq-plans">MCQ Plans</a>
  <a href="/admin/mcqs">MCQ Bank</a>
  <a href="/admin/papers">Exam Papers</a>
  <a href="/admin/submissions">Submissions</a>
</div>
<div class="grid grid-2">
  <div class="card">
    <h3>Create MCQ Plan</h3>
    <p class="muted">Set any MCQ count you want — no fixed limit.</p>
    <form method="post" action="/admin/mcq-plans">
      <label>Plan Name</label><input type="text" name="name" required>
      <label>Number of MCQs</label><input type="number" name="mcq_count" min="1" required>
      <label>Price (A$)</label><input type="number" step="0.01" name="price" required>
      <label>Validity (days)</label><input type="number" name="validity_days" value="30" required>
      <button class="btn" type="submit">Create Plan</button>
    </form>
  </div>
  <div class="card">
    <h3>Existing Plans</h3>
    <table><tr><th>Name</th><th>MCQs</th><th>Price</th><th>Validity</th></tr>
      <% plans.forEach(p => { %>
        <tr><td><%= p.name %></td><td><%= p.mcq_count %></td><td>A$<%= p.price.toFixed(2) %></td><td><%= p.validity_days %>d</td></tr>
      <% }) %>
    </table>
  </div>
</div>
<%- include('../partials/footer') %>
