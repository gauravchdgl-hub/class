<!DOCTYPE html>
<html lang="en" class="h-full bg-[#f4f6fa]">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MCQ Plans — AUS Academy</title>
<link rel="stylesheet" href="/assets/tailwind.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<%- include('../partials/tw_head_styles') %>
</head>
<body class="h-full antialiased flex flex-col text-slate-800">
<div class="flex flex-1 min-h-screen overflow-hidden">
  <%- include('../partials/tw_sidebar', { active: 'mcq-plans' }) %>
  <main class="flex-1 flex flex-col min-w-0 overflow-y-auto bg-slate-50">
    <%- include('../partials/tw_header', { searchPlaceholder: 'Search students, subjects, MCQs, or anything...' }) %>

    <div class="p-4 sm:p-6 lg:p-8 max-w-[1500px] mx-auto w-full flex-1 flex flex-col space-y-6">

      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 border border-blue-200 flex items-center justify-center text-lg shrink-0"><i class="fa-solid fa-layer-group"></i></div>
          <div>
            <h1 class="text-2xl sm:text-[28px] font-extrabold text-[#091e42] tracking-tight">MCQ Plans</h1>
            <p class="text-xs sm:text-sm text-slate-500 mt-0.5">Create and manage MCQ plans for students. Set question limits, subjects, class, year level and assign MCQs to each plan.</p>
          </div>
        </div>
        <div class="flex items-center space-x-3 shrink-0">
          <nav class="hidden md:flex text-xs font-semibold text-slate-500 space-x-2 mr-2">
            <a href="/admin/dashboard" class="hover:text-blue-600 transition">Home</a><span class="text-slate-400">&gt;</span>
            <a href="/admin/mcqs" class="hover:text-blue-600 transition">MCQ Question Bank</a><span class="text-slate-400">&gt;</span>
            <span class="text-blue-600 font-bold">MCQ Plans</span>
          </nav>
          <a href="/admin/mcq-plans/new" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs sm:text-sm px-4 py-2.5 rounded-xl transition shadow-md shadow-blue-500/20 flex items-center space-x-2">
            <i class="fa-solid fa-plus text-xs"></i><span>Add New Plan</span>
          </a>
        </div>
      </div>

      <!-- 4 KPI SUMMARY CARDS -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
        <div class="bg-white rounded-2xl border border-slate-200 p-5 card-shadow flex items-center space-x-4">
          <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-xl shrink-0"><i class="fa-solid fa-layer-group"></i></div>
          <div><p class="text-xs font-semibold text-slate-500">Total Plans</p><h3 class="text-2xl font-extrabold text-slate-900 mt-0.5"><%= kpis.total %></h3></div>
        </div>
        <div class="bg-white rounded-2xl border border-slate-200 p-5 card-shadow flex items-center space-x-4">
          <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl shrink-0"><i class="fa-solid fa-circle-check"></i></div>
          <div><p class="text-xs font-semibold text-slate-500">Active Plans</p><h3 class="text-2xl font-extrabold text-slate-900 mt-0.5"><%= kpis.active %></h3></div>
        </div>
        <div class="bg-white rounded-2xl border border-slate-200 p-5 card-shadow flex items-center space-x-4">
          <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl shrink-0"><i class="fa-solid fa-list-check"></i></div>
          <div><p class="text-xs font-semibold text-slate-500">Plans with MCQs Assigned</p><h3 class="text-2xl font-extrabold text-slate-900 mt-0.5"><%= kpis.withMcqs %></h3></div>
        </div>
        <div class="bg-white rounded-2xl border border-slate-200 p-5 card-shadow flex items-center space-x-4">
          <div class="w-12 h-12 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center text-xl shrink-0"><i class="fa-solid fa-circle-pause"></i></div>
          <div><p class="text-xs font-semibold text-slate-500">Inactive Plans</p><h3 class="text-2xl font-extrabold text-slate-900 mt-0.5"><%= kpis.inactive %></h3></div>
        </div>
      </div>

      <!-- MCQ PLANS TABLE CONTAINER -->
      <div class="bg-white rounded-2xl border border-slate-200 card-shadow overflow-hidden space-y-4 p-4 sm:p-5">
        <form method="get" class="flex flex-col lg:flex-row items-center justify-between gap-3">
          <div class="relative w-full lg:w-80">
            <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-3 text-slate-400 text-xs"></i>
            <input type="text" disabled placeholder="Search plans by name, subject, class, or year level..." class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-9 pr-4 py-2 text-xs">
          </div>
          <div class="flex flex-wrap items-center gap-2.5 w-full lg:w-auto">
            <div class="space-y-0.5">
              <label class="text-[10px] font-bold text-slate-500 uppercase block">Subject</label>
              <select name="subject_id" onchange="this.form.submit()" class="bg-slate-50 border border-slate-200 rounded-xl px-3 py-1.5 text-xs font-medium text-slate-700 custom-select">
                <option value="">All Subjects</option>
                <% subjects.forEach(s => { %><option value="<%= s.id %>" <%= String(filters.subject_id)===String(s.id)?'selected':'' %>><%= s.name %> (<%= s.year %>)</option><% }) %>
              </select>
            </div>
            <div class="space-y-0.5">
              <label class="text-[10px] font-bold text-slate-500 uppercase block">Class</label>
              <select name="class_name" onchange="this.form.submit()" class="bg-slate-50 border border-slate-200 rounded-xl px-3 py-1.5 text-xs font-medium text-slate-700 custom-select">
                <option value="">All Classes</option>
                <% classNames.forEach(c => { %><option value="<%= c %>" <%= filters.class_name===c?'selected':'' %>><%= c %></option><% }) %>
              </select>
            </div>
            <div class="space-y-0.5">
              <label class="text-[10px] font-bold text-slate-500 uppercase block">Year Level</label>
              <select name="year_level" onchange="this.form.submit()" class="bg-slate-50 border border-slate-200 rounded-xl px-3 py-1.5 text-xs font-medium text-slate-700 custom-select">
                <option value="">All Years</option>
                <% yearLevels.forEach(y => { %><option value="<%= y %>" <%= filters.year_level===y?'selected':'' %>><%= y %></option><% }) %>
              </select>
            </div>
            <div class="space-y-0.5">
              <label class="text-[10px] font-bold text-slate-500 uppercase block">Status</label>
              <select name="status" onchange="this.form.submit()" class="bg-slate-50 border border-slate-200 rounded-xl px-3 py-1.5 text-xs font-medium text-slate-700 custom-select">
                <option value="">All Status</option>
                <option value="active" <%= filters.status==='active'?'selected':'' %>>Active</option>
                <option value="inactive" <%= filters.status==='inactive'?'selected':'' %>>Inactive</option>
              </select>
            </div>
            <div class="pt-4">
              <a href="/admin/mcq-plans" class="px-3 py-1.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-blue-600 text-xs font-semibold flex items-center space-x-1.5 transition">
                <i class="fa-solid fa-rotate text-xs"></i><span>Reset</span>
              </a>
            </div>
          </div>
        </form>

        <div class="overflow-x-auto w-full">
          <table class="w-full text-left border-collapse whitespace-nowrap min-w-[1000px]">
            <thead>
              <tr class="bg-slate-50 border-y border-slate-200 text-[11px] uppercase tracking-wider text-slate-500 font-bold">
                <th class="py-3 px-4 w-10">#</th>
                <th class="py-3 px-4">Plan Name</th>
                <th class="py-3 px-4">Subject</th>
                <th class="py-3 px-4">Class</th>
                <th class="py-3 px-4">Year Level</th>
                <th class="py-3 px-4">Total MCQs</th>
                <th class="py-3 px-4">Valid For</th>
                <th class="py-3 px-4">Assigned MCQs</th>
                <th class="py-3 px-4">Status</th>
                <th class="py-3 px-4 text-center">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-xs text-slate-700 font-medium">
              <% plans.forEach((p, i) => { %>
                <tr class="hover:bg-slate-50 transition">
                  <td class="py-3.5 px-4 text-slate-400 font-bold"><%= i + 1 %></td>
                  <td class="py-3.5 px-4 font-bold text-slate-900 flex items-center space-x-2.5">
                    <div class="w-7 h-7 rounded-lg bg-blue-100 text-blue-600 flex items-center justify-center text-xs shrink-0"><i class="fa-solid fa-book-bookmark"></i></div>
                    <span><%= p.name %></span>
                  </td>
                  <td class="py-3.5 px-4 text-blue-600 font-medium"><%= p.subject_name || '—' %></td>
                  <td class="py-3.5 px-4"><%= p.class_name || '—' %></td>
                  <td class="py-3.5 px-4"><%= p.year_level || '—' %></td>
                  <td class="py-3.5 px-4 font-semibold"><%= p.mcq_count %></td>
                  <td class="py-3.5 px-4"><%= Math.round(p.validity_days / 30) %> Month<%= Math.round(p.validity_days/30) === 1 ? '' : 's' %></td>
                  <td class="py-3.5 px-4 font-semibold"><%= p.curated_count %></td>
                  <td class="py-3.5 px-4">
                    <% if (p.is_active) { %>
                      <span class="bg-emerald-50 text-emerald-700 border border-emerald-200 font-bold px-2.5 py-0.5 rounded-full text-[10px] inline-flex items-center gap-1"><i class="fa-solid fa-circle text-[6px]"></i> Active</span>
                    <% } else { %>
                      <span class="bg-slate-100 text-slate-500 border border-slate-200 font-bold px-2.5 py-0.5 rounded-full text-[10px] inline-flex items-center gap-1"><i class="fa-solid fa-circle text-[6px]"></i> Inactive</span>
                    <% } %>
                  </td>
                  <td class="py-3.5 px-4 text-center space-x-1.5">
                    <a href="/admin/mcq-plans/<%= p.id %>/edit" title="Edit" class="p-1.5 text-slate-600 hover:bg-slate-100 rounded-lg transition inline-block"><i class="fa-solid fa-pen"></i></a>
                    <a href="/admin/mcq-plans/<%= p.id %>/questions" title="Assign MCQs" class="p-1.5 text-blue-600 hover:bg-blue-50 rounded-lg transition inline-block"><i class="fa-solid fa-link"></i></a>
                    <form method="post" action="/admin/mcq-plans/<%= p.id %>/duplicate" class="inline-block" onsubmit="return confirm('Duplicate this plan? A new inactive copy with the same MCQs will be created.');">
                      <button type="submit" title="Duplicate" class="p-1.5 text-slate-600 hover:bg-slate-100 rounded-lg transition"><i class="fa-solid fa-copy"></i></button>
                    </form>
                  </td>
                </tr>
              <% }) %>
              <% if (!plans.length) { %>
                <tr><td colspan="10" class="py-8 px-4 text-center text-slate-400">No MCQ plans match these filters.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </main>
</div>
<%- include('../partials/tw_scripts') %>
</body>
</html>
