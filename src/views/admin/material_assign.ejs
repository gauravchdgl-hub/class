<!DOCTYPE html>
<html lang="en" class="h-full bg-[#f4f6fa]">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Assign Study Material — AUS Academy</title>
<link rel="stylesheet" href="/assets/tailwind.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<%- include('../partials/tw_head_styles') %>
</head>
<body class="h-full antialiased flex flex-col text-slate-800">
<div class="flex flex-1 min-h-screen overflow-hidden">
  <%- include('../partials/tw_sidebar', { active: 'material-assign' }) %>

  <main class="flex-1 flex flex-col min-w-0 overflow-y-auto">
    <%- include('../partials/tw_header', { searchPlaceholder: 'Search students, study material, subjects...' }) %>

    <div class="p-4 sm:p-6 space-y-6 max-w-7xl mx-auto w-full">

      <div class="flex items-center justify-between gap-4">
        <div class="flex items-center gap-4">
          <a href="/admin/material" class="w-9 h-9 rounded-full bg-white border border-slate-200 text-slate-600 flex items-center justify-center hover:bg-slate-100 transition-colors shadow-sm"><i class="fa-solid fa-arrow-left text-sm"></i></a>
          <div>
            <h1 class="text-2xl font-bold text-slate-900">Assign Study Material</h1>
            <p class="text-sm text-slate-500 mt-0.5">Select students or classes and configure assignment settings for this material.</p>
          </div>
        </div>
        <div class="text-xs font-medium text-slate-500 flex items-center gap-1.5">
          <a href="/admin/dashboard" class="hover:text-blue-600">Home</a><i class="fa-solid fa-chevron-right text-[10px] text-slate-400"></i>
          <a href="/admin/material" class="hover:text-blue-600">Study Material</a><i class="fa-solid fa-chevron-right text-[10px] text-slate-400"></i>
          <span class="text-blue-600 font-semibold">Assign Study Material</span>
        </div>
      </div>

      <!-- Material Preview -->
      <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-sm flex flex-col md:flex-row gap-6 items-center">
        <div class="relative w-full md:w-72 h-32 rounded-lg overflow-hidden shrink-0 bg-slate-100 flex items-center justify-center border border-slate-200">
          <i class="fa-solid <%= material.content_type === 'video' ? 'fa-video' : material.content_type === 'link' ? 'fa-link' : material.content_type === 'ppt' ? 'fa-file-powerpoint' : material.content_type === 'zip' ? 'fa-file-zipper' : material.content_type === 'doc' ? 'fa-file-word' : 'fa-file-pdf' %> text-slate-400 text-3xl"></i>
          <span class="absolute top-2 left-2 bg-blue-600 text-white px-2.5 py-0.5 rounded font-bold text-[10px] shadow-sm"><%= (material.content_type||'pdf').toUpperCase() %></span>
        </div>
        <div class="flex-1 w-full">
          <h2 class="text-lg font-bold text-slate-900 tracking-tight"><%= material.title %></h2>
          <div class="flex flex-wrap items-center gap-4 mt-2 text-xs text-slate-600 font-medium">
            <span class="bg-blue-50 text-blue-700 px-2.5 py-1 rounded-md flex items-center gap-1.5 border border-blue-100"><i class="fa-solid fa-book-open text-blue-500"></i> <%= material.subject_name || '—' %></span>
            <span class="flex items-center gap-1.5"><i class="fa-regular fa-calendar text-slate-400"></i> <%= material.year || '—' %></span>
            <span class="flex items-center gap-1.5"><i class="fa-regular fa-file text-slate-400"></i> <%= material.fileMeta ? material.fileMeta.sizeLabel : '—' %></span>
            <span class="flex items-center gap-1.5"><i class="fa-regular fa-eye text-slate-400"></i> <%= material.views || 0 %> views</span>
          </div>
          <p class="text-xs text-slate-500 mt-2.5 leading-relaxed"><%= material.notes || '' %></p>
        </div>
      </div>

      <form method="post" action="/admin/material/<%= material.id %>/assign">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

          <div class="lg:col-span-7 space-y-6">
            <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 space-y-4">
              <h3 class="text-base font-bold text-slate-900 flex items-center gap-2"><i class="fa-solid fa-layer-group text-blue-600"></i> Assign To</h3>
              <div class="flex flex-wrap gap-4 text-xs font-semibold text-slate-700">
                <label class="flex items-center gap-2 cursor-pointer"><input type="radio" name="assignto" value="all" onchange="toggleAssignBoxes()" class="accent-blue-600"><span>All Students</span></label>
                <label class="flex items-center gap-2 cursor-pointer"><input type="radio" name="assignto" value="classes" onchange="toggleAssignBoxes()" class="accent-blue-600"><span>Specific Classes</span></label>
                <label class="flex items-center gap-2 cursor-pointer"><input type="radio" name="assignto" value="students" onchange="toggleAssignBoxes()" checked class="accent-blue-600"><span>Specific Students</span></label>
              </div>

              <div id="classesBox" class="hidden border border-slate-200 rounded-lg p-3 space-y-1 max-h-40 overflow-y-auto">
                <label class="flex items-center gap-2 text-xs font-semibold pb-1 border-b border-slate-100 mb-1"><input type="checkbox" onclick="document.querySelectorAll('.class-check').forEach(c=>c.checked=this.checked)"><span>Select All Classes</span></label>
                <% classes.forEach(c => { %>
                  <label class="flex items-center gap-2 text-xs py-1 cursor-pointer"><input type="checkbox" name="class_names" value="<%= c %>" class="class-check"><span><%= c %></span></label>
                <% }) %>
                <% if (!classes.length) { %><p class="text-xs text-slate-400">No classes found yet.</p><% } %>
              </div>

              <div id="studentsBox">
                <div class="relative">
                  <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                  <input type="text" id="studentSearch" onkeyup="filterStudents()" placeholder="Search and select students by name or email..." class="w-full bg-slate-50 border border-slate-200 rounded-lg pl-9 pr-3 py-2 text-xs text-slate-700 focus:outline-none focus:border-blue-500 transition-colors">
                </div>
                <div class="border border-slate-200 rounded-lg overflow-hidden mt-3">
                  <table class="w-full text-left text-xs">
                    <thead class="bg-slate-50 text-slate-500 font-semibold border-b border-slate-200 uppercase tracking-wider text-[10px]">
                      <tr><th class="p-3 w-10 text-center"><input type="checkbox" onclick="toggleAll(this)"></th><th class="py-3 px-2">Student Name</th><th class="py-3 px-2">Class</th><th class="py-3 px-3">Email</th></tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-slate-700 font-medium" id="studentRows">
                      <% students.forEach(s => { %>
                        <tr class="hover:bg-slate-50/80 transition-colors student-row" data-name="<%= s.name.toLowerCase() %>" data-email="<%= s.email.toLowerCase() %>">
                          <td class="p-3 text-center"><input type="checkbox" name="student_ids" value="<%= s.id %>" class="student-check" <%= alreadyAssigned.has(s.id) ? 'checked' : '' %>></td>
                          <td class="py-2.5 px-2 text-slate-900 font-semibold"><%= s.name %></td>
                          <td class="py-2.5 px-2 text-slate-600"><%= s.class_section || s.class_year || '—' %></td>
                          <td class="py-2.5 px-3 text-slate-500 font-normal"><%= s.email %></td>
                        </tr>
                      <% }) %>
                      <% if (!students.length) { %><tr><td colspan="4" class="p-4 text-center text-slate-400">No students yet.</td></tr><% } %>
                    </tbody>
                  </table>
                </div>
                <div class="flex items-center justify-between text-xs pt-3">
                  <span class="text-blue-600 font-semibold" id="selectedCount">0 students selected</span>
                  <button type="button" onclick="clearAll()" class="text-slate-500 hover:text-red-600 font-medium transition-colors">Clear All</button>
                </div>
              </div>
            </div>
          </div>

          <div class="lg:col-span-5 bg-white rounded-xl border border-slate-200 shadow-sm p-6 space-y-4">
            <h3 class="text-base font-bold text-slate-900 flex items-center gap-2"><i class="fa-solid fa-gear text-blue-600"></i> Assignment Settings</h3>
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Access Type</label>
              <select name="accesstype" class="custom-select w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-xs text-slate-800 font-medium focus:outline-none focus:border-blue-500">
                <option value="immediate" <%= material.access_type==='immediate' ? 'selected' : '' %>>Immediate Access</option>
                <option value="until_due" <%= material.access_type==='until_due' ? 'selected' : '' %>>Until Due Date</option>
                <option value="scheduled" <%= material.access_type==='scheduled' ? 'selected' : '' %>>Scheduled</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Due Date</label>
              <input type="date" name="due_date" value="<%= material.due_date || '' %>" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-xs text-slate-800 font-medium focus:outline-none focus:border-blue-500">
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Notify Students</label>
              <select name="notify" class="custom-select w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-xs text-slate-800 font-medium focus:outline-none focus:border-blue-500">
                <option value="yes">Yes, send email notification</option>
                <option value="no">No notification</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Allow Download</label>
              <select name="allow_download" class="custom-select w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-xs text-slate-800 font-medium focus:outline-none focus:border-blue-500">
                <option value="no" <%= !material.allow_download ? 'selected' : '' %>>No (View Only)</option>
                <option value="yes" <%= material.allow_download ? 'selected' : '' %>>Yes, Allow Download</option>
              </select>
            </div>
            <div class="space-y-2 pt-1">
              <label class="flex items-center gap-2 text-xs font-semibold text-slate-800">Custom message (optional)</label>
              <textarea name="custom_message" rows="3" maxlength="500" placeholder="Please review this material before the next class." class="w-full bg-slate-50 border border-slate-200 rounded-lg p-3 text-xs text-slate-700 focus:outline-none focus:border-blue-500 resize-none"></textarea>
            </div>
            <div class="grid grid-cols-2 gap-3 pt-3">
              <a href="/admin/material" class="w-full py-2.5 px-4 bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 font-semibold rounded-lg text-xs transition-colors text-center shadow-sm">Cancel</a>
              <button type="submit" class="w-full py-2.5 px-4 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg text-xs shadow-md shadow-blue-600/30 transition-colors text-center" id="assignBtn">Assign to Students</button>
            </div>
          </div>
        </div>
      </form>

    </div>
  </main>
</div>
<%- include('../partials/tw_scripts') %>
<script>
  function updateCount() {
    const n = document.querySelectorAll('.student-check:checked').length;
    document.getElementById('selectedCount').textContent = n + ' student' + (n===1?'':'s') + ' selected';
    document.getElementById('assignBtn').textContent = 'Assign to ' + n + ' Student' + (n===1?'':'s');
  }
  document.querySelectorAll('.student-check').forEach(c => c.addEventListener('change', updateCount));
  function toggleAll(box) { document.querySelectorAll('.student-check').forEach(c => c.checked = box.checked); updateCount(); }
  function clearAll() { document.querySelectorAll('.student-check').forEach(c => c.checked = false); updateCount(); }
  function filterStudents() {
    const q = document.getElementById('studentSearch').value.toLowerCase();
    document.querySelectorAll('.student-row').forEach(r => {
      const match = r.dataset.name.includes(q) || r.dataset.email.includes(q);
      r.style.display = match ? '' : 'none';
    });
  }
  function toggleAssignBoxes() {
    const val = document.querySelector('input[name="assignto"]:checked').value;
    document.getElementById('classesBox').classList.toggle('hidden', val !== 'classes');
    document.getElementById('studentsBox').classList.toggle('hidden', val === 'classes' || val === 'all');
  }
  toggleAssignBoxes();
  updateCount();
</script>
</body>
</html>
