<%- include('../partials/public_top', { title: 'Home' }) %>
<section class="public-hero">
  <div class="inner">
    <span class="chip" style="background:rgba(255,255,255,.14);color:#fff">Australia • Year 11–12</span>
    <h1>Learn. Practise. Take Exams. Improve.</h1>
    <p>A modern education platform for Australian Year 11–12 students: portal MCQ plans and complete online practice papers with teacher-marked written & essay feedback.</p>
    <div class="actions">
      <a class="btn" style="background:#fff;color:#16459d" href="/papers">Browse Full Papers</a>
      <a class="btn" style="background:rgba(255,255,255,.12);color:#fff;border:1px solid rgba(255,255,255,.2)" href="/register">Student Signup</a>
    </div>
  </div>
</section>

<section class="public-section">
  <div class="grid grid-2">
    <div class="card card-pad">
      <span class="chip chip-purple">Student Portal</span>
      <h2>MCQ Plans</h2>
      <p>Students buy an MCQ plan inside the portal, then practise by subject and year. Results are instant. Every new signup gets 50 free MCQs.</p>
      <a class="btn btn-primary" href="/login">Open Portal</a>
    </div>
    <div class="card card-pad">
      <span class="chip chip-blue">Public Website</span>
      <h2>Full Exam Papers</h2>
      <p>Students buy a complete paper with MCQs, written questions and an essay, then take the timed exam in the portal. MCQs auto-score; written & essay are teacher-reviewed.</p>
      <a class="btn btn-primary" href="/papers">Browse Papers</a>
    </div>
  </div>
</section>

<section class="public-section" style="padding-top:0;">
  <div class="section-title"><h3>Featured Papers</h3><a href="/papers" class="btn btn-outline">View all</a></div>
  <div class="grid grid-3">
    <% papers.forEach(p => { %>
      <div class="card paper-card">
        <span class="chip chip-blue"><%= p.year %></span>
        <h3><%= p.subject_name %></h3>
        <p class="muted"><%= p.title %></p>
        <div class="paper-price">A$<%= p.price.toFixed(2) %></div>
        <a class="btn btn-primary" href="/papers/<%= p.id %>">View Paper</a>
      </div>
    <% }) %>
    <% if (!papers.length) { %><p class="muted">No papers published yet.</p><% } %>
  </div>
</section>
<%- include('../partials/public_bottom') %>
