SESSION_SECRET=change-me
PORT=3000

# Optional: enable real Stripe Checkout for MCQ plan purchases (test mode keys are fine).
# Without these, plan purchases activate instantly in demo mode.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Required: shared secret between this app and the WordPress/WooCommerce site.
# WooCommerce sends this same value back in the x-webhook-secret header
# when it calls POST /api/woo/order-complete after a Full Exam Paper is bought.
WOO_WEBHOOK_SECRET=change-me-too

# Required for real email sending (verification, password reset). Gmail SMTP:
# use a 16-character Gmail "App Password" (not your normal password) —
# create one at https://myaccount.google.com/apppasswords (needs 2-Step Verification on).
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM_NAME=AUS Academy
SMTP_FROM_EMAIL=youraddress@gmail.com
# Leave SMTP_USER/SMTP_PASS blank to run in demo mode: emails are logged to the
# console and to the email_logs table instead of actually being sent.

# Used to build links inside emails (verification, password reset). If unset,
# the app falls back to the request's own host, which is fine for most setups.
APP_BASE_URL=https://class.eglit.in

# SMS provider for login OTP (phone verification). Leave as "none" for now —
# OTP codes are logged to the console + sms_logs table instead of actually
# being texted. When you pick a provider, set SMS_PROVIDER to its name and
# add its credentials below — all four providers are already fully wired up
# in src/lib/sms.js, so setting these two things is the ONLY step needed.
SMS_PROVIDER=none
# Set SMS_PROVIDER to ONE of: twilio | twilio_whatsapp | msg91 | whatsapp_business
# then add ONLY that provider's keys below (see DOCUMENTATION.md for exact steps):
#
# Twilio (plain SMS):
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx
#
# Twilio WhatsApp (same Twilio account, WhatsApp-enabled number):
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
#
# MSG91 (India SMS):
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=
#
# WhatsApp Business API (Meta Cloud API):
# META_WHATSAPP_TOKEN=
# META_WHATSAPP_PHONE_ID=
# META_WHATSAPP_TEMPLATE_NAME=otp_code
